    class ModelsScreen(ModalScreen):
        BINDINGS: ClassVar[list[Binding]] = [
            Binding("escape", "cancel", "Cancel"),
            Binding("enter", "choose", "Use"),
            Binding("j", "down", show=False),
            Binding("k", "up", show=False),
            Binding("c", "keep", "Keep current", show=False),
        ]

        def __init__(self, provider, catalog, current,
                     mode="browse", note=None):
            super().__init__()
            self.provider = provider
            self.catalog = catalog
            self.current = current
            self.mode = mode
            self.note = note

        def compose(self):
            with Vertical(id="dialog", classes="models"):
                yield Label(f"Models for {self.provider.label}",
                            classes="title")
                yield Static(self.note_text(), id="catalog-note")
                yield DataTable(id="model-table", cursor_type="row")

        def note_text(self):
            kind = ("Codex catalog" if self.catalog.kind == "codex"
                    else "OpenAI-style list")
            lines = [f"{len(self.catalog.models)} models ({kind})"]
            if self.catalog.url:
                lines.append(f"from {self.catalog.url}")
            if self.note:
                lines.append(self.note)
            elif self.mode == "choose":
                lines.append("Press c to keep the current model, Esc to cancel.")
            else:
                lines.append("Enter uses the model; Esc closes.")
            return "\n".join(lines)

        def on_mount(self):
            table = self.query_one("#model-table", DataTable)
            table.add_columns(" ", "Model", "Display name")
            current_index = None
            for index, (slug, display) in enumerate(self.catalog.models):
                marker = "*" if slug == self.current else " "
                table.add_row(marker, slug, display)
                if slug == self.current:
                    current_index = index
            table.focus()
            if table.row_count:
                table.move_cursor(row=current_index or 0)

        @on(DataTable.RowSelected, "#model-table")
        def model_selected(self):
            self.action_choose()

        def action_choose(self):
            table = self.query_one("#model-table", DataTable)
            if not table.row_count:
                return
            row = table.get_row_at(table.cursor_row)
            slug = row[1].plain if hasattr(row[1], "plain") else str(row[1])
            self.dismiss(("use", slug))

        def action_down(self):
            self.query_one("#model-table", DataTable).action_cursor_down()

        def action_up(self):
            self.query_one("#model-table", DataTable).action_cursor_up()

        def action_keep(self):
            if self.mode == "choose":
                self.dismiss(("keep", None))

        def action_cancel(self):
            self.dismiss(None)

