        #dialog.models #model-table { height: 1fr; }
        #catalog-note { height: auto; margin-bottom: 1; }
        """
        BINDINGS: ClassVar[list[Binding]] = [
            Binding("enter", "use", "Use", key_display="enter/u"),
            Binding("u", "use", show=False),
            Binding("j", "cursor_down", show=False),
            Binding("k", "cursor_up", show=False),
            Binding("a", "add", "Add"),
            Binding("i", "import_auth", "Import auth"),
            Binding("e", "edit", "Edit"),
            Binding("d", "remove", "Remove"),
            Binding("m", "models", "Models"),
            Binding("r", "reload", "Reload"),
            Binding("question_mark", "help", "Help", key_display="?"),
            Binding("q", "quit", "Quit"),
        ]

        def __init__(self, store):
            super().__init__()
            self.store = store
            self.state = None
            self.signature = None

        def compose(self):
            yield Header(show_clock=False)
            yield DataTable(id="providers", cursor_type="row")
            yield Static(id="details")
            yield Static(id="message")
            yield Footer()

        def on_mount(self):
            self.sub_title = short_path(self.store.config_path)
            self.table = self.query_one("#providers", DataTable)
            self.details = self.query_one("#details", Static)
            self.message_widget = self.query_one("#message", Static)
            self.table.add_columns(" ", "Provider", "Auth", "Endpoint")
            self.table.focus()
            self.reload()
            self.set_interval(1.0, self.poll_files)

        def selected_provider(self):
            if (self.state is None or
                    not self.state.providers or
                    self.table.row_count == 0):
                return None
            index = min(max(0, self.table.cursor_row),
                        len(self.state.providers) - 1)
            return self.state.providers[index]

        def current_label(self):
            provider = self.selected_provider()
            return provider.label if provider else None

        def catalog_description(self, provider):
            if provider.catalog_url:
                return provider.catalog_url
            if provider.active and self.state and self.state.catalog_json:
                path = Path(self.state.catalog_json).expanduser()
                return "file " + short_path(path)
            path = self.store.home / f"{CATALOG_PREFIX}{provider.name}.json"
            if self.state and path in self.state.texts:
                return "local file (applied on switch)"
            return "not configured (press m)"

        def reload(self, note=None):
            previous = self.current_label()
            try:
                state = self.store.read()
            except HANDLED_ERRORS as error:
                self.state = None
                self.signature = self.store.signature()
                self.table.clear()
                self.details.update("")
                self.show_message(
                    f"Cannot load provider files: {error}", error=True)
                return
            self.state = state
            self.signature = self.store.signature()
            self.fill_table(previous)
            self.refresh_details()
            if note:
                self.show_message(note)

        def poll_files(self):
            if self.store.signature() != self.signature:
                self.reload(note="Reloaded; files changed on disk.")

        def fill_table(self, previous):
            self.table.clear()
            for provider in self.state.providers:
                marker = "*" if provider.active else " "
                label = Text(
                    provider.label,
                    style="bold green" if provider.active else "")
                self.table.add_row(marker, label, provider.summary(),
                                   provider.base_url or "(official)",
                                   key=provider.label)
            if self.table.row_count == 0:
                return
            labels = [p.label.casefold()
                      for p in self.state.providers]
            index = 0
            if previous and previous.casefold() in labels:
                index = labels.index(previous.casefold())
            self.table.move_cursor(row=index)

        def refresh_details(self):
            provider = self.selected_provider()
            if provider is None:
                self.details.update("")
                return
            text = Text()
            text.append(provider.label, style="bold")
            if provider.active:
                text.append("  (active)", style="green")
            text.append("\n")
            text.append(
                f"slot {provider.slot}  |  wire_api {provider.wire_api}  |  "
                f"requires_openai_auth "
                f"{str(provider.requires_openai_auth).lower()}",
                style="dim")
            text.append("\n")
            text.append(f"endpoint  {provider.base_url or '(official)'}")
            text.append("\n")
            model = self.state.model if self.state else None
            text.append(f"model     {model or '(default)'}  |  catalog "
                        f"{self.catalog_description(provider)}")
            text.append("\n")
            text.append(
                f"auth      {provider.summary()} "
                f"({ORIGIN_NOTES[provider.auth_origin]})")
            text.append("\n")
            text.append(f"snapshot  {short_path(provider.auth_path)}",
                        style="dim")
            if self.state and not self.state.credentials_file:
                text.append("\n")
                text.append("warning: cli_auth_credentials_store is not "
                            "'file'; auth switching is disabled",
                            style="yellow")
            self.details.update(text)

        @on(DataTable.RowHighlighted)
        def row_highlighted(self):
            self.refresh_details()

        def show_message(self, text, error=False):
            self.message_widget.update(
                Text(text, style="red" if error else "dim"))

        def apply_action(self, func, *args, select=None):
            try:
                message = func(*args)
            except HANDLED_ERRORS as error:
                self.show_message(str(error), error=True)
                result = False
            else:
                self.show_message(message)
                result = True
            self.reload()
            if result and select:
                self.select_provider(select)
            return result

        def select_provider(self, label):
            if not self.state:
                return
            labels = [p.label.casefold() for p in self.state.providers]
            if label.casefold() in labels:
                self.table.move_cursor(row=labels.index(label.casefold()))
                self.refresh_details()

        def use_label(self, label):
            if self.state:
                current = next(
                    (p for p in self.state.providers
                     if p.label.casefold() == label.casefold()), None)
                if current is not None and current.active:
                    self.show_message(
                        f"Already using {current.label} as OpenAI.")
                    return
            try:
                plan = self.store.prepare_switch(label)
            except HANDLED_ERRORS as error:
                self.show_message(str(error), error=True)
                return
            if plan.provider.active:
                self.show_message(f"Already using {plan.label} as OpenAI.")
                return
            if plan.catalog.models and not plan.offered:
                note = (f"{plan.label} does not offer {plan.current_model}. "
                        "Pick a model, press c to keep it, or Esc to cancel.")

                def finished(choice):
                    if choice is None:
                        self.show_message("Switch cancelled.")
                    elif choice[0] == "keep":
                        self.apply_action(self.store.switch, plan.label,
                                          None, None, plan.catalog,
                                          select=plan.label)
                    else:
                        self.apply_action(self.store.switch, plan.label,
                                          None, choice[1], plan.catalog,
                                          select=plan.label)

                self.push_screen(
                    ModelsScreen(plan.provider, plan.catalog,
                                 plan.current_model, mode="choose",
                                 note=note),
                    finished)
                return
            self.apply_action(self.store.switch, plan.label, None, None,
                              plan.catalog, select=plan.label)

        def action_use(self):
            provider = self.selected_provider()
            if provider:
                self.use_label(provider.label)

        def action_models(self):
            provider = self.selected_provider()
            if provider is None:
                return
            try:
                catalog, message = self.store.configure_catalog(provider.label)
            except HANDLED_ERRORS as error:
                self.show_message(str(error), error=True)
                return
            self.reload()
            if not catalog.models:
                if provider.base_url:
                    self.show_message(
                        f"No model catalog for {provider.label}: "
                        f"{catalog.error}", error=True)
                else:
                    self.show_message(
                        "Official provider uses Codex's bundled model "
                        "catalog.")
                return
            self.show_message(message)
            current = self.state.model if self.state else None

            def finished(choice):
                if choice:
                    self.apply_action(self.store.use_model, provider.label,
                                      choice[1], select=provider.label)

            self.push_screen(
                ModelsScreen(provider, catalog, current, mode="browse"),
                finished)

        def action_add(self):
            if self.state is None:
                self.show_message(
                    "Cannot add a provider until the files load.", error=True)
                return

            def finished(request):
                if request:
                    added = self.apply_action(
                        self.store.add, request["label"], request["url"],
                        request["auth"], False, None)
                    if added and request["switch"]:
                        self.use_label(request["label"])

            self.push_screen(AddProviderScreen(self.state), finished)

        def action_import_auth(self):
            provider = self.selected_provider()
            if provider is None:
                return

            def finished(auth):
                if auth is not None:
                    self.apply_action(self.store.import_auth, provider.label, auth)

            self.push_screen(ImportAuthScreen(provider), finished)

        def action_edit(self):
            provider = self.selected_provider()
            if provider is None:
                return
            if provider.label.casefold() == "official":
                self.show_message(
                    "The official provider has no base URL.", error=True)
                return

            def finished(url):
                if url is not None:
                    self.apply_action(self.store.edit_base_url,
                                    provider.label, url)

            self.push_screen(EditEndpointScreen(provider), finished)

        def action_remove(self):
            provider = self.selected_provider()
            if provider is None:
                return
            if provider.active:
                self.show_message(f"{provider.label} is active; switch first.",
                                  error=True)
                return
            if provider.label.casefold() == "official":
                self.show_message(
                    "The official provider is managed automatically.",
                    error=True)
                return

            def finished(confirmed):
                if confirmed:
                    self.apply_action(self.store.remove, provider.label)

            self.push_screen(
                ConfirmScreen(f"Remove {provider.label}? "
                              "Its auth snapshot is kept."), finished)

        def action_help(self):
            self.push_screen(HelpScreen())

        def action_reload(self):
            self.reload(note="Reloaded.")

        def action_cursor_down(self):
            self.table.action_cursor_down()

        def action_cursor_up(self):
            self.table.action_cursor_up()


def run_tui(store):
    if TEXTUAL_ERROR is not None:
        raise StateError(
            "the TUI requires python-textual; install python-textual or use "
            "the list/use/add commands")
    try:
        CodexProviderApp(store).run()
    except KeyboardInterrupt:
        pass


def print_list(store):
    state = store.read()
    providers = state.providers
    if not providers:
        print("no providers")
        return
    summaries = [p.summary() for p in providers]
    label_width = max(len(p.label) for p in providers)
    active_width = len(" (active)")
    summary_width = max(len(s) for s in summaries)
    for provider, summary in zip(providers, summaries):
        active = " (active)" if provider.active else ""
        endpoint = provider.base_url or "(official)"
        print(f"{provider.label:<{label_width}}{active:<{active_width}}  "
              f"{summary:<{summary_width}}  {endpoint}".rstrip())


def print_models(store, query, refresh=False):
    provider, catalog, current = store.models_for(query, refresh=refresh)
    label = provider.label + (" (active)" if provider.active else "")
    if not catalog.models:
        if not provider.base_url:
            print(f"{label}: Codex's bundled model catalog is used")
            return
        raise StateError(f"{label}: no model catalog ({catalog.error})")
    kind = ("Codex catalog" if catalog.kind == "codex"
            else "OpenAI-style list")
    print(f"{label}: {len(catalog.models)} models ({kind})")
    if catalog.url:
        print(f"source: {catalog.url}")
    for slug, display in catalog.models:
        marker = "*" if slug == current else " "
        suffix = f"  ({display})" if display and display != slug else ""
        print(f"{marker} {slug}{suffix}")


def add_auth_arguments(parser):
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--auth", type=Path,
                       help="import this provider's auth.json")
    group.add_argument("--api-key", help="use this API key for the provider")


def build_parser():
    parser = argparse.ArgumentParser(
        prog="codex-provider",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  codex-provider                 open the TUI\n"
            "  codex-provider list            print providers\n"
            "  codex-provider Jason           shorthand for 'use Jason'\n"
            "  codex-provider models LinYun   list a provider's models\n"
            "  codex-provider use LinYun --model gpt-6-astra\n"
            "  codex-provider add Ming --base-url https://ming.example.com "
            "--api-key sk-... --switch\n"
            "  codex-provider remove Ming     delete a provider entry\n"
            "\n"
            "On add/use, the provider's model catalog is probed so Codex's "
            "model\npicker matches that provider. A generated local catalog "
            "lives in\n~/.codex/model-catalog.<name>.json.\n"
        ),
    )
    sub = parser.add_subparsers(dest="command", metavar="command")

    sub.add_parser("list", help="print providers")
    sub.add_parser("tui", help="open the interactive interface")

    models = sub.add_parser("models", help="list a provider's models")
    models.add_argument("provider")
    models.add_argument("--refresh", action="store_true",
                        help="bypass the in-process catalog cache")

    use = sub.add_parser("use", help="switch the active provider")
    use.add_argument("provider")
    use.add_argument("--model", help="set this model after switching")
    add_auth_arguments(use)

    add = sub.add_parser("add", help="register a new provider")
    add.add_argument("label")
    add.add_argument("--base-url", required=True,
                     help="OpenAI-compatible endpoint")
    add.add_argument("--switch", action="store_true",
                     help="switch to the new provider after adding it")
    add.add_argument("--model", help="set this model after switching")
    add_auth_arguments(add)

    remove = sub.add_parser("remove", help="delete a provider entry")
    remove.add_argument("provider")
    return parser


def cli_auth(args):
    if args.auth is not None:
        return load_auth_file(args.auth.expanduser())
    if args.api_key is not None:
        return auth_from_key(args.api_key)
    return None


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and not argv[0].startswith("-") and argv[0] not in COMMANDS:
        argv.insert(0, "use")
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.command == "add" and args.model and not args.switch:
        parser.error("--model requires --switch")
    store = Store(Path.home() / ".codex")

    if args.command is None:
        if sys.stdin.isatty() and sys.stdout.isatty():
            run_tui(store)
            return
        args.command = "list"
    if args.command == "tui":
        if not (sys.stdin.isatty() and sys.stdout.isatty()):
            raise StateError("the TUI needs an interactive terminal")
        run_tui(store)
    elif args.command == "list":
        print_list(store)
    elif args.command == "models":
        print_models(store, args.provider, args.refresh)
    elif args.command == "use":
        print(store.switch(args.provider, cli_auth(args), args.model))
    elif args.command == "add":
        print(store.add(args.label, args.base_url, cli_auth(args),
                        args.switch, args.model))
    elif args.command == "remove":
        print(store.remove(args.provider))


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except HANDLED_ERRORS as error:
        sys.exit(f"codex-provider: {error}")
