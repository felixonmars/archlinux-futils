def write_private(path, text):
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as f:
        temporary = Path(f.name)
        try:
            f.write(text)
            f.close()
            temporary.replace(path)
        finally:
            temporary.unlink(missing_ok=True)


def read_text(path):
    try:
        return path.read_text()
    except FileNotFoundError:
        return None


def short_path(path):
    try:
        return "~/" + str(Path(path).relative_to(Path.home()))
    except ValueError:
        return str(path)


def json_text(obj):
    return json.dumps(obj, indent=2) + "\n"


def ensure_newline(text):
    return text if text.endswith("\n") else text + "\n"


def mask_key(key):
    key = str(key)
    return "***" if len(key) < 16 else key[:10] + "..."


def parse_auth_object(text, where):
    try:
        obj = json.loads(text)
    except json.JSONDecodeError as error:
        raise StateError(f"{where}: {error.msg}") from None
    if not isinstance(obj, dict):
        raise StateError(f"{where}: expected a JSON object")
    return obj


def check_auth(obj, where):
    tokens = obj.get("tokens")
    if not (obj.get("OPENAI_API_KEY") or
            isinstance(tokens, dict) and tokens.get("refresh_token")):
        raise StateError(f"{where}: no API key or ChatGPT login tokens")


@dataclass
class AuthInput:
    obj: dict
    text: str


def load_auth_file(path):
    text = read_text(path)
    if text is None:
        raise StateError(f"{short_path(path)}: file not found")
    return AuthInput(parse_auth_object(text, short_path(path)),
                     ensure_newline(text))


def auth_from_key(key):
    key = (key or "").strip()
    if not key:
        raise StateError("API key is empty")
    obj = {"auth_mode": "apikey", "OPENAI_API_KEY": key}
    return AuthInput(obj, json_text(obj))


_CODEX_VERSION = None
_BUNDLED_CATALOG = None


def codex_version():
    global _CODEX_VERSION
    if _CODEX_VERSION is None:
        try:
            result = subprocess.run(["codex", "--version"], check=False,
                                    capture_output=True, text=True, timeout=30)
        except (OSError, subprocess.SubprocessError) as error:
            raise StateError(f"cannot run codex: {error}") from None
        words = result.stdout.strip().split()
        if result.returncode != 0 or not words:
            raise StateError("cannot determine the Codex version")
        _CODEX_VERSION = words[-1]
    return _CODEX_VERSION


def bundled_catalog():
    global _BUNDLED_CATALOG
    if _BUNDLED_CATALOG is None:
        try:
            with tempfile.TemporaryDirectory() as scratch:
                env = dict(os.environ, CODEX_HOME=scratch)
                result = subprocess.run(
                    ["codex", "debug", "models", "--bundled"],
                    check=False, capture_output=True, text=True, timeout=60,
                    env=env)
        except (OSError, subprocess.SubprocessError) as error:
            raise StateError(
                f"cannot run codex debug models: {error}") from None
        if result.returncode != 0:
            detail = result.stderr.strip().splitlines()
            raise StateError(
                "cannot read the bundled model catalog"
                + (f": {detail[-1]}" if detail else ""))
        try:
            models = json.loads(result.stdout).get("models")
        except (json.JSONDecodeError, AttributeError) as error:
            raise StateError(f"invalid bundled catalog: {error}") from None
        if not isinstance(models, list) or not models:
            raise StateError("the bundled model catalog is empty")
        _BUNDLED_CATALOG = models
    return _BUNDLED_CATALOG


def catalog_token(auth_obj):
    if not isinstance(auth_obj, dict):
        return None
    tokens = auth_obj.get("tokens")
    if isinstance(tokens, dict) and tokens.get("access_token"):
        return str(tokens["access_token"])
    key = auth_obj.get("OPENAI_API_KEY")
    return str(key) if key else None


def catalog_fingerprint(token):
    return hashlib.sha256(token.encode()).hexdigest()[:16] if token else ""


def catalog_candidates(base_url):
    base = base_url.rstrip("/")
    candidates = [base + "/models"]
    if not base.endswith("/v1"):
        candidates.append(base + "/v1/models")
    return candidates


def request_json(endpoint, token):
    separator = "&" if "?" in endpoint else "?"
    url = (f"{endpoint}{separator}client_version="
           f"{urllib.parse.quote(codex_version(), safe='')}")
    headers = {"Accept": "application/json"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    request = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(request, timeout=CATALOG_TIMEOUT) as response:
        body = response.read(2 * 1024 * 1024)
    return json.loads(body)


def catalog_metadata(text):
    if not text:
        return None
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        return None
    meta = data.get("_codex_provider") if isinstance(data, dict) else None
    return meta if isinstance(meta, dict) else None


def parse_catalog(data):
    models = data.get("models") if isinstance(data, dict) else None
    if isinstance(models, list):
        entries = []
        for item in models:
            if isinstance(item, dict) and item.get("slug"):
                slug = str(item["slug"])
                display = str(item.get("display_name") or slug)
                entries.append((slug, display))
        if entries:
            return "codex", entries
    data_models = data.get("data") if isinstance(data, dict) else None
    if isinstance(data_models, list):
        entries = []
        for item in data_models:
            if isinstance(item, dict) and item.get("id"):
                slug = str(item["id"])
                display = str(item.get("display_name") or slug)
                entries.append((slug, display))
        if entries:
            return "openai", entries
    return None, []


def fetch_catalog(endpoint, token):
    try:
        data = request_json(endpoint, token)
    except urllib.error.HTTPError as error:
        error.close()
        return None, [], f"HTTP {error.code}"
    except urllib.error.URLError as error:
        return None, [], str(error.reason)
    except StateError as error:
        return None, [], str(error)
    except (TimeoutError, OSError) as error:
        return None, [], str(error)
    except json.JSONDecodeError as error:
        return None, [], f"invalid JSON: {error.msg}"
    kind, entries = parse_catalog(data)
    if kind is None:
        return None, [], "no models in the response"
    return kind, entries, None


def local_catalog_entries(provider, models):
    bundled = bundled_catalog()
    known = {}
    for entry in bundled:
        if isinstance(entry, dict) and entry.get("slug"):
            known[str(entry["slug"])] = entry
    template = known.get("gpt-5.5")
    if template is None:
        template = next(
            (entry for entry in bundled
             if isinstance(entry, dict)
             and (entry.get("base_instructions") or
                  isinstance(entry.get("model_messages"), dict))),
            bundled[0])
    entries = []
    seen = set()
    for slug, display in models[:MAX_CATALOG_MODELS]:
        if slug in seen:
            continue
        seen.add(slug)
        if slug in known:
            entry = copy.deepcopy(known[slug])
        else:
            entry = copy.deepcopy(template)
            entry["slug"] = slug
            entry["display_name"] = display
            entry["description"] = f"Model {slug} provided by {provider.name}."
            entry["upgrade"] = None
            entry["availability_nux"] = None
            entry["additional_speed_tiers"] = []
            entry["service_tiers"] = []
            entry["default_service_tier"] = None
        messages = entry.get("model_messages")
        if not (entry.get("base_instructions") or
                isinstance(messages, dict) and
                messages.get("instructions_template")):
            raise StateError(
                f"bundled catalog entry for {slug} has no instructions")
        entries.append(entry)
    if not entries:
        raise StateError("the provider did not return any models")
    return entries


def managed_catalog_json(value, home):
    if not value:
        return None
    try:
        path = Path(str(value)).expanduser()
    except (OSError, ValueError):
        return None
    if path.parent != Path(home):
        return None
    if not path.name.startswith(CATALOG_PREFIX) or path.suffix != ".json":
        return None
    return path


def ensure_official(doc):
    table = doc["model_providers"]
    if any(entry.get("name") == OFFICIAL_NAME for entry in table.values()):
        return
    if "OpenAIOfficial" in table:
        raise StateError("OpenAIOfficial is already used by another provider")
    # Omitting base_url lets Codex choose the official API or ChatGPT endpoint.
    table["OpenAIOfficial"] = {
        "name": OFFICIAL_NAME,
        "wire_api": "responses",
        "requires_openai_auth": True,
    }


def check_new_label(state, label):
    if not LABEL_RE.fullmatch(label):
        raise StateError(f"provider label cannot be used as a filename: {label!r}")
    if label.casefold() == "official":
        raise StateError("the official provider is managed automatically")
    if any(p.label.casefold() == label.casefold() for p in state.providers):
        raise StateError(f"provider {label} already exists")
    slot = ACTIVE_SLOT + label
    if slot in state.doc["model_providers"]:
        raise StateError(f"{slot} is already used by another provider")
    return slot


def check_base_url(url):
    url = (url or "").strip()
    if not url:
        raise StateError("base URL is required")
    if not re.match(r"https?://", url):
        raise StateError("base URL must start with http:// or https://")
    return url


def dump_config(doc):
    text = tomlkit.dumps(doc)
    tomlkit.parse(text)
    return text


@dataclass
class Provider:
    slot: str
    label: str
    name: str
    base_url: str
    wire_api: str
    requires_openai_auth: bool
    auth_path: Path
    auth_text: str | None
    auth_obj: dict | None
    auth_origin: str
    auth_error: str | None
    catalog_url: str | None

    @property
    def active(self):
        return self.slot == ACTIVE_SLOT

    def summary(self):
        if self.auth_error:
            return f"auth error: {self.auth_error}"
        if self.auth_obj is None:
            return "no saved auth"
        key = self.auth_obj.get("OPENAI_API_KEY")
        tokens = self.auth_obj.get("tokens")
        if key:
            text = f"api key {mask_key(key)}"
        elif isinstance(tokens, dict) and tokens.get("refresh_token"):
            text = "ChatGPT login"
        else:
            text = "invalid auth"
        return text


