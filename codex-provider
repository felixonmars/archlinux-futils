@dataclass
class Catalog:
    kind: str
    url: str | None
    models: list
    error: str | None
    base_url: str = ""
    auth_fingerprint: str = ""

    def slugs(self):
        return [slug for slug, _ in self.models]


@dataclass
class SwitchPlan:
    label: str
    provider: Provider
    catalog: Catalog
    current_model: str
    offered: bool


def probe_catalog(base_url, token, known_url=None):
    if not base_url:
        return Catalog("none", None, [], "official provider", "", "")
    if not token:
        return Catalog("none", None, [], "no saved auth", base_url, "")
    errors = []
    openai = None
    if known_url:
        kind, entries, error = fetch_catalog(known_url, token)
        if kind == "codex":
            return Catalog("codex", known_url, entries, None, base_url,
                           catalog_fingerprint(token))
        if kind == "openai":
            openai = (known_url, entries)
        else:
            errors.append(f"{known_url}: {error}")
    for candidate in catalog_candidates(base_url):
        if candidate == known_url:
            continue
        kind, entries, error = fetch_catalog(candidate, token)
        if kind == "codex":
            return Catalog("codex", candidate, entries, None, base_url,
                           catalog_fingerprint(token))
        if kind == "openai" and openai is None:
            openai = (candidate, entries)
        if kind is None:
            errors.append(f"{candidate}: {error}")
    fingerprint = catalog_fingerprint(token)
    if openai is not None:
        return Catalog("openai", openai[0], openai[1], None, base_url,
                       fingerprint)
    detail = "; ".join(errors) or "no catalog endpoint answered"
    return Catalog("none", None, [], detail, base_url, fingerprint)


def catalog_offered(catalog, model):
    if not catalog.models or not model:
        return True
    wanted = str(model).casefold()
    return any(slug.casefold() == wanted for slug in catalog.slugs())


class Store:
    def __init__(self, home):
        self.home = home
        self.config_path = home / "config.toml"
        self.auth_path = home / "auth.json"
        self.lock_path = home / ".codex-provider.lock"
        self._catalog_cache = {}

    def _read_texts(self):
        texts = {}
        paths = [self.config_path, self.auth_path]
        try:
            paths.extend(sorted(self.home.glob("auth*.json")))
            paths.extend(sorted(self.home.glob(CATALOG_PREFIX + "*.json")))
        except OSError:
            pass
        for path in paths:
            if path not in texts:
                texts[path] = read_text(path)
        return texts

    def signature(self):
        entries = []
        paths = [self.config_path]
        try:
            paths.extend(sorted(self.home.glob("auth*.json")))
            paths.extend(sorted(self.home.glob(CATALOG_PREFIX + "*.json")))
        except OSError:
            pass
        for path in paths:
            try:
                stat = path.stat()
            except OSError:
                continue
            entries.append((path.name, stat.st_mtime_ns, stat.st_size))
        return tuple(entries)

    def read(self):
        texts = self._read_texts()
        config_text = texts[self.config_path]
        if config_text is None:
            raise StateError(f"{short_path(self.config_path)} is missing")
        try:
            doc = tomlkit.parse(config_text)
        except tomlkit.exceptions.ParseError as error:
            raise StateError(f"{short_path(self.config_path)}: {error}") from None
        table = doc.get("model_providers")
        if table is None:
            raise StateError(
                f"{short_path(self.config_path)} has no [model_providers]")
        if ACTIVE_SLOT not in table:
            raise StateError(
                f"{short_path(self.config_path)} has no model_providers.OpenAI")
        ensure_official(doc)

        auth_text = texts[self.auth_path]
        auth_obj = None
        auth_error = None
        if auth_text is None:
            auth_error = "auth.json is missing"
        else:
            try:
                auth_obj = parse_auth_object(auth_text, "auth.json")
                check_auth(auth_obj, "auth.json")
            except StateError as error:
                auth_error = str(error)

        providers = []
        seen = set()
        for slot, entry in table.items():
            if not slot.startswith("OpenAI"):
                continue
            provider = self._make_provider(
                texts, auth_obj, auth_error, slot, entry)
            if provider.label.casefold() in seen:
                raise StateError(f"duplicate provider name: {provider.label}")
            seen.add(provider.label.casefold())
            providers.append(provider)
        catalog_json = doc.get("model_catalog_json")
        model = doc.get("model")
        return State(self.home, doc, providers, auth_text, auth_obj,
                     auth_error, texts,
                     doc.get("cli_auth_credentials_store", "file") == "file",
                     str(catalog_json) if catalog_json is not None else None,
                     str(model) if model is not None else None)

    def _make_provider(self, texts, auth_obj, auth_error, slot, entry):
        name = entry.get("name", slot)
        if not isinstance(name, str) or not LABEL_RE.fullmatch(name):
            raise StateError(
                f"provider name cannot be used as a filename: {name!r}")
        label = name.removeprefix("OpenAI-")
        official = label.casefold() == "official"
        auth_path = (self.home / "auth.official.json" if official
                     else self.home / f"auth.{name}.json")
        text = texts.get(auth_path)
        origin = "missing"
        obj = None
        error = None
        if official and text is None:
            fallback = self.home / "auth.OpenAI-Official.json"
            fallback_text = texts.get(fallback)
            if fallback_text is not None:
                text, origin = fallback_text, "fallback"
        if text is not None:
            try:
                obj = parse_auth_object(text, short_path(auth_path))
                check_auth(obj, short_path(auth_path))
                if origin == "missing":
                    origin = "snapshot"
            except StateError as err:
                obj, error, origin = None, str(err), "invalid"
        elif slot != ACTIVE_SLOT:
            suffix = slot.removeprefix("OpenAI")
            legacy_key = (auth_obj or {}).get(f"OPENAI_API_KEY{suffix}")
            if suffix.isdigit() and legacy_key:
                obj = {"auth_mode": "apikey", "OPENAI_API_KEY": legacy_key}
                origin = "legacy"
        if slot == ACTIVE_SLOT:
            obj = auth_obj
            text = texts.get(self.auth_path)
            error = auth_error
            origin = "auth.json"
        catalog_url = entry.get("model_catalog_url")
        return Provider(slot, label, name, entry.get("base_url", "") or "",
                        entry.get("wire_api", "responses"),
                        bool(entry.get("requires_openai_auth", False)),
                        auth_path, text, obj, origin, error,
                        str(catalog_url) if catalog_url is not None else None)

    @contextlib.contextmanager
    def _lock(self):
        fd = os.open(self.lock_path, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            yield
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
            os.close(fd)

    def _changed_since(self, texts):
        for path, old in texts.items():
            try:
                new = path.read_text()
            except FileNotFoundError:
                new = None
            except OSError:
                return True
            if new != old:
                return True
        return False

    def _transact(self, action):
        for _ in range(RETRIES):
            with self._lock():
                state = self.read()
                writes, message = action(state)
                if self._changed_since(state.texts):
                    continue
                config_text = writes.pop(self.config_path, None)
                for path, text in writes.items():
                    write_private(path, text)
                if config_text is not None:
                    try:
                        write_private(self.config_path, config_text)
                    except OSError:
                        original = state.texts.get(self.auth_path)
                        if original is not None:
                            write_private(self.auth_path, original)
                        raise
                return message
        raise Conflict("config.toml or auth files kept changing; try again")

    def _resolve(self, state, query):
        wanted = query.casefold()
        for provider in state.providers:
            if wanted in (provider.label.casefold(),
                          provider.slot.casefold(),
                          f"openai-{provider.label.casefold()}"):
                return provider
        choices = ", ".join(p.label for p in state.providers)
        raise StateError(f"unknown provider; choose {choices}")

    def catalog_for(self, provider, auth_obj=None, refresh=False):
        auth = auth_obj if auth_obj is not None else provider.auth_obj
        token = catalog_token(auth)
        if not provider.base_url:
            return Catalog("none", None, [], "official provider", "", "")
        if not token:
            return Catalog("none", None, [], "no saved auth",
                           provider.base_url, "")
        fingerprint = catalog_fingerprint(token)
        key = (provider.base_url, provider.catalog_url or "", fingerprint)
        now = time.monotonic()
        cached = self._catalog_cache.get(key)
        if (cached is not None and not refresh
                and now - cached[0] < CATALOG_CACHE_SECONDS):
            return cached[1]
        catalog = probe_catalog(provider.base_url, token, provider.catalog_url)
        self._catalog_cache[key] = (now, catalog)
        return catalog

    def prepare_switch(self, query):
        state = self.read()
        provider = self._resolve(state, query)
        catalog = self.catalog_for(provider)
        return SwitchPlan(provider.label, provider, catalog,
                          state.model or "",
                          catalog_offered(catalog, state.model))

    def models_for(self, query, refresh=False):
        state = self.read()
        provider = self._resolve(state, query)
        return provider, self.catalog_for(provider, refresh=refresh), state.model

    def configure_catalog(self, query):
        result = {}

        def action(state):
            provider = self._resolve(state, query)
            catalog = self.catalog_for(provider, refresh=True)
            writes = {}
            if provider.base_url:
                effective, notes = self._apply_catalog(
                    state, provider, catalog, writes, provider.active)
            else:
                effective, notes = catalog, []
            config_text = dump_config(state.doc)
            if config_text != state.texts[self.config_path]:
                writes[self.config_path] = config_text
            message = self._catalog_message(provider, effective)
            if notes:
                message += " " + " ".join(notes)
            result["catalog"] = effective
            return writes, message

        message = self._transact(action)
        return result["catalog"], message

    def _catalog_message(self, provider, catalog):
        if catalog.kind == "codex":
            return (f"Model catalog: {len(catalog.models)} models from "
                    f"{catalog.url}.")
        if catalog.kind == "openai":
            path = self.home / f"{CATALOG_PREFIX}{provider.name}.json"
            return (f"Model catalog: {len(catalog.models)} models in "
                    f"{short_path(path)}.")
        if not provider.base_url:
            return "Official provider uses Codex's bundled model catalog."
        return f"Model catalog unavailable: {catalog.error}."

    def _web_search_original(self, state):
        current = state.doc.get("web_search")
        current_value = str(current) if current is not None else None
        managed = False
        saved = None
        for provider in state.providers:
            if not provider.active:
                continue
            path = self.home / f"{CATALOG_PREFIX}{provider.name}.json"
            meta = catalog_metadata(state.texts.get(path))
            if meta is not None and "web_search" in meta:
                managed = True
                saved = meta["web_search"]
                break
        if current_value is not None and current_value != "disabled":
            return True, current_value
        if managed:
            return True, saved
        return False, current_value

    def _restore_web_search(self, state, notes):
        managed, original = self._web_search_original(state)
        if not managed:
            return
        current = state.doc.get("web_search")
        if current is None or str(current) != "disabled":
            return
        if original is None:
            if "web_search" in state.doc:
                del state.doc["web_search"]
            notes.append("web_search restored to the default.")
        else:
            state.doc["web_search"] = original
            notes.append(f"web_search restored to {original}.")

    def _apply_catalog(self, state, provider, catalog, writes, activate):
        entry = state.doc["model_providers"][provider.slot]
        current = state.doc.get("model_catalog_json")
        managed = managed_catalog_json(current, self.home)
        notes = []
        effective = catalog
        if catalog.kind == "openai":
            try:
                entries = local_catalog_entries(provider, catalog.models)
            except StateError as error:
                effective = Catalog("none", None, [], str(error),
                                    catalog.base_url, catalog.auth_fingerprint)
            else:
                _, original_web_search = self._web_search_original(state)
                payload = {"models": entries,
                           "_codex_provider": {
                               "web_search": original_web_search}}
                text = json_text(payload)
                while len(entries) > 1 and len(text.encode()) > 900_000:
                    entries.pop()
                    text = json_text(payload)
                path = self.home / f"{CATALOG_PREFIX}{provider.name}.json"
                writes[path] = text
                if "model_catalog_url" in entry:
                    del entry["model_catalog_url"]
                if activate:
                    state.doc["web_search"] = "disabled"
                    notes.append("web_search disabled for this provider.")
                    if current and managed is None:
                        notes.append(
                            "Top-level model_catalog_json is user-managed; "
                            "left it alone.")
                    else:
                        state.doc["model_catalog_json"] = (
                            f"~/.codex/{path.name}")
                return effective, notes
        if effective.kind == "codex":
            if activate:
                self._restore_web_search(state, notes)
            entry["model_catalog_url"] = effective.url
            if activate and managed is not None:
                del state.doc["model_catalog_json"]
            return effective, notes
        if activate:
            self._restore_web_search(state, notes)
            saved = self.home / f"{CATALOG_PREFIX}{provider.name}.json"
            if state.texts.get(saved) is not None:
                state.doc["model_catalog_json"] = f"~/.codex/{saved.name}"
                notes.append("Using the previously saved model catalog.")
            elif managed is not None:
                del state.doc["model_catalog_json"]
                notes.append("No model catalog; using Codex's bundled list.")
            elif current:
                notes.append("No model catalog; user model_catalog_json left "
                             "alone.")
        return effective, notes

    def switch(self, query, auth=None, model=None, catalog=None):
        def action(state):
            provider = self._resolve(state, query)
            return self._plan_switch(state, provider, auth, model, catalog)
        return self._transact(action)

    def add(self, label, base_url, auth=None, switch=False, model=None):
        def action(state):
            return self._plan_add(state, label, base_url, auth, switch, model)
        return self._transact(action)

    def use_model(self, query, model):
        def action(state):
            provider = self._resolve(state, query)
            if not provider.active:
                return self._plan_switch(state, provider, None, model, None)
            catalog = self.catalog_for(provider)
            writes = {}
            effective, notes = self._apply_catalog(
                state, provider, catalog, writes, True)
            state.doc["model"] = model
            writes[self.config_path] = dump_config(state.doc)
            message = f"Model set to {model} for {provider.label}. "
            message += self._catalog_message(provider, effective)
            if notes:
                message += " " + " ".join(notes)
            return writes, message
        return self._transact(action)

    def import_auth(self, query, auth):
        def action(state):
            provider = self._resolve(state, query)
            return self._plan_import(state, provider, auth)
        return self._transact(action)

    def edit_base_url(self, query, base_url):
        def action(state):
            provider = self._resolve(state, query)
            return self._plan_edit(state, provider, base_url)
        return self._transact(action)

    def remove(self, query):
        def action(state):
            provider = self._resolve(state, query)
            return self._plan_remove(state, provider)
        return self._transact(action)

    def _plan_switch(self, state, provider, auth=None, model=None, catalog=None):
        if not state.credentials_file:
            raise StateError(
                "switching auth.json requires cli_auth_credentials_store = 'file'")
        ensure_official(state.doc)
        writes = {}
        if provider.active:
            if auth is None and model is None:
                return writes, f"Already using {provider.label} as OpenAI"
            if auth is None:
                catalog = self.catalog_for(provider)
                effective, notes = self._apply_catalog(
                    state, provider, catalog, writes, True)
                state.doc["model"] = model
                writes[self.config_path] = dump_config(state.doc)
                message = f"Model set to {model} for {provider.label}."
                message += " " + self._catalog_message(provider, effective)
                if notes:
                    message += " " + " ".join(notes)
                return writes, message
            selected_obj, selected_text = auth.obj, auth.text
        elif auth is not None:
            selected_obj, selected_text = auth.obj, auth.text
        elif provider.auth_error:
            raise StateError(f"{provider.label}: {provider.auth_error}")
        elif provider.auth_obj is None:
            raise StateError(f"no saved auth for {provider.label}; import one as "
                             f"{short_path(provider.auth_path)}")
        else:
            selected_obj = provider.auth_obj
            selected_text = provider.auth_text or json_text(selected_obj)
        check_auth(selected_obj, f"auth for {provider.label}")

        token = catalog_token(selected_obj)
        if (catalog is None
                or catalog.base_url != provider.base_url
                or catalog.auth_fingerprint != catalog_fingerprint(token)):
            catalog = self.catalog_for(provider, auth_obj=selected_obj)
        effective, notes = self._apply_catalog(
            state, provider, catalog, writes, True)

        if provider.active:
            writes[provider.auth_path] = ensure_newline(selected_text)
            writes[self.auth_path] = ensure_newline(selected_text)
            message = f"Updated auth for {provider.label}."
        else:
            if state.auth_obj is None:
                raise StateError(
                    f"cannot read current auth.json: {state.auth_error}")
            if state.auth_text is None:
                raise StateError(
                    "auth.json is missing; cannot save the current provider")
            active = next(p for p in state.providers if p.active)
            writes[active.auth_path] = ensure_newline(state.auth_text)
            for saved in state.providers:
                if saved.active or saved.auth_origin != "legacy":
                    continue
                writes[saved.auth_path] = json_text(saved.auth_obj)
            writes[provider.auth_path] = ensure_newline(selected_text)
            writes[self.auth_path] = ensure_newline(selected_text)
            table = state.doc["model_providers"]
            table[ACTIVE_SLOT], table[provider.slot] = (
                table[provider.slot], table[ACTIVE_SLOT])
            state.doc["model_provider"] = ACTIVE_SLOT
            message = (f"Using {provider.label} as OpenAI. "
                       "Restart Codex to apply.")

        if model:
            state.doc["model"] = model
            message += f" Model set to {model}."
        elif (effective.models and state.model
              and not catalog_offered(effective, state.model)):
            notes.append(f"Current model {state.model} is not offered by "
                         f"{provider.label}.")
        review_model = state.doc.get("review_model")
        if (effective.models and review_model
                and not catalog_offered(effective, str(review_model))):
            notes.append(f"review_model {review_model} is not offered by "
                         f"{provider.label}.")
        message += " " + self._catalog_message(provider, effective)
        if notes:
            message += " " + " ".join(notes)
        writes[self.config_path] = dump_config(state.doc)
        return writes, message

    def _plan_add(self, state, label, base_url, auth=None, switch=False,
                  model=None):
        label = (label or "").strip()
        slot = check_new_label(state, label)
        base_url = check_base_url(base_url)
        ensure_official(state.doc)
        entry = {
            "name": f"OpenAI-{label}",
            "base_url": base_url,
            "wire_api": "responses",
            "requires_openai_auth": True,
        }
        state.doc["model_providers"][slot] = entry
        writes = {}
        if auth is not None:
            writes[self.home / f"auth.OpenAI-{label}.json"] = (
                ensure_newline(auth.text))
        provider = self._make_provider(
            state.texts, state.auth_obj, state.auth_error, slot, entry)
        auth_obj = auth.obj if auth is not None else provider.auth_obj
        if auth_obj is not None:
            catalog = self.catalog_for(provider, auth_obj=auth_obj, refresh=True)
        else:
            catalog = Catalog("none", None, [], "no saved auth",
                              provider.base_url, "")
        if switch:
            switch_writes, message = self._plan_switch(
                state, provider, auth, model, catalog)
            writes.update(switch_writes)
            return writes, f"Added {label}. {message}"
        effective, notes = self._apply_catalog(
            state, provider, catalog, writes, False)
        writes[self.config_path] = dump_config(state.doc)
        message = f"Added {label} (slot {slot})."
        if auth_obj is None:
            message += (" No auth saved yet; the model catalog was not "
                        "configured.")
        else:
            message += " " + self._catalog_message(provider, effective)
            if notes:
                message += " " + " ".join(notes)
        return writes, message

    def _plan_import(self, state, provider, auth):
        if not state.credentials_file:
            raise StateError(
                "switching auth.json requires cli_auth_credentials_store = 'file'")
        writes = {provider.auth_path: ensure_newline(auth.text)}
        if not provider.active:
            return writes, f"Saved auth for {provider.label}."
        writes[self.auth_path] = ensure_newline(auth.text)
        catalog = self.catalog_for(provider, auth_obj=auth.obj, refresh=True)
        effective, notes = self._apply_catalog(
            state, provider, catalog, writes, True)
        config_text = dump_config(state.doc)
        if config_text != state.texts[self.config_path]:
            writes[self.config_path] = config_text
        message = f"Updated auth for {provider.label}. "
        message += self._catalog_message(provider, effective)
        if notes:
            message += " " + " ".join(notes)
        return writes, message

    def _plan_edit(self, state, provider, base_url):
        if provider.label.casefold() == "official":
            raise StateError("the official provider has no base URL")
        base_url = check_base_url(base_url)
        entry = state.doc["model_providers"][provider.slot]
        entry["base_url"] = base_url
        if "model_catalog_url" in entry:
            del entry["model_catalog_url"]
        updated = self._make_provider(
            state.texts, state.auth_obj, state.auth_error, provider.slot, entry)
        if updated.auth_obj is not None:
            catalog = self.catalog_for(updated, refresh=True)
        else:
            catalog = Catalog("none", None, [], "no saved auth",
                              updated.base_url, "")
        writes = {}
        effective, notes = self._apply_catalog(
            state, updated, catalog, writes, updated.active)
        writes[self.config_path] = dump_config(state.doc)
        message = f"Updated endpoint for {provider.label}. "
        message += self._catalog_message(updated, effective)
        if notes:
            message += " " + " ".join(notes)
        return writes, message

    def _plan_remove(self, state, provider):
        if provider.label.casefold() == "official":
            raise StateError("the official provider is managed automatically")
        if provider.active:
            raise StateError(
                f"{provider.label} is active; switch to another provider first")
        del state.doc["model_providers"][provider.slot]
        writes = {self.config_path: dump_config(state.doc)}
        if state.texts.get(provider.auth_path) is None:
            return writes, f"Removed {provider.label}."
        return writes, (f"Removed {provider.label}; auth snapshot kept at "
                        f"{short_path(provider.auth_path)}.")


