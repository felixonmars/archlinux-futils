ACTIVE_SLOT = "OpenAI"
OFFICIAL_NAME = "OpenAI-Official"
LABEL_RE = re.compile(r"[A-Za-z0-9_-]+")
COMMANDS = ("list", "models", "use", "add", "remove", "tui")
RETRIES = 5
CATALOG_PREFIX = "model-catalog."
CATALOG_TIMEOUT = 5
CATALOG_CACHE_SECONDS = 60
MAX_CATALOG_MODELS = 40


class StateError(ValueError):
    """A provider file is missing, invalid, or cannot be changed."""


class Conflict(RuntimeError):
    """Files kept changing while an action was being saved."""


HANDLED_ERRORS = (Conflict, OSError, ValueError, KeyError,
                  tomlkit.exceptions.ParseError)

ORIGIN_NOTES = {
    "auth.json": "live auth.json",
    "snapshot": "saved snapshot",
    "fallback": "fallback snapshot",
    "legacy": "legacy key in auth.json",
    "missing": "no file",
