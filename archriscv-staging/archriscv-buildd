  def render_index(req, error: nil)
    active, recent, latest_build_ids = build_history
    active = active.partition { |build| build.status == 'waiting_upload' }.flatten
    search = req.query['q'].to_s.strip
    unless search.empty?
      terms = search.downcase.split
      recent = recent.select do |build|
        text = [build.pkgbase, build.command_line, build.status, build.build_host, build.note, build.exit_status,
                ('latest' if latest_build_ids.key?(build.id))].compact.join(' ').downcase
        terms.all? { |term| text.include?(term) }
      end
    end
    push_branch_buttons = {}
    branches = nil
    recent.each do |build|
      next if @read_only || !latest_build_ids.key?(build.id) || !build.can_push_branch?

      branches ||= @manager.overlay_branches
      button = push_branch_button(build, latest: true, branches: branches)
      push_branch_buttons[build.id] = button unless button.empty?
    end
    recent = recent.partition { |build| push_branch_buttons.key?(build.id) }.flatten
    page_count = [(recent.size + RECENT_PAGE_SIZE - 1) / RECENT_PAGE_SIZE, 1].max
    page = [[req.query['page'].to_i, 1].max, page_count].min
    recent_page = recent[((page - 1) * RECENT_PAGE_SIZE), RECENT_PAGE_SIZE] || []
    search_query = search.empty? ? '' : "&q=#{CGI.escape(search)}"
    pagination = if page_count > 1
                   <<~HTML
                     <div class="buttons are-small mb-0">
                       #{%(<a class="button is-small is-light" href="#{h(dashboard_path("?page=#{page - 1}#{search_query}"))}">Prev</a>) if page > 1}
                       <span class="button is-small is-static">#{page} / #{page_count}</span>
                       #{%(<a class="button is-small is-light" href="#{h(dashboard_path("?page=#{page + 1}#{search_query}"))}">Next</a>) if page < page_count}
                     </div>
                   HTML
                 else
                   ''
                 end
    recent_empty = search.empty? ? 'Completed builds will appear here.' : 'No matching completed builds.'
    pending = @manager.refresh_pending
    notice = req.query['notice']

    layout('dashboard', <<~HTML)
      <header class="masthead">
        <h1>#{APP_TITLE}</h1>
        <span class="experimental">Experimental</span>
        <div class="build-actions">#{account_controls}</div>
      </header>

      #{flash('error', error) if error}
      #{flash('notice', notice) if notice}

      #{start_build_form unless @read_only}
      #{refresh_panel(pending) unless @read_only}
      #{codex_panel unless @read_only}

      <div class="build-columns">
        <div>
          <section class="build-section">
            <div class="section-heading">
              <h2>Running builds <span class="section-count">#{active.size}</span></h2>
            </div>
            <div class="build-list">
              #{active.empty? ? empty_state('No builds are running.') : active.map { |build| build_card(build) }.join}
            </div>
          </section>
          #{deferred_panel(@manager.deferred_retries)}
        </div>

        <section class="build-section recent-builds">
          <div class="section-heading">
            <h2>Recent builds <span class="section-count">#{recent.size}</span></h2>
            <form class="field has-addons history-search" action="#{h(dashboard_path)}" method="get">
              <div class="control is-expanded">
                <input class="input is-small" name="q" type="search" value="#{h(search)}" aria-label="Search recent builds" placeholder="Search recent builds">
              </div>
              <div class="control"><button class="button is-small is-light" type="submit">Search</button></div>
              <div class="control"><a class="button is-small is-light" href="#{h(dashboard_path('?q=latest+failed'))}">Latest failed</a></div>
              #{%(<div class="control"><a class="button is-small is-light" href="#{h(dashboard_path)}">Clear</a></div>) unless search.empty?}
            </form>
          </div>
          <div class="build-list">
            #{recent_page.empty? ? empty_state(recent_empty) : recent_page.map { |build| build_card(build, latest: latest_build_ids.key?(build.id), push_branch: push_branch_buttons.fetch(build.id, '')) }.join}
