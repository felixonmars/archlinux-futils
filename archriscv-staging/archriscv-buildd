            <details class="codex-controls">
              <summary class="button is-light">Options</summary>
              <div class="codex-options">
                <p>Closing this page leaves Codex running. Use /exit in the terminal when finished.</p>
                <form class="inline" action="#{h(dashboard_path("codex/#{id}/rebuild"))}" method="post">
                  <label class="checkbox"><input type="checkbox" name="rebuild" value="1"#{' checked' if session.rebuild}#{' disabled' unless session.active?}> Rebuild on exit with overlay branch</label>
                  <button class="button is-small" type="submit"#{' disabled' unless session.active?}>Save</button>
                </form>
                <form class="inline" action="#{h(dashboard_path("codex/#{id}/stop"))}" method="post">
                  <button class="button is-small is-danger" type="submit"#{' disabled' unless session.active?} onclick="return confirm('Stop Codex without scheduling a rebuild?')">Stop without rebuild</button>
                </form>
                <p><a href="#{h(dashboard_path("builds/#{session.build_id}/log"))}">Failed build log</a></p>
                <div class="build-actions">#{account_controls}</div>
              </div>
            </details>
          </div>
          <p id="codex-status" role="status">#{h((session.activity || session.status).tr('_', ' '))}</p>
          <p id="codex-error" role="alert" class="has-text-danger"></p>
          <a id="codex-rebuild"#{session.rebuild_id ? %( href="#{h(dashboard_path("builds/#{session.rebuild_id}/log"))}") : ' hidden'}>Open scheduled build</a>
        </section>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@xterm/xterm@6.0.0/css/xterm.css" integrity="sha384-n2n7twoohnW+d3myBKaUgl7DSiwidw6MkQy9oesGzkPpMjejKRR3XlnD+5yCdtBD" crossorigin="anonymous">
