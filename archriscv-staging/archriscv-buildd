    host_text = build.build_host.to_s

    html(res, layout("log #{build.id}", <<~HTML))
      <section class="box mb-3">
        <div class="level mb-2">
          <div class="level-left">
            <div>
              <div class="build-title mb-1">
                #{status_tag(build.status)}
                <h1 class="title is-4 mb-0">#{h(build.pkgbase || build.command_line)}</h1>
                <span id="build-host" class="tag is-light"#{host_style}>#{h(host_text)}</span>
              </div>
