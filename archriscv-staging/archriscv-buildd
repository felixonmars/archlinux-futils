PROMPT_PATTERN = /(?:\A|[\r\n])Upload log\? \[y\/N\] \z/.freeze
HOST_PATTERN = /(?:\A|[\r\n])==> Building on ([A-Za-z0-9._-]+)/.freeze
ANSI_PATTERN = /\e(?:\][^\a]*?(?:\a|\e\\)|\[[0-?]*[ -\/]*[@-~]|[ -\/]*[0-~])/.freeze
COMMAND_PATTERN = /\A[A-Za-z0-9][A-Za-z0-9@._+-]*(?::nocheck)?\z/.freeze
TARGET_BUILDER_PATTERN = /\A(?:[A-Za-z0-9_][A-Za-z0-9._-]*@)?[A-Za-z0-9][A-Za-z0-9._-]*\z/.freeze
ACTIVE_STATUSES = %w[queued running waiting_upload].freeze
TERMINAL_STATUSES = %w[succeeded failed interrupted].freeze

def h(value)
  CGI.escapeHTML(value.to_s)
end

def safe_filename(value)
  value.to_s.gsub(/[^A-Za-z0-9._+-]+/, '_').sub(/\A_+/, '').sub(/_+\z/, '')
end

def parse_time(value)
  return unless value

  Time.parse(value)
rescue ArgumentError, TypeError
  nil
end

def fmt_time(value)
  return 'not yet' unless value

  value.utc.strftime('%Y-%m-%d %H:%M:%S UTC')
end

def duration(build)
  return '-' unless build.started_at

  finished = build.finished_at || Time.now.utc
  seconds = [(finished - build.started_at).to_i, 0].max
  minutes, secs = seconds.divmod(60)
  hours, minutes = minutes.divmod(60)
  hours.positive? ? format('%dh%02dm%02ds', hours, minutes, secs) : format('%dm%02ds', minutes, secs)
end

def read_log(path, offset = 0, max_bytes = nil)
  return ['', 0] unless File.exist?(path)

  size = File.size(path)
  offset = [[offset, 0].max, size].min
  max_bytes ||= size - offset
  data = +''
  File.open(path, 'rb') do |file|
    file.seek(offset)
    data = file.read(max_bytes).to_s
    offset = file.pos
  end
  [data, offset]
end

def utf8(value)
  value.to_s.encode('UTF-8', invalid: :replace, undef: :replace)
end

def status_class(status)
  case status
  when 'running' then 'is-info'
  when 'waiting_upload' then 'is-warning'
  when 'failed', 'interrupted' then 'is-danger'
  when 'succeeded' then 'is-success'
  else 'is-light'
  end
end

def status_tag(status, id: nil)
  id_attr = id ? %( id="#{h(id)}") : ''
  %(<span#{id_attr} class="tag #{status_class(status)}">#{h(status.tr('_', ' '))}</span>)
end

class Build
  attr_accessor :id, :command_line, :argv, :pkgbase, :log_path, :status,
                :created_at, :started_at, :finished_at, :exit_status,
                :upload_prompt_seen, :upload_decision, :prompt_answered_at,
                :build_host, :target_builder, :note, :unit_name, :discard_after_finish, :stop_requested

  def initialize(id:, command_line:, argv:, pkgbase:, log_path:, status: 'queued',
                 created_at: Time.now.utc, started_at: nil, finished_at: nil,
                 exit_status: nil, upload_prompt_seen: false, upload_decision: nil,
                 prompt_answered_at: nil, build_host: nil, target_builder: nil, note: nil,
                 unit_name: nil, discard_after_finish: false, stop_requested: false)
    @id = id
    @command_line = command_line
    @argv = argv
    @pkgbase = pkgbase
    @log_path = log_path
    @status = status
    @created_at = created_at
    @started_at = started_at
    @finished_at = finished_at
    @exit_status = exit_status
    @upload_prompt_seen = upload_prompt_seen
    @upload_decision = upload_decision
    @prompt_answered_at = prompt_answered_at
    @build_host = build_host
    @target_builder = target_builder
    @note = note
    @unit_name = unit_name
    @discard_after_finish = discard_after_finish
    @stop_requested = stop_requested
  end

  def self.from_h(hash)
    new(
      id: hash.fetch('id'),
      command_line: hash.fetch('command_line'),
      argv: hash.fetch('argv'),
      pkgbase: hash['pkgbase'],
      log_path: hash.fetch('log_path'),
      status: hash.fetch('status', 'queued'),
      created_at: parse_time(hash['created_at']) || Time.now.utc,
      started_at: parse_time(hash['started_at']),
      finished_at: parse_time(hash['finished_at']),
      exit_status: hash['exit_status'],
      upload_prompt_seen: hash['upload_prompt_seen'] || false,
      upload_decision: hash['upload_decision'],
      prompt_answered_at: parse_time(hash['prompt_answered_at']),
      build_host: hash['build_host'],
      target_builder: hash['target_builder'],
      note: hash['note'],
      unit_name: hash['unit_name'],
      discard_after_finish: hash['discard_after_finish'] || false,
      stop_requested: hash['stop_requested'] || false
    )
  end

  def to_h
    {
      'id' => id,
      'command_line' => command_line,
      'argv' => argv,
      'pkgbase' => pkgbase,
      'log_path' => log_path,
      'status' => status,
      'created_at' => created_at&.utc&.iso8601,
      'started_at' => started_at&.utc&.iso8601,
      'finished_at' => finished_at&.utc&.iso8601,
      'exit_status' => exit_status,
      'upload_prompt_seen' => upload_prompt_seen,
      'upload_decision' => upload_decision,
      'prompt_answered_at' => prompt_answered_at&.utc&.iso8601,
      'build_host' => build_host,
      'target_builder' => target_builder,
      'note' => note,
      'unit_name' => unit_name,
      'discard_after_finish' => discard_after_finish,
      'stop_requested' => stop_requested
    }
  end

  def active?
    ACTIVE_STATUSES.include?(status)
  end

  def terminal?
    TERMINAL_STATUSES.include?(status)
  end
end

def write_json(path, data)
  tmp = "#{path}.tmp"
  File.write(tmp, JSON.pretty_generate(data), mode: 'w', perm: 0o600)
  File.rename(tmp, path)
end

module ProcessDescriptors
  extend Fiddle::Importer
  dlload Fiddle::Handle::DEFAULT
  extern 'int pidfd_open(int, unsigned int)'
  extern 'int pidfd_getfd(int, int, unsigned int)'
end

class BuildTerminal
  def self.interrupt(pid)
    raise ArgumentError, 'build worker is not running' unless pid.positive?

    fd = ProcessDescriptors.pidfd_open(pid, 0)
    raise SystemCallError.new('open build worker', Fiddle.last_error) if fd.negative?

    process = IO.for_fd(fd)
    # Duplicate the existing PTY master; reopening /proc/PID/fd/N would create
    # a different PTY. A pidfd also prevents targeting a reused process ID.
    terminal = Dir.children("/proc/#{pid}/fdinfo").find do |name|
      File.read("/proc/#{pid}/fdinfo/#{name}").match?(/^tty-index:\s*\d+/)
    rescue Errno::ENOENT
      false
    end
    raise ArgumentError, 'build terminal is not ready' unless terminal

    fd = ProcessDescriptors.pidfd_getfd(process.fileno, terminal.to_i, 0)
    raise SystemCallError.new('access build terminal', Fiddle.last_error) if fd.negative?

    IO.open(fd, 'w') do |writer|
      raise ArgumentError, 'build terminal is no longer available' unless writer.tty?

      writer.write("\x03")
      writer.flush
    end
  ensure
    process&.close
  end
end

class SystemdBuildService
  def start(build, directory)
    output, status = Open3.capture2e(
      'systemd-run', '--quiet', '--collect', '--service-type=exec',
      "--unit=#{build.unit_name}", "--description=Build #{build.command_line}",
      "--property=User=#{Process.uid}", "--property=Group=#{Process.gid}",
      # Detached SSH control masters may also carry sessions for other builds.
      '--property=KillMode=process', '--property=TimeoutStopSec=10s',
      '--property=UMask=0077',
      '--', RbConfig.ruby, File.realpath(__FILE__), '--worker', directory
    )
    raise "could not start build worker: #{output.strip}" unless status.success? || active?(build)
  end

  def active?(build)
    output, status = Open3.capture2e('systemctl', 'show', '--property=LoadState,ActiveState', build.unit_name)
    properties = output.lines.filter_map do |line|
      key, value = line.strip.split('=', 2)
      [key, value] if value
    end.to_h
    return false if properties['LoadState'] == 'not-found'

    raise "could not query build worker: #{output.strip}" unless status.success?

    %w[active activating reloading deactivating].include?(properties['ActiveState'])
  end

  def stop(build)
    output, status = Open3.capture2e('systemctl', 'stop', build.unit_name)
    raise "could not stop build worker: #{output.strip}" unless status.success? || !active?(build)
  end

  def interrupt(build)
    output, status = Open3.capture2e('systemctl', 'show', '--property=MainPID', '--value', build.unit_name)
    raise "could not query build worker: #{output.strip}" unless status.success?

    BuildTerminal.interrupt(output.strip.to_i)
  end
end

class BuildWorker
  def initialize(directory)
    @directory = directory
    @request = JSON.parse(File.read(File.join(directory, 'request.json')))
    @build = Build.from_h(@request.fetch('build'))
    @prompt_tail = +''
    @stopping = false
  end

  def run
    File.open(File.join(@directory, 'lock'), 'w', 0o600) do |lock|
      raise 'build worker is already running' unless lock.flock(File::LOCK_EX | File::LOCK_NB)
      # A worker may be reattached to, but must never rerun a started build.
      return 0 if File.exist?(status_path)

      run_build
    end
    @build.status == 'succeeded' ? 0 : 1
  end

  private

  def status_path
    File.join(@directory, 'status.json')
  end

  def persist
    write_json(status_path, @build.to_h)
  end

  def append_log(chunk)
    File.open(@build.log_path, 'ab') { |file| file.write(chunk) }
  end

  def run_build
    handlers = %w[INT TERM].to_h { |signal| [signal, trap(signal) { @stopping = true }] }
    @build.status = 'running'
    @build.started_at = Time.now.utc
    persist
    append_log("$ #{@build.argv.shelljoin}\n")
    append_log("target builder: #{@build.target_builder}\n") if @build.target_builder
    append_log("started: #{@build.started_at.iso8601}\n\n")

    env = @request.fetch('environment').merge('TERM' => 'xterm')
    env['SERVER'] = @build.target_builder if @build.target_builder
    options = {chdir: @request.fetch('workdir'), unsetenv_others: true}
    @reader, @writer, @pid = PTY.spawn(env, *@build.argv, options)
    @writer.sync = true
    eof = false
    until @wait_status || @stopping
      if IO.select(eof ? [] : [@reader], nil, nil, 0.25)
        eof = !read_output
      end
      answer_upload unless @stopping
      _, @wait_status = Process.wait2(@pid, Process::WNOHANG)
    end
    while !eof && IO.select([@reader], nil, nil, 0)
      eof = !read_output
    end
  rescue StandardError => e
    @build.note = e.message
    append_log("\n#{APP_NAME}: #{e.class}: #{e.message}\n")
  ensure
    reap_child
    @reader&.close unless @reader&.closed?
    @writer&.close unless @writer&.closed?
    @build.exit_status = @wait_status&.exitstatus || (@wait_status&.termsig && 128 + @wait_status.termsig)
    @build.finished_at = Time.now.utc
    @build.status = if @stopping
                      @build.note ||= 'build worker stopped'
                      'interrupted'
                    elsif @wait_status&.success? && !@build.note
                      'succeeded'
                    else
                      'failed'
                    end
    append_log("\nfinished: #{@build.finished_at.iso8601} exit=#{@build.exit_status || 'unknown'}\n")
    persist
    handlers&.each { |signal, handler| trap(signal, handler) }
  end

  def read_output
    chunk = @reader.read_nonblock(16_384, exception: false)
    return false unless chunk
    return true if chunk == :wait_readable

    append_log(chunk)
    observe_prompt(chunk)
    true
  rescue EOFError, Errno::EIO
    false
  end

  def observe_prompt(chunk)
    tail = @prompt_tail + chunk
    @prompt_tail = tail.bytesize > 512 ? tail.byteslice(-512, 512) : tail
    clean_tail = @prompt_tail.gsub(ANSI_PATTERN, '')
    changed = false
    if !@build.build_host && (match = clean_tail.match(HOST_PATTERN))
      @build.build_host = match[1]
      changed = true
    end
    if !@build.upload_prompt_seen && clean_tail.match?(PROMPT_PATTERN)
      @build.upload_prompt_seen = true
      @build.status = 'waiting_upload'
      changed = true
    end
    persist if changed
  end

  def answer_upload
    return unless @build.status == 'waiting_upload'

    path = File.join(@directory, 'upload.json')
    return unless File.exist?(path)

    decision = JSON.parse(File.read(path)).fetch('decision')
    raise 'invalid upload decision' unless %w[upload skip].include?(decision)

    @writer.write(decision == 'upload' ? "y\n" : "n\n")
    @writer.flush
    @build.upload_decision = decision
    @build.prompt_answered_at = Time.now.utc
    @build.discard_after_finish = decision == 'skip'
    @build.status = 'running'
    persist
  end

  def reap_child
    return unless @pid

    # Reap the build's process group even after its leader exits. SSH control
    # masters detach into separate sessions and must survive for other clients.
    signal_child_group('TERM')
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 3
    loop do
      _, @wait_status = Process.wait2(@pid, Process::WNOHANG) unless @wait_status
      break unless signal_child_group(0)
      break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

      sleep 0.05
    end
    signal_child_group('KILL')
    _, @wait_status = Process.wait2(@pid) unless @wait_status
  rescue Errno::ECHILD
    nil
  end

  def signal_child_group(signal)
    Process.kill(signal, -@pid)
  rescue Errno::ESRCH
    nil
  end
end

class BuildManager
  def initialize(service: SystemdBuildService.new)
    @service = service
    @mutex = Mutex.new
    @builds = {}
    @refresh_pending = []
    @deferred_retries = []
    @shutting_down = false

    FileUtils.mkdir_p([STATE_DIR, LOG_DIR, WORKER_DIR])
    load_state
  end

  def start
    @mutex.synchronize do
      @builds.values.select { |build| build.status == 'queued' }.each do |build|
        unless build.unit_name
          prepare_worker(build)
          persist_locked
        end
        launch_worker(build) unless File.exist?(worker_status_path(build)) || @service.active?(build)
      end
      refresh_workers_locked(check_units: true)
    end
    @monitor = Thread.new do
      tick = 0
      loop do
        sleep 1
        break if @shutting_down

        @mutex.synchronize { refresh_workers_locked(check_units: (tick % 10).zero?) }
        tick += 1
      rescue StandardError => e
        warn "#{APP_NAME}: worker monitor: #{e.message}"
      end
    end
  end

  def all_builds
    @mutex.synchronize do
      refresh_workers_locked
      @builds.values.sort_by(&:created_at).reverse
    end
  end

  def find(id)
    @mutex.synchronize do
      refresh_workers_locked
      @builds[id]
    end
  end

  def refresh_pending
    @mutex.synchronize { @refresh_pending.dup }
  end

  def enqueue(command_line, target_builder: nil, ignore_active_id: nil, new_builder: false)
    build = new_build(command_line, target_builder: new_builder ? nil : target_builder)

    @mutex.synchronize do
      refresh_workers_locked
      check_duplicate_locked(build.pkgbase, ignore_active_id: ignore_active_id)

      clear_builder_cache(build.pkgbase) if new_builder
      @builds[build.id] = build
      prepare_worker(build, new_builder: new_builder)
      persist_locked
      launch_worker(build)
    end
    build
  rescue ArgumentError
    raise
  rescue StandardError => e
    raise ArgumentError, e.message
  end

  def refresh_from_remote(extra_safe_deps: nil)
    argv = Shellwords.split(REFRESH_COMMAND)
    extra_safe_deps = extra_safe_deps.to_s.strip
    argv << "--extra-safe-deps=#{extra_safe_deps}" unless extra_safe_deps.empty?
    output, status = Open3.capture2e(*argv)
    raise ArgumentError, "#{REFRESH_COMMAND} failed: #{output.lines.last.to_s.strip}" unless status.success?

    candidates = output.lines.map(&:strip).select { |line| line.match?(COMMAND_PATTERN) }.uniq
    added = []
    @mutex.synchronize do
      added = candidates.reject { |pkgbase| @refresh_pending.include?(pkgbase) }
      @refresh_pending.concat(added)
      persist_locked if added.any?
    end
    added
  end

  def enqueue_refresh(pkgbases)
    queued = []
    errors = []
    selected = Array(pkgbases).map(&:to_s).map(&:strip).uniq.select do |pkgbase|
      pkgbase.match?(COMMAND_PATTERN) && @mutex.synchronize { @refresh_pending.include?(pkgbase) }
    end

    unless selected.empty?
      output = `pacman -Sy 2>&1`
      raise ArgumentError, "pacman -Sy failed: #{output.lines.last.to_s.strip}" unless $?.success?
    end

    selected.each do |pkgbase|
      begin
        build = enqueue(pkgbase)
        queued << build
        @mutex.synchronize do
          @refresh_pending.delete(pkgbase)
          persist_locked
        end
      rescue ArgumentError => e
        errors << "#{pkgbase}: #{e.message}"
      end
    end

    [queued, errors]
  end

  def clear_refresh(pkgbases)
    selected = Array(pkgbases).map(&:to_s).map(&:strip)
    @mutex.synchronize do
      selected = @refresh_pending if selected.empty?
      before = @refresh_pending.size
      @refresh_pending -= selected
      persist_locked if @refresh_pending.size != before
      before - @refresh_pending.size
    end
  end

  def answer_upload(id, upload:)
    decision = upload ? 'upload' : 'skip'
    @mutex.synchronize do
      refresh_workers_locked
      build = @builds[id] || raise(ArgumentError, 'unknown build')
      raise ArgumentError, 'build is not waiting for an upload decision' unless build.status == 'waiting_upload'

      save_upload_decision(build, decision)
    end

    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 5
    loop do
      build = find(id)
      return if !build || build.upload_decision == decision
      raise ArgumentError, 'build finished before accepting the upload decision' if build.terminal?
      break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

      sleep 0.05
    end
    raise ArgumentError, 'upload decision saved; the build worker has not acknowledged it yet'
  end

  def mark_memory_killer(id)
    @mutex.synchronize do
      refresh_workers_locked
      build = @builds[id] || raise(ArgumentError, 'unknown build')
      raise ArgumentError, 'build is not waiting for an upload decision' unless build.status == 'waiting_upload'

      FileUtils.mkdir_p(File.dirname(MEMORY_KILLER_LIST))
      File.open(MEMORY_KILLER_LIST, 'a+') do |file|
        file.flock(File::LOCK_EX)
        contents = file.read
        packages = contents.lines.map { |line| line.split('#', 2).first.to_s.strip }
        unless packages.include?(build.pkgbase)
          file.write("\n") unless contents.empty? || contents.end_with?("\n")
          file.puts(build.pkgbase)
        end
      end
      clear_builder_cache(build.pkgbase)
      build.pkgbase
    end
  rescue SystemCallError => e
    raise ArgumentError, e.message
  end

  def defer_build(id, wait_for:)
    wait_for = wait_for.to_s.strip
    unless wait_for.match?(COMMAND_PATTERN) && !wait_for.end_with?(':nocheck')
      raise ArgumentError, 'enter the package base to wait for'
    end

    @mutex.synchronize do
      refresh_workers_locked
      source = @builds[id] || raise(ArgumentError, 'unknown build')
      raise ArgumentError, 'build is not waiting for an upload decision' unless source.status == 'waiting_upload'
      raise ArgumentError, 'a build cannot wait for itself' if wait_for == source.pkgbase

      check_duplicate_locked(source.pkgbase, ignore_active_id: id)
      path = File.join(worker_directory(source), 'upload.json')
      raise ArgumentError, 'an upload decision has already been submitted' if File.exist?(path)

      build = new_build(source.command_line, target_builder: source.target_builder)
      @deferred_retries << {'build' => build.to_h, 'source_id' => id, 'wait_for' => wait_for, 'ready' => false}
      # Save the retry before skipping; the monitor can resend a skip after a crash.
      persist_locked
      save_upload_decision(source, 'skip')
      build
    end
  end

  def deferred_retries
    @mutex.synchronize { @deferred_retries.map(&:dup) }
  end

  def cancel_deferred(id)
    @mutex.synchronize do
      entry = @deferred_retries.find { |pending| pending['build']['id'] == id }
      raise ArgumentError, 'unknown deferred build' unless entry

      @deferred_retries.delete(entry)
      persist_locked
    end
  end

  def stop_build(id)
    build = @mutex.synchronize do
      refresh_workers_locked
      current = @builds[id] || raise(ArgumentError, 'unknown build')
      raise ArgumentError, 'build is not active' unless current.active?

      # Keep Kill available even if accessing the terminal fails.
      current.stop_requested = true
      persist_locked
      current
    end

    @service.interrupt(build)
  rescue StandardError => e
    raise ArgumentError, e.message
  end

  def kill_build(id)
    build = find(id) || raise(ArgumentError, 'unknown build')
    raise ArgumentError, 'build is not active' unless build.active?
    raise ArgumentError, 'stop the build before killing it' unless build.stop_requested

    @service.stop(build)
    @mutex.synchronize { refresh_workers_locked(check_units: true) }
  rescue StandardError => e
    raise ArgumentError, e.message
  end

  def delete_build(id)
    @mutex.synchronize do
      refresh_workers_locked
      build = @builds[id] || raise(ArgumentError, 'unknown build')
      raise ArgumentError, 'cannot delete an active build' if build.active?

      @builds.delete(id)
      persist_locked
      remove_build_files(build)
    end
  end

  def shutdown
    @shutting_down = true
    @monitor&.join
  end

  def shutting_down?
    @shutting_down
  end

  private

  def new_build(command_line, target_builder: nil)
    command_line = command_line.to_s.strip
    raise ArgumentError, 'enter a package name, optionally ending with :nocheck' unless command_line.match?(COMMAND_PATTERN)

    target_builder = target_builder.to_s.strip
    if !target_builder.empty? && !target_builder.include?('@') && !BUILDER_USER.empty?
      target_builder = "#{BUILDER_USER}@#{target_builder}"
    end
    unless target_builder.empty? || target_builder.match?(TARGET_BUILDER_PATTERN)
      raise ArgumentError, 'enter a target builder as host or user@host, or leave it blank for automatic selection'
    end
    target_builder = nil if target_builder.empty?

    pkgbase = command_line.sub(/:nocheck\z/, '')
    id = "#{Time.now.utc.strftime('%Y%m%d%H%M%S')}-#{format('%06x', Random.rand(0x1000000))}"
    Build.new(
      id: id, command_line: command_line, argv: [BUILD_COMMAND, command_line],
      pkgbase: pkgbase, target_builder: target_builder,
      log_path: File.expand_path(File.join(LOG_DIR, "#{id}-#{safe_filename(pkgbase)}.log"))
    )
  end

  def check_duplicate_locked(pkgbase, ignore_active_id: nil)
    if @deferred_retries.any? { |entry| entry['build']['pkgbase'] == pkgbase }
      raise ArgumentError, "#{pkgbase} already has a deferred retry"
    end
    if @builds.values.any? { |build| build.id != ignore_active_id && build.active? && build.pkgbase == pkgbase }
      raise ArgumentError, "#{pkgbase} is already queued or building"
    end
  end

  def save_upload_decision(build, decision)
    path = File.join(worker_directory(build), 'upload.json')
    if File.exist?(path)
      raise ArgumentError, 'an upload decision has already been submitted' if JSON.parse(File.read(path))['decision'] != decision

      return
    end
    write_json(path, 'decision' => decision)
  end

  def load_state
    return unless File.exist?(STATE_FILE)

    changed = false
    data = JSON.parse(File.read(STATE_FILE))
    data.fetch('builds', []).each do |entry|
      build = Build.from_h(entry)
      if !build.unit_name && %w[running waiting_upload].include?(build.status)
        build.status = 'interrupted'
        build.finished_at ||= Time.now.utc
        build.note = 'daemon restarted while this build was active'
        changed = true
      end
      @builds[build.id] = build
    end
    @refresh_pending = data.fetch('refresh_pending', []).select { |pkgbase| pkgbase.to_s.match?(COMMAND_PATTERN) }
    @deferred_retries = data.fetch('deferred_retries', [])
    persist_locked if changed
  rescue JSON::ParserError => e
    warn "#{APP_NAME}: ignoring unreadable state file: #{e.message}"
  end

  def persist_locked
    FileUtils.mkdir_p(STATE_DIR)
    write_json(STATE_FILE,
      'builds' => @builds.values.sort_by(&:created_at).map(&:to_h),
      'refresh_pending' => @refresh_pending,
      'deferred_retries' => @deferred_retries
    )
  end

  def worker_directory(build)
    File.join(WORKER_DIR, build.id)
  end

  def worker_status_path(build)
    File.join(worker_directory(build), 'status.json')
  end

  def clear_builder_cache(pkgbase)
    File.unlink(File.join(BUILDER_CACHE_DIR, "#{pkgbase}-riscv64"))
  rescue Errno::ENOENT
    nil
  end

  def prepare_worker(build, new_builder: false)
    build.unit_name = "#{APP_NAME}-build-#{build.id}.service"
    build.log_path = File.expand_path(build.log_path)
    directory = worker_directory(build)
    FileUtils.mkdir_p(directory, mode: 0o700)
    # Preserve the build environment without forwarding the web service's systemd identity.
    environment = ENV.to_h.reject do |key, _|
      %w[NOTIFY_SOCKET WATCHDOG_PID WATCHDOG_USEC INVOCATION_ID JOURNAL_STREAM SYSTEMD_EXEC_PID].include?(key)
    end
    # SERVER overrides the selector even when the package's cache was cleared.
    environment.delete('SERVER') if new_builder
    write_json(File.join(directory, 'request.json'),
      'build' => build.to_h,
      'environment' => environment,
      'workdir' => BUILD_WORKDIR.to_s.empty? ? Dir.pwd : File.expand_path(BUILD_WORKDIR)
    )
  end

  def launch_worker(build)
    @service.start(build, worker_directory(build))
  rescue StandardError => e
    build.status = 'failed'
    build.finished_at = Time.now.utc
    build.note = e.message
    persist_locked
    warn "#{APP_NAME}: build #{build.id}: #{e.message}"
  end

  def worker_status(build)
    path = worker_status_path(build)
    current = File.exist?(path) ? Build.from_h(JSON.parse(File.read(path))) : build

    # This flag belongs to the dashboard; worker snapshots do not set it.
    current.stop_requested ||= build.stop_requested

    # Older workers may have missed the host announcement before an ANSI-parser fix.
    current.build_host ||= build.build_host
    unless current.build_host
      log, = read_log(current.log_path, 0, 65_536)
      current.build_host = log.gsub(ANSI_PATTERN, '').match(HOST_PATTERN)&.[](1)
    end
    current
  end

  def refresh_workers_locked(check_units: false)
    changed = false
    removed = []
    succeeded = []
    @builds.values.select { |build| build.unit_name && (build.active? || build.discard_after_finish) }.each do |build|
      before = build.to_h
      current = worker_status(build)
      if check_units && current.active? && !@service.active?(current)
        # The worker can finish between reading its status and querying systemd.
        current = worker_status(current)
        if current.active?
          current.status = 'interrupted'
          current.finished_at ||= Time.now.utc
          current.note = 'build worker exited without recording a result'
        end
      end
      succeeded << current.pkgbase if current.status == 'succeeded' && build.status != 'succeeded'
      if current.terminal? && current.discard_after_finish
        @builds.delete(build.id)
        changed = true
        removed << current
      elsif current.to_h != before
        @builds[build.id] = current
        changed = true
      end
    end
    launches = []
    @deferred_retries.dup.each do |entry|
      if !entry['ready'] && succeeded.include?(entry['wait_for'])
        entry['ready'] = true
        changed = true
      end
      source = @builds[entry['source_id']]
      save_upload_decision(source, 'skip') if source&.status == 'waiting_upload'
      next unless entry['ready']
      next if @builds.values.any? { |build| build.active? && build.pkgbase == entry['build']['pkgbase'] }

      build = Build.from_h(entry['build'])
      prepare_worker(build)
      @builds[build.id] = build
      @deferred_retries.delete(entry)
      launches << build
      changed = true
    end
    # Persist successful prerequisites and queued retries together before launching.
    persist_locked if changed
    removed.each { |build| remove_build_files(build) }
    launches.each { |build| launch_worker(build) }
  end

  def remove_build_files(build)
    FileUtils.rm_f(build.log_path)
    FileUtils.rm_rf(worker_directory(build)) if build.unit_name
  end
end

class BuilderTags
  def initialize(path: ENV['ARCHRISCV_BUILDD_SELECTOR_PATH'])
    @path = path || ENV.fetch('PATH', '').split(File::PATH_SEPARATOR).map do |directory|
      File.join(directory, 'felixbuild-server-select')
    end.find { |candidate| File.file?(candidate) && File.executable?(candidate) }
    @mutex = Mutex.new
    @tags = {}
  end

  def for(host)
    return [] if host.to_s.empty? || !@path

    @mutex.synchronize do
      stat = File.stat(@path)
      version = [stat.ino, stat.mtime, stat.size]
      if @version != version
        @tags = parse(File.read(@path))
        @version = version
      end
      name = hostname(host)
      @tags[name] || @tags[name.split('.').first] || []
    end
  rescue SystemCallError
    []
  end

  private

  def hostname(host)
    host.to_s.split('@').last.to_s.downcase.sub(/\.\z/, '')
  end

  def parse(source)
    # Read both selector formats as data; never run its package selection logic.
    table = source[/^server_specs_text\s*=\s*<<~SPECS\s*\n(.*?)^SPECS\s*$/m, 1]
    (table || source).each_line.each_with_object({}) do |line, result|
      next if line.lstrip.start_with?('#')

      if table
        host, jobs, tags = line.strip.split(/\s*\|\s*/, 5)
        next unless jobs&.match?(/\A\d+\z/) && tags

        tags = tags.split
      else
        match = line.match(/^\s*["']([^"']+)["']\s*=>\s*\{[^\n]*?:tags\s*=>\s*\[([^\]]*)\]/)
        next unless match

        host = match[1]
        tags = match[2].scan(/["']([^"']+)["']/).flatten
      end
      result[hostname(host)] = tags
    end
  end
end

class WebApp
  def initialize(manager, read_only: false, builder_tags: BuilderTags.new)
    @manager = manager
    @read_only = read_only
    @builder_tags = builder_tags
  end

  def call(req, res)
    if @read_only && (!%w[GET HEAD].include?(req.request_method) || !view_path?(req.path))
      html(res, layout('view only', '<p class="notification is-warning">This listener is view only.</p>'), status: 403)
      return
    end

    method = req.request_method == 'HEAD' ? 'GET' : req.request_method
    case [method, req.path]
    when ['GET', '/']
      html(res, render_index(req))
    when ['GET', '/log-viewer.js']
      res['Content-Type'] = 'text/javascript; charset=utf-8'
      res['Cache-Control'] = 'no-cache'
      res.body = File.read(File.join(__dir__, 'archriscv-log.js'))
    when ['POST', '/builds']
      create_build(req, res)
    when ['POST', '/refresh']
      refresh_remote(req, res)
    when ['POST', '/refresh/add']
      add_refresh(req, res)
    when ['POST', '/refresh/clear']
      clear_refresh(req, res)
    else
      route_build(req, res)
    end
  rescue ArgumentError => e
    html(res, render_index(req, error: e.message), status: 400)
  rescue StandardError => e
    warn "#{APP_NAME}: web: #{e.class}: #{e.message}"
    warn e.backtrace.first(5).join("\n") if ENV['ARCHRISCV_BUILDD_DEBUG']
    html(res, layout('error', %(<section class="notification is-danger"><h2 class="title is-5">Internal error</h2><p>#{h(e.message)}</p></section>)), status: 500)
  end

  private

  def view_path?(path)
    ['/', '/log-viewer.js'].include?(path) || path.match?(%r{\A/builds/[^/]+/(?:log|raw|events)\z})
  end

  def dashboard_path(path = '')
    "#{@read_only ? './' : '/'}#{path}"
  end

  def builder_title(host)
    tags = @builder_tags.for(host)
    tags.empty? ? '' : %( title="#{h(tags.join(', '))}")
  end

  def route_build(req, res)
    case req.path
    when %r{\A/builds/([^/]+)/log\z}
      show_log(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/raw\z}
      raw_log(res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/events\z}
      stream_events(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/upload\z}
      answer_upload(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/retry\z}
      retry_build(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/defer\z}
      defer_build(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/memory-killer\z}
      mark_memory_killer(req, res, Regexp.last_match(1))
    when %r{\A/deferred/([^/]+)/cancel\z}
      cancel_deferred(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/stop\z}
      stop_build(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/kill\z}
      kill_build(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/delete\z}
      delete_build(req, res, Regexp.last_match(1))
    else
      not_found(res)
    end
  end

  def create_build(req, res)
    @manager.enqueue(req.query['command'], target_builder: req.query['target_builder'])
    redirect(res, '/')
  end

  def refresh_remote(req, res)
    added = @manager.refresh_from_remote(extra_safe_deps: req.query['extra_safe_deps'])
    message = added.empty? ? "#{REFRESH_COMMAND} found no new packages" : "#{REFRESH_COMMAND} added #{added.size} pending package(s)"
    redirect(res, "/?notice=#{CGI.escape(message)}")
  end

  def add_refresh(req, res)
    selected = Array(req.query['pkgbase'])
    raise ArgumentError, 'select at least one pending package' if selected.empty?

    queued, errors = @manager.enqueue_refresh(selected)
    message = "queued #{queued.size} build(s)"
    message += "; #{errors.join('; ')}" if errors.any?
    redirect(res, "/?notice=#{CGI.escape(message)}")
  end

  def clear_refresh(req, res)
    selected = Array(req.query['pkgbase'])
    raise ArgumentError, 'select at least one pending package' if selected.empty?

    count = @manager.clear_refresh(selected)
    redirect(res, "/?notice=#{CGI.escape("cleared #{count} pending package(s)")}")
  end

  def answer_upload(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    @manager.answer_upload(id, upload: req.query['decision'] == 'yes')
    redirect(res, '/')
  end

  def mark_memory_killer(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    pkgbase = @manager.mark_memory_killer(id)
    message = "#{pkgbase} added to the memory killer list (requires at least 32 GiB RAM for automatic selection)"
    redirect(res, "/?notice=#{CGI.escape(message)}")
  end

  def retry_build(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    build = @manager.find(id)
    return not_found(res) unless build
    unless %w[failed interrupted waiting_upload].include?(build.status)
      raise ArgumentError, 'only failed, interrupted, or upload-waiting builds can be retried'
    end

    @manager.answer_upload(id, upload: false) if build.status == 'waiting_upload'
    @manager.enqueue(build.command_line, target_builder: build.target_builder, ignore_active_id: id,
      new_builder: req.query['new_builder'] == '1')
    redirect(res, '/')
  end

  def stop_build(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    @manager.stop_build(id)
    redirect(res, '/')
  end

  def kill_build(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    @manager.kill_build(id)
    redirect(res, '/')
  end

  def defer_build(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    @manager.defer_build(id, wait_for: req.query['wait_for'])
    redirect(res, '/')
  end

  def cancel_deferred(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    @manager.cancel_deferred(id)
    redirect(res, '/')
  end

  def delete_build(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    @manager.delete_build(id)
    redirect(res, '/')
  end

  def show_log(_req, res, id)
    build = @manager.find(id)
    return not_found(res) unless build

    log, offset = read_log(build.log_path)
    host_style = build.build_host ? '' : ' style="display:none"'
    host_text = build.build_host.to_s

    html(res, layout("log #{build.id}", <<~HTML))
      <section class="box log-heading">
        <div class="section-heading">
          <div class="build-title">
            <h1 class="title is-4 mb-0">#{h(build.pkgbase || build.command_line.sub(/:nocheck\z/, ''))}</h1>
            #{nocheck_tag(build.command_line)}
          </div>
          <div class="build-actions">
            <a class="button is-light" href="../../">Dashboard</a>
            <a class="button is-light" href="raw">Raw log</a>
            #{retry_button(build) unless build.status == 'waiting_upload'}
            #{stop_button(build)}
          </div>
        </div>
        <div class="build-toolbar is-size-7 has-text-grey">
          <span id="build-host" class="tag is-light"#{builder_title(build.build_host)}#{host_style}>#{h(host_text)}</span>
          <span>started #{h(fmt_time(build.started_at))}</span>
          <span>duration <span id="duration">#{h(duration(build))}</span></span>
        </div>
      </section>

      #{decision_panel(build, live: true)}

      <section class="box log-panel p-3">
        <div class="build-toolbar mb-2">
          #{status_tag(build.status, id: 'status')}
          <span class="is-size-7 has-text-grey">live log</span>
        </div>
        <pre id="log" class="is-size-7"></pre>
      </section>
      <a class="button is-medium is-warning top-link" href="#top" title="Back to top">&uarr; Top</a>
      <button id="end-link" class="button is-medium is-info end-link" type="button" title="Back to end">&darr; End</button>

      <script src="../../log-viewer.js?v=1"></script>
      <script>
        const statusEl = document.querySelector('#status');
        const hostEl = document.querySelector('#build-host');
        const decisionEl = document.querySelector('#decision');
        const stopControls = document.querySelector('[data-stop-controls]');
        const killButton = document.querySelector('[data-kill-button]');
        const durationEl = document.querySelector('#duration');
        const logEl = document.querySelector('#log');
        const endLink = document.querySelector('#end-link');
        let offset = #{offset};

        const terminal = new TerminalLog(logEl);

        function statusClass(status) {
          if (status === 'running') return 'is-info';
          if (status === 'waiting_upload') return 'is-warning';
          if (status === 'failed' || status === 'interrupted') return 'is-danger';
          if (status === 'succeeded') return 'is-success';
          return 'is-light';
        }

        function appendLog(text) {
          if (!text) return;
          const wasNearBottom = nearBottom();
          terminal.write(text);
          if (wasNearBottom) window.scrollTo(0, document.body.scrollHeight);
          updateEndLink();
        }

        function nearBottom() {
          return window.innerHeight + window.scrollY >= document.body.offsetHeight - 120;
        }

        function updateEndLink() {
          endLink.style.display = nearBottom() ? 'none' : '';
        }

        const initialLog = #{JSON.generate(utf8(log)).gsub('<') { '\\u003c' }};
        terminal.write(initialLog);
        requestAnimationFrame(() => window.scrollTo(0, document.body.scrollHeight));
        requestAnimationFrame(updateEndLink);
        window.addEventListener('scroll', updateEndLink, { passive: true });
        endLink.addEventListener('click', () => {
          window.scrollTo(0, document.body.scrollHeight);
          updateEndLink();
        });

        const events = new EventSource(`events?offset=${offset}`);
        events.addEventListener('log', (event) => appendLog(JSON.parse(event.data)));
        events.addEventListener('status', (event) => {
          const data = JSON.parse(event.data);
          statusEl.textContent = data.status.replace(/_/g, ' ');
          statusEl.className = `tag ${statusClass(data.status)}`;
          if (hostEl && data.build_host) {
            hostEl.textContent = data.build_host;
            hostEl.title = (data.build_tags || []).join(', ');
            hostEl.style.display = '';
          }
          durationEl.textContent = data.duration;
          if (data.started_at) {
            document.querySelectorAll('[data-builder-expires-at]').forEach((label) => {
              label.dataset.builderExpiresAt = Date.parse(data.started_at) + 300000;
            });
          }
          if (decisionEl) decisionEl.style.display = data.status === 'waiting_upload' ? '' : 'none';
          if (stopControls) stopControls.style.display = data.done ? 'none' : '';
          if (killButton) killButton.style.display = data.stop_requested ? '' : 'none';
          if (data.done) events.close();
        });
      </script>
    HTML
  end

  def raw_log(res, id)
    build = @manager.find(id)
    return not_found(res) unless build

    res.status = 200
    res['Content-Type'] = 'text/plain; charset=utf-8'
    res.body = File.exist?(build.log_path) ? File.open(build.log_path, 'rb') : ''
  end

  def stream_events(req, res, id)
    build = @manager.find(id)
    return not_found(res) unless build

    res.status = 200
    res['Content-Type'] = 'text/event-stream; charset=utf-8'
    res['Cache-Control'] = 'no-cache'
    res['X-Accel-Buffering'] = 'no'
    res.chunked = true
    res.body = proc do |out|
      offset = (req['last-event-id'] || req.query['offset']).to_i
      last_status = nil
      loop do
        break if @manager.shutting_down?

        log, offset = read_log(build.log_path, offset)
        sse(out, 'log', JSON.generate(utf8(log)), id: offset) unless log.empty?

        current = @manager.find(id)
        break unless current

        payload = {
          status: current.status,
          build_host: current.build_host,
          build_tags: @builder_tags.for(current.build_host),
          duration: duration(current),
          started_at: current.started_at&.iso8601,
          stop_requested: current.stop_requested,
          done: current.terminal?
        }
        encoded = JSON.generate(payload)
        if encoded != last_status
          sse(out, 'status', encoded)
          last_status = encoded
        end
        break if current.terminal? && log.empty?

        sleep 1
      end
    rescue IOError, Errno::EPIPE, Errno::ECONNRESET
      nil
    end
  end

  def render_index(req, error: nil)
    builds = @manager.all_builds
    active = builds.select(&:active?)
    recent = builds.reject(&:active?).sort_by do |build|
      build.finished_at || build.prompt_answered_at || build.started_at || build.created_at
    end.reverse
    search = req.query['q'].to_s.strip
    unless search.empty?
      needle = search.downcase
      recent = recent.select do |build|
        [build.pkgbase, build.command_line, build.status, build.build_host, build.note, build.exit_status].compact.any? do |value|
          value.to_s.downcase.include?(needle)
        end
      end
    end
    page_count = [(recent.size + RECENT_PAGE_SIZE - 1) / RECENT_PAGE_SIZE, 1].max
    page = [[req.query['page'].to_i, 1].max, page_count].min
    recent_page = recent[((page - 1) * RECENT_PAGE_SIZE), RECENT_PAGE_SIZE] || []
    search_query = search.empty? ? '' : "&q=#{CGI.escape(search)}"
    pagination = if page_count > 1
                   <<~HTML
                     <div class="buttons are-small mb-0">
                       #{%(<a class="button is-small is-light" href="#{h(dashboard_path("?page=#{page - 1}#{search_query}"))}">Prev</a>) if page > 1}
                       <span class="button is-small is-static">#{page} / #{page_count}</span>
                       #{%(<a class="button is-small is-light" href="#{h(dashboard_path("?page=#{page + 1}#{search_query}"))}">Next</a>) if page < page_count}
                     </div>
                   HTML
                 else
                   ''
                 end
    recent_empty = search.empty? ? 'Completed builds will appear here.' : 'No matching completed builds.'
    pending = @manager.refresh_pending
    notice = req.query['notice']

    layout('dashboard', <<~HTML)
      <header class="masthead">
        <h1>#{APP_TITLE}</h1>
        <span class="experimental">Experimental</span>
      </header>

      #{flash('error', error) if error}
      #{flash('notice', notice) if notice}

      #{start_build_form unless @read_only}
      #{refresh_panel(pending) unless @read_only}

      <div class="build-columns">
        <div>
          <section class="build-section">
            <div class="section-heading">
              <h2>Running builds <span class="section-count">#{active.size}</span></h2>
            </div>
            <div class="build-list">
              #{active.empty? ? empty_state('No builds are running.') : active.map { |build| build_card(build) }.join}
            </div>
          </section>
          #{deferred_panel(@manager.deferred_retries)}
        </div>

        <section class="build-section recent-builds">
          <div class="section-heading">
            <h2>Recent builds <span class="section-count">#{recent.size}</span></h2>
            <form class="field has-addons history-search" action="#{h(dashboard_path)}" method="get">
              <div class="control is-expanded">
                <input class="input is-small" name="q" type="search" value="#{h(search)}" aria-label="Search recent builds" placeholder="Search recent builds">
              </div>
              <div class="control"><button class="button is-small is-light" type="submit">Search</button></div>
              #{%(<div class="control"><a class="button is-small is-light" href="#{h(dashboard_path)}">Clear</a></div>) unless search.empty?}
            </form>
          </div>
          <div class="build-list">
            #{recent_page.empty? ? empty_state(recent_empty) : recent_page.map { |build| build_card(build) }.join}
          </div>
          #{%(<div class="history-pagination">#{pagination}</div>) unless pagination.empty?}
        </section>
      </div>
