  def route_codex(req, res, method)
    if method == 'GET' && req.path == '/codex/status'
      res['Content-Type'] = 'application/json'
      res.body = JSON.generate(codex_entries.map do |entry|
        status = codex_session_status(entry)
        {id: entry.id, active: entry.active?, label: status.tr('_', ' '), css: status_class(status)}
      end)
    elsif (match = req.path.match(%r{\A/builds/([^/]+)/codex\z}))
      return false unless method == 'POST'

      session = @manager.spawn_codex(match[1], rebuild: req.query['skip_rebuild'] != '1')
      redirect(res, "/codex/#{session.id}")
    elsif (match = req.path.match(%r{\A/codex/([a-f0-9]{24})(?:/(output|recording|frames|input|rebuild|stop))?\z}))
      id, action = match.captures
      case [method, action]
      when ['GET', nil]
        show_codex(res, id)
      when ['GET', 'output']
        res['Content-Type'] = 'application/json'
        res.body = JSON.generate(@manager.codex_output(id, Integer(req.query.fetch('offset', '0'), 10)))
      when ['GET', 'recording']
        cursor = Integer(req.query.fetch('cursor', '0'), 10)
        result = @manager.codex_frames(id, cursor)
        replay = CodexReplay.new if cursor.zero?
        res['Content-Type'] = 'application/x-ndjson'
        res['Cache-Control'] = 'no-store'
        res['Vary'] = 'Accept-Encoding'
        compress = req['accept-encoding'].to_s.split(',').any? do |encoding|
          name, quality = encoding.strip.split(/\s*;\s*q=/i, 2)
          name.casecmp?('gzip') && (!quality || quality.to_f.positive?)
        end
        res['Content-Encoding'] = 'gzip' if compress
        res.chunked = true
        # One streamed response avoids a network round trip per replay chunk.
        # Its fixed endpoint lets attachment finish even while Codex is writing.
        res.body = proc do |output|
          gzip = Zlib::GzipWriter.new(output) if compress
          loop do
            events = []
            bytes = 0
            deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 0.1
            loop do
              result[:events].each do |event|
                if event['data']
                  data = event['data'].unpack1('m0')
                  data = replay.compact(data) if replay
                  bytes += data.bytesize
                  if events.last&.key?('data')
                    events.last['data'] << data
                  elsif !data.empty?
                    events << {'data' => data}
                  end
                else
                  replay&.resize
                  events << event
                end
              end
              # Keep compacted batches useful without delaying progress on a
              # long idle recording. One source batch can add up to 128 KiB.
              break if !result[:more] || bytes >= 131_072 || events.size >= 256 ||
                Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

              result = @manager.codex_frames(id, result[:cursor], finish: result[:finish])
            end
            events.each { |event| event['data'] = [event['data']].pack('m0') if event['data'] }
            result[:events] = events
            (gzip || output).write(JSON.generate(result) + "\n")
            gzip&.flush(Zlib::SYNC_FLUSH)
            break unless result[:more]

            result = @manager.codex_frames(id, result[:cursor], finish: result[:finish])
          end
        ensure
          gzip&.finish
        end
      when ['GET', 'frames']
        res['Content-Type'] = 'application/json'
        res.body = JSON.generate(@manager.codex_frames(id, Integer(req.query.fetch('cursor', '0'), 10)))
      when ['POST', 'input']
        raise ArgumentError, 'terminal input is too large' if req.body.to_s.bytesize > 32_768

        @manager.codex_input(id, JSON.parse(req.body.to_s))
        res['Content-Type'] = 'application/json'
        res.body = '{"ok":true}'
      when ['POST', 'rebuild']
        @manager.set_codex_rebuild(id, rebuild: req.query['rebuild'] == '1')
        redirect(res, "/codex/#{id}")
      when ['POST', 'stop']
        @manager.stop_codex(id)
        redirect(res, '/')
      else
        not_found(res)
      end
    elsif method == 'GET' && req.path == '/codex-terminal.js'
      res['Content-Type'] = 'text/javascript'
      res.body = CODEX_TERMINAL_JS
    else
      return false
    end
    true
  rescue JSON::ParserError
    raise ArgumentError, 'invalid terminal request'
  end

