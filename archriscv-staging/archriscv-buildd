    return '' if @read_only || build.status != 'failed'

    session = codex_entries.find { |entry| entry.build_id == build.id && entry.active? }
    if session
      return %(<a class="button is-small is-link" href="#{h(dashboard_path("codex/#{session.id}"))}">Open Codex</a>)
    end
    latest = build_history.last.key?(build.id) if latest.nil?
    return '' unless latest
    return '' if codex_entries.any? { |entry| entry.pkgbase == build.pkgbase && entry.active? }
    return '' if @manager.deferred_retries.any? { |entry| entry['build']['pkgbase'] == build.pkgbase }

    <<~HTML
      <form class="inline" action="#{h(dashboard_path("builds/#{build.id}/codex"))}" method="post">
        <button class="button is-small is-link" type="submit">Spawn Codex</button>
        <label class="checkbox"><input type="checkbox" name="skip_rebuild" value="1"> Skip rebuild on exit</label>
      </form>
    HTML
  end

  def codex_panel
    current, recent = codex_entries.partition do |entry|
      entry.active? || (entry.status == 'exited' && entry.rebuild && !entry.rebuild_id)
    end
    recent = recent.first(10)
    return '' if current.empty? && recent.empty?

    <<~HTML
      <section class="codex-panel" aria-labelledby="codex-heading" data-status-url="#{h(dashboard_path('codex/status'))}">
        <h2 id="codex-heading">Codex <span class="section-count">#{current.count(&:active?)} active</span></h2>
        #{%(<div class="codex-session-list codex-active" tabindex="0" aria-label="Active Codex sessions and pending rebuilds">#{current.map { |entry| codex_session_link(entry) }.join}</div>) unless current.empty?}
        #{unless recent.empty?
            %(<details class="codex-history"><summary>Recent sessions (#{recent.size})</summary><div class="codex-session-list" tabindex="0" aria-label="Recent Codex sessions">#{recent.map { |entry| codex_session_link(entry) }.join}</div></details>)
          end}
      </section>
      <script>
        (() => {
          const panel = document.querySelector('.codex-panel');
          async function refreshCodexStatus() {
            try {
              const response = await fetch(panel.dataset.statusUrl, {
                credentials: 'same-origin', cache: 'no-store', signal: AbortSignal.timeout(10000)
              });
              if (response.status === 403) return;
              if (response.ok) {
                let active = 0;
                for (const entry of await response.json()) {
                  const badge = document.getElementById(`codex-status-${entry.id}`);
                  if (!badge) continue;
                  badge.textContent = entry.label;
                  badge.className = `tag ${entry.css}`;
                  if (entry.active) active++;
                }
                panel.querySelector('.section-count').textContent = `${active} active`;
              }
            } catch (_) { /* Keep the last known labels during connection failures. */ }
            setTimeout(refreshCodexStatus, 5000);
          }
          setTimeout(refreshCodexStatus, 5000);
        })();
      </script>
    HTML
  end

  def codex_session_link(entry)
    status = status_tag(codex_session_status(entry), id: "codex-status-#{entry.id}")
    %(<a class="codex-session" href="#{h(dashboard_path("codex/#{entry.id}"))}" title="#{h("#{entry.pkgbase} · #{entry.created_at}")}"><span class="codex-package">#{h(entry.pkgbase)}</span>#{status}</a>)
  end

  def codex_session_status(entry)
    return 'rebuild_pending' if entry.status == 'exited' && entry.rebuild && !entry.rebuild_id

    entry.activity || entry.status
  end

  def show_codex(res, id)
    session = codex_entries.find { |entry| entry.id == id }
    return not_found(res) unless session

    html(res, layout("Codex #{session.pkgbase}", <<~HTML))
      <div class="codex-page">
        <section class="box codex-heading">
          <div class="codex-toolbar">
