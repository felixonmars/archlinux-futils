# Ignore repeated absolute cursor/style-only redraws during replay. These cannot
# change screen contents. Keep text, relative movement, erases, and terminal
# strings intact, and never optimize through an unfinished escape sequence.
# Historical window titles are unused: activity comes from the live status API.
class CodexReplay
  IDLE = /\e\[\?2026h(?:\e\[[0-9;]*[Hm]|\e\[\?25[hl])+\e\[\?2026l/n
  TOKEN = /\e\][^\a]*?(?:\a|\e\\)|\e[PX^_].*?\e\\|\e\[[0-?]*[ -\/]*[@-~]|\e(?![\[\]PX^_])[ -\/]*[0-~]|[^\e]+/mn

  def initialize
    @tail = ''.b
    @previous = nil
  end

  def compact(data)
    return data unless @tail

    prefix = @tail.bytesize
    scanner = StringScanner.new(@tail + data)
    output = ''.b
    until scanner.eos?
      start = scanner.pos
      idle = scanner.scan(IDLE)
      token = idle || scanner.scan(TOKEN)
      unless token
        @tail = scanner.rest
        # An unusually large unfinished string is passed through unchanged.
        @tail = nil if @tail.bytesize > 65_536
        output << scanner.rest.byteslice([prefix - start, 0].max..).to_s
        return output
      end
      title = token.match?(/\A\e\](?:0|2);[^\e\a\x18\x1a]*(?:\a|\e\\)\z/n)
      redundant = start >= prefix && (title || (idle && idle == @previous))
      if idle
        @previous = idle
      elsif !title
        @previous = nil
      end
      output << token.byteslice([prefix - start, 0].max..).to_s unless redundant
    end
    @tail = ''.b
    output
  end

  def resize
    @previous = nil
  end
end

class SystemdCodexService < SystemdBuildService
  def start(session, directory)
    output, status = Open3.capture2e(
      'systemd-run', '--quiet', '--collect', '--service-type=exec',
      "--unit=#{session.unit_name}", "--description=Codex #{session.pkgbase}",
      "--property=User=#{Process.uid}", "--property=Group=#{Process.gid}",
      '--property=KillMode=control-group', '--property=TimeoutStopSec=10s', '--property=UMask=0077',
