# The independent worker owns the PTY. HTTP requests only bridge its private
# socket and output file, so browser disconnects and scheduler restarts are safe.
class CodexWorker < BuildWorker
  def initialize(directory)
    @directory = directory
    @request = JSON.parse(File.read(File.join(directory, 'request.json')))
    @stopping = false
    @result = {'status' => 'queued'}
  end

  def run
    File.open(File.join(@directory, 'lock'), 'w', 0o600) do |lock|
      raise 'Codex worker is already running' unless lock.flock(File::LOCK_EX | File::LOCK_NB)
      return 0 if File.exist?(status_path)

      run_terminal
    end
    @result['exit_status'] || 1
  end

  private

  def persist
    write_json(status_path, @result)
  end

  def run_terminal
    handlers = %w[INT TERM].to_h { |signal| [signal, trap(signal) { @stopping = true }] }
    @server = UNIXServer.new(File.join(@directory, 'terminal.sock'))
    @output = File.open(File.join(@directory, 'output'), 'ab', 0o600)
    @output.sync = true
    @frames = File.open(File.join(@directory, 'frames'), 'ab', 0o600)
    @frames.sync = true
    persist
    # Codex asks the terminal for its cursor position during startup. Wait for
    # a browser to attach so that request has a terminal ready to answer it.
    until @size || @stopping
      receive_input if IO.select([@server], nil, nil, 0.1)
    end
    return if @stopping

    @reader, @writer, @pid = PTY.spawn(@request.fetch('environment').merge('TERM' => 'xterm-256color'),
      *@request.fetch('argv'), chdir: @request.fetch('workdir'), unsetenv_others: true)
    @reader.winsize = @size
    @writer.sync = true
    @result['status'] = 'running'
    persist
    eof = false
    until @wait_status || @stopping
      ready = IO.select(eof ? [@server] : [@reader, @server], nil, nil, 0.1)&.first || []
      eof = !read_output if ready.include?(@reader)
      receive_input if ready.include?(@server)
      _, @wait_status = Process.wait2(@pid, Process::WNOHANG)
    end
    eof = !read_output while !eof && IO.select([@reader], nil, nil, 0)
  rescue StandardError => e
    @result['note'] = "#{e.class}: #{e.message}"
  ensure
    reap_child
    [@reader, @writer, @server, @output, @frames].compact.each { |io| io.close unless io.closed? }
    @result['exit_status'] = @wait_status&.exitstatus || (@wait_status&.termsig && 128 + @wait_status.termsig)
    @result['status'] = @stopping ? 'stopped' : (@wait_status && !@result['note'] ? 'exited' : 'failed')
    @result['finished_at'] = Time.now.utc.iso8601
    persist
    handlers&.each { |signal, handler| trap(signal, handler) }
  end

  def read_output
    chunk = @reader.read_nonblock(65_536, exception: false)
    return false unless chunk
    return true if chunk == :wait_readable

    @output.write(chunk)
    @frames.puts(JSON.generate(offset: @output.pos, bytes: chunk.bytesize))
    true
  rescue EOFError, Errno::EIO
    false
  end

  def receive_input
    client = @server.accept
    Timeout.timeout(2) do
      message = JSON.parse(client.gets(65_537).to_s)
      case message.fetch('action')
      when 'input'
        raise ArgumentError, 'terminal has not started' unless @writer

        @writer.write(message.fetch('data').unpack1('m0'))
      when 'resize'
        size = [message.fetch('rows'), message.fetch('cols')]
        unless size == @size
          # Commit queued output before the new geometry, then record the resize
          # before SIGWINCH can make the application draw at the new dimensions.
          while @reader && IO.select([@reader], nil, nil, 0)
            break unless read_output
          end
          @size = size
          @frames.puts(JSON.generate(cols: size[1], rows: size[0]))
          @reader.winsize = size if @reader
        end
      else
        raise ArgumentError, 'unknown terminal action'
      end
      client.puts(JSON.generate(ok: true))
    end
  rescue StandardError => e
    client&.puts(JSON.generate(error: e.message)) rescue nil
  ensure
    client&.close
  end
end

class BuildManager
  def initialize(service: SystemdBuildService.new, codex_service: SystemdCodexService.new)
    @service = service
    @codex_service = codex_service
    @mutex = Mutex.new
    @overlay_mutex = Mutex.new
    @builds = {}
    @refresh_pending = []
    @deferred_retries = []
    @codex_sessions = {}
    @shutting_down = false

    FileUtils.mkdir_p([STATE_DIR, LOG_DIR, WORKER_DIR])
    load_state
  end

  def start
    @mutex.synchronize do
      @builds.values.select { |build| build.status == 'queued' }.each do |build|
        unless build.unit_name
          prepare_worker(build)
          persist_locked
        end
        launch_worker(build) unless File.exist?(worker_status_path(build)) || @service.active?(build)
      end
      refresh_workers_locked(check_units: true)
      @codex_sessions.values.select { |session| session.status == 'queued' }.each do |session|
        launch_codex(session) unless File.exist?(codex_status_path(session)) || @codex_service.active?(session)
      end
      refresh_codex_locked(check_units: true)
    end
    @monitor = Thread.new do
      tick = 0
      loop do
        sleep 1
        break if @shutting_down

        @mutex.synchronize do
          refresh_workers_locked(check_units: (tick % 10).zero?)
          refresh_codex_locked(check_units: (tick % 10).zero?)
        end
        tick += 1
      rescue StandardError => e
        warn "#{APP_NAME}: worker monitor: #{e.message}"
      end
    end
  end

  def all_builds
    @mutex.synchronize do
      refresh_workers_locked
      @builds.values.sort_by(&:created_at).reverse
    end
  end

  def find(id)
    @mutex.synchronize do
      refresh_workers_locked
      @builds[id]
    end
  end

  def refresh_pending
    @mutex.synchronize { @refresh_pending.dup }
  end

  def enqueue(command_line, target_builder: nil, ignore_active_id: nil, new_builder: false, environment: {})
    environment = environment.reject { |key, _| key == 'SERVER' } if new_builder
    build = new_build(command_line, target_builder: new_builder ? nil : target_builder, environment: environment)

    @mutex.synchronize do
      refresh_workers_locked
      check_duplicate_locked(build.pkgbase, ignore_active_id: ignore_active_id)

      clear_builder_cache(build.pkgbase) if new_builder
      @builds[build.id] = build
      prepare_worker(build, new_builder: new_builder)
      persist_locked
      launch_worker(build)
    end
    build
  rescue ArgumentError
    raise
  rescue StandardError => e
    raise ArgumentError, e.message
  end

  def refresh_from_remote(extra_safe_deps: nil)
    argv = Shellwords.split(REFRESH_COMMAND)
    extra_safe_deps = extra_safe_deps.to_s.strip
    argv << "--extra-safe-deps=#{extra_safe_deps}" unless extra_safe_deps.empty?
    output, status = Open3.capture2e(*argv)
    raise ArgumentError, "#{REFRESH_COMMAND} failed: #{output.lines.last.to_s.strip}" unless status.success?

    candidates = output.lines.map(&:strip).select { |line| line.match?(COMMAND_PATTERN) }.uniq
    added = []
    @mutex.synchronize do
      added = candidates.reject { |pkgbase| @refresh_pending.include?(pkgbase) }
      @refresh_pending.concat(added)
      persist_locked if added.any?
    end
    added
  end

  def enqueue_refresh(pkgbases)
    queued = []
    errors = []
    selected = Array(pkgbases).map(&:to_s).map(&:strip).uniq.select do |pkgbase|
      pkgbase.match?(COMMAND_PATTERN) && @mutex.synchronize { @refresh_pending.include?(pkgbase) }
    end

    unless selected.empty?
      output = `pacman -Sy 2>&1`
      raise ArgumentError, "pacman -Sy failed: #{output.lines.last.to_s.strip}" unless $?.success?
    end

    selected.each do |pkgbase|
      begin
        build = enqueue(pkgbase)
        queued << build
        @mutex.synchronize do
          @refresh_pending.delete(pkgbase)
          persist_locked
        end
      rescue ArgumentError => e
        errors << "#{pkgbase}: #{e.message}"
      end
    end

    [queued, errors]
  end

  def clear_refresh(pkgbases)
    selected = Array(pkgbases).map(&:to_s).map(&:strip)
    @mutex.synchronize do
      selected = @refresh_pending if selected.empty?
      before = @refresh_pending.size
      @refresh_pending -= selected
      persist_locked if @refresh_pending.size != before
      before - @refresh_pending.size
    end
  end

  def answer_upload(id, upload:)
    decision = upload ? 'upload' : 'skip'
    @mutex.synchronize do
      refresh_workers_locked
      build = @builds[id] || raise(ArgumentError, 'unknown build')
      raise ArgumentError, 'build is not waiting for an upload decision' unless build.status == 'waiting_upload'

      save_upload_decision(build, decision)
    end

    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 5
    loop do
      build = find(id)
      return if !build || build.upload_decision == decision
      raise ArgumentError, 'build finished before accepting the upload decision' if build.terminal?
      break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

      sleep 0.05
    end
    raise ArgumentError, 'upload decision saved; the build worker has not acknowledged it yet'
  end

  def mark_memory_killer(id)
    @mutex.synchronize do
      refresh_workers_locked
      build = @builds[id] || raise(ArgumentError, 'unknown build')
      raise ArgumentError, 'build is not waiting for an upload decision' unless build.status == 'waiting_upload'

      FileUtils.mkdir_p(File.dirname(MEMORY_KILLER_LIST))
      File.open(MEMORY_KILLER_LIST, 'a+') do |file|
        file.flock(File::LOCK_EX)
        contents = file.read
        packages = contents.lines.map { |line| line.split('#', 2).first.to_s.strip }
        unless packages.include?(build.pkgbase)
          file.write("\n") unless contents.empty? || contents.end_with?("\n")
          file.puts(build.pkgbase)
        end
      end
      clear_builder_cache(build.pkgbase)
      build.pkgbase
    end
  rescue SystemCallError => e
    raise ArgumentError, e.message
  end

  def defer_build(id, wait_for:)
    wait_for = wait_for.to_s.strip
    unless wait_for.match?(COMMAND_PATTERN) && !wait_for.end_with?(':nocheck')
      raise ArgumentError, 'enter the package base to wait for'
    end

    @mutex.synchronize do
      refresh_workers_locked
      source = @builds[id] || raise(ArgumentError, 'unknown build')
      raise ArgumentError, 'build is not waiting for an upload decision' unless source.status == 'waiting_upload'
      raise ArgumentError, 'a build cannot wait for itself' if wait_for == source.pkgbase

      check_duplicate_locked(source.pkgbase, ignore_active_id: id)
      path = File.join(worker_directory(source), 'upload.json')
      raise ArgumentError, 'an upload decision has already been submitted' if File.exist?(path)

      build = new_build(source.command_line, target_builder: source.target_builder, environment: source.environment)
      @deferred_retries << {'build' => build.to_h, 'source_id' => id, 'wait_for' => wait_for, 'ready' => false}
      # Save the retry before skipping; the monitor can resend a skip after a crash.
      persist_locked
      save_upload_decision(source, 'skip')
      build
    end
  end

  def overlay_branch_exists?(pkgbase)
    _, status = Open3.capture2e('git', 'show-ref', '--verify', '--quiet', "refs/heads/#{pkgbase}", chdir: OVERLAY_REPO)
    status.success?
  rescue SystemCallError
    false
  end

  def overlay_branches
    output, status = Open3.capture2e('git', 'for-each-ref', '--format=%(refname:strip=2)', 'refs/heads/', chdir: OVERLAY_REPO)
    status.success? ? output.lines(chomp: true).to_h { |name| [name, true] } : {}
  rescue SystemCallError
    {}
  end

  def push_branch(id)
    @overlay_mutex.synchronize do
      pkgbase = @mutex.synchronize do
        refresh_workers_locked
        build = @builds[id] || raise(ArgumentError, 'unknown build')
        unless build.can_push_branch?
          raise ArgumentError, 'only succeeded builds with Switch overlay branch enabled can push a branch'
        end

        name = build.pkgbase || build.command_line.sub(/:nocheck\z/, '')
        unless name.match?(COMMAND_PATTERN) && !name.end_with?(':nocheck') && name != 'master'
          raise ArgumentError, 'invalid package overlay branch'
        end
        check_duplicate_locked(name)
        name
      end

      current_branch = overlay_git('branch', '--show-current').strip
      overlay_git('switch', 'master') if current_branch == pkgbase
      overlay_git('pushbranch', pkgbase)
      pkgbase
    end
  rescue SystemCallError => e
    raise ArgumentError, e.message
  end

  def deferred_retries
    @mutex.synchronize { @deferred_retries.map(&:dup) }
  end

  def cancel_deferred(id)
    @mutex.synchronize do
      entry = @deferred_retries.find { |pending| pending['build']['id'] == id }
      raise ArgumentError, 'unknown deferred build' unless entry

      @deferred_retries.delete(entry)
      persist_locked
    end
  end

  def stop_build(id)
    build = @mutex.synchronize do
      refresh_workers_locked
      current = @builds[id] || raise(ArgumentError, 'unknown build')
      raise ArgumentError, 'build is not active' unless current.active?

      # Keep Kill available even if accessing the terminal fails.
      current.stop_requested = true
      persist_locked
      current
    end

    @service.interrupt(build)
  rescue StandardError => e
    raise ArgumentError, e.message
  end

  def kill_build(id)
    build = find(id) || raise(ArgumentError, 'unknown build')
    raise ArgumentError, 'build is not active' unless build.active?
    raise ArgumentError, 'stop the build before killing it' unless build.stop_requested

    @service.stop(build)
    @mutex.synchronize { refresh_workers_locked(check_units: true) }
  rescue StandardError => e
    raise ArgumentError, e.message
  end

  def delete_build(id)
    @mutex.synchronize do
      refresh_workers_locked
      build = @builds[id] || raise(ArgumentError, 'unknown build')
      raise ArgumentError, 'cannot delete an active build' if build.active?
      if @codex_sessions.values.any? { |session| session.build_id == id && session.active? }
        raise ArgumentError, 'cannot delete a build while its Codex session is active'
      end

      @builds.delete(id)
      persist_locked
      remove_build_files(build)
    end
  end

  def shutdown
    @shutting_down = true
    @monitor&.join
  end

  def shutting_down?
    @shutting_down
  end

  def codex_sessions
    sessions = @mutex.synchronize do
      refresh_codex_locked
      @codex_sessions.values.map { |session| CodexSession.from_h(session.to_h) }.reverse
    end
    sessions.each { |session| session.activity = codex_activity(session) if session.status == 'running' }
  end

  def spawn_codex(id, rebuild: true)
    @mutex.synchronize do
      refresh_workers_locked
      refresh_codex_locked
      build = @builds[id] || raise(ArgumentError, 'unknown build')
      unless build.status == 'failed' && build_history_for(@builds.values).last.key?(id)
        raise ArgumentError, 'Codex can only start on the latest failed build for a package'
      end
      check_duplicate_locked(build.pkgbase)
      session_id = SecureRandom.hex(12)
      session = CodexSession.new(id: session_id, build_id: id, pkgbase: build.pkgbase,
        unit_name: "#{APP_NAME}-codex-#{session_id}.service", status: 'queued', rebuild: rebuild,
        build: build.to_h, created_at: Time.now.utc.iso8601)
      directory = codex_directory(session)
      FileUtils.mkdir_p(directory, mode: 0o700)
      environment = ENV.to_h.reject do |key, _|
        key.start_with?('ARCHRISCV_BUILDD_GITHUB_') ||
          %w[NOTIFY_SOCKET WATCHDOG_PID WATCHDOG_USEC INVOCATION_ID JOURNAL_STREAM SYSTEMD_EXEC_PID].include?(key)
      end
      prompt = <<~PROMPT
        $rv #{build.pkgbase}
        Build log: #{build.log_path}
      PROMPT
      write_json(File.join(directory, 'request.json'),
        'argv' => ['codex', '--no-daemon', '--no-alt-screen', '-c', 'tui.terminal_title=["spinner","project"]', prompt],
        'workdir' => OVERLAY_REPO, 'environment' => environment)
      @codex_sessions[session.id] = session
      persist_locked
      launch_codex(session)
      session
    end
  rescue SystemCallError => e
    raise ArgumentError, e.message
  end

  def set_codex_rebuild(id, rebuild:)
    @mutex.synchronize do
      session = @codex_sessions[id] || raise(ArgumentError, 'unknown Codex session')
      raise ArgumentError, 'Codex has already exited' unless session.active?

      session.rebuild = rebuild
      persist_locked
    end
  end

  def stop_codex(id)
    session = @mutex.synchronize do
      current = @codex_sessions[id] || raise(ArgumentError, 'unknown Codex session')
      raise ArgumentError, 'Codex has already exited' unless current.active?

      current.rebuild = false
      persist_locked
      current
    end
    @codex_service.stop(session)
    @mutex.synchronize { refresh_codex_locked(check_units: true) }
  rescue StandardError => e
    raise ArgumentError, e.message
  end

  def codex_output(id, offset)
    session = codex_sessions.find { |entry| entry.id == id } || raise(ArgumentError, 'unknown Codex session')
    path = File.join(codex_directory(session), 'output')
    data = ''.b
    if File.exist?(path)
      File.open(path, 'rb') do |file|
        raise ArgumentError, 'invalid terminal offset' unless offset.between?(0, file.size)

        file.seek(offset)
        data = file.read(65_536).to_s
      end
    elsif offset != 0
      raise ArgumentError, 'invalid terminal offset'
    end
    codex_state(session).merge(data: [data].pack('m0'), offset: offset + data.bytesize)
  end

  def codex_frames(id, cursor, finish: nil)
    session = codex_sessions.find { |entry| entry.id == id } || raise(ArgumentError, 'unknown Codex session')
    directory = codex_directory(session)
    output = File.join(directory, 'output')
    journal = File.join(directory, 'frames')
    legacy = !File.exist?(journal)
    size = File.size?(legacy ? output : journal) || 0
    finish ||= size
    unless cursor.between?(0, finish) && finish.between?(0, size)
      raise ArgumentError, 'invalid terminal cursor'
    end
    if legacy
      data = size.positive? ? File.binread(output, [131_072, finish - cursor].min, cursor) : ''.b
      cursor += data.bytesize
      return codex_state(session).merge(events: [{'data' => [data].pack('m0')}], cursor: cursor,
        finish: finish, more: cursor < finish, legacy: true)
    end

    events = []
    total = 0
    more = false
    File.open(journal, 'rb') do |frames|
      frames.seek(cursor)
      # Bound both index scanning and output bytes. Coalesce tiny spinner writes
      # without crossing resizes, avoiding one browser write/timer per PTY frame.
      lines = frames.read([131_072, finish - cursor].min).to_s
      more = frames.pos < finish
      lines.each_line do |line|
        break unless line.end_with?("\n")

        frame = JSON.parse(line)
        if total + frame.fetch('bytes', 0) > 131_072 || events.size >= 256
          more = true
          break
        end
        if frame['bytes'] && events.last&.fetch('offset', nil) == frame['offset'] - frame['bytes']
          events.last['bytes'] += frame['bytes']
          events.last['offset'] = frame['offset']
        else
          events << frame
        end
        total += frame.fetch('bytes', 0)
        cursor += line.bytesize
      end
    end
    events.map! do |frame|
      next frame unless frame['bytes']

      data = File.binread(output, frame['bytes'], frame['offset'] - frame['bytes'])
      {'data' => [data].pack('m0')}
    end
    codex_state(session).merge(events: events, cursor: cursor, finish: finish, more: more, legacy: false)
  end

  def codex_input(id, message)
    raise ArgumentError, 'invalid terminal request' unless message.is_a?(Hash)

    session = @mutex.synchronize { @codex_sessions[id] }
    raise ArgumentError, 'Codex is not running' unless session&.active?

    case message['action']
    when 'input'
      raise ArgumentError, 'invalid terminal input' unless message['data'].is_a?(String)

      data = message.fetch('data').unpack1('m0')
      raise ArgumentError, 'terminal input is too large' if data.bytesize > 16_384
    when 'resize'
      unless message['rows'].is_a?(Integer) && message['rows'].between?(2, 200) &&
             message['cols'].is_a?(Integer) && message['cols'].between?(10, 500)
        raise ArgumentError, 'invalid terminal size'
      end
    else
      raise ArgumentError, 'unknown terminal action'
    end
    Timeout.timeout(3) do
      UNIXSocket.open(File.join(codex_directory(session), 'terminal.sock')) do |socket|
        socket.puts(JSON.generate(message))
        result = JSON.parse(socket.gets.to_s)
        raise ArgumentError, result['error'] unless result['ok']
      end
    end
  rescue SystemCallError, Timeout::Error, JSON::ParserError, KeyError => e
    raise ArgumentError, "Codex terminal is unavailable: #{e.message}"
  end

  private

  def new_build(command_line, target_builder: nil, environment: {})
    command_line = command_line.to_s.strip
    raise ArgumentError, 'enter a package name, optionally ending with :nocheck' unless command_line.match?(COMMAND_PATTERN)

    target_builder = target_builder.to_s.strip
    if !target_builder.empty? && !target_builder.include?('@') && !BUILDER_USER.empty?
      target_builder = "#{BUILDER_USER}@#{target_builder}"
    end
    unless target_builder.empty? || target_builder.match?(TARGET_BUILDER_PATTERN)
      raise ArgumentError, 'enter a target builder as host or user@host, or leave it blank for automatic selection'
    end
    target_builder = nil if target_builder.empty?

    unless environment.is_a?(Hash) && environment.all? { |key, value| %w[NOUPLOAD SERVER KEEPCHROOT SWITCHBRANCH].include?(key) && value.is_a?(String) && !value.include?("\0") }
      raise ArgumentError, 'only NOUPLOAD, SERVER, KEEPCHROOT and SWITCHBRANCH environment overrides are supported'
    end
    server = environment['SERVER']
    unless server.nil? || server.empty? || server.match?(TARGET_BUILDER_PATTERN)
      raise ArgumentError, 'SERVER must be a host or user@host'
    end

    pkgbase = command_line.sub(/:nocheck\z/, '')
    id = "#{Time.now.utc.strftime('%Y%m%d%H%M%S')}-#{format('%06x', Random.rand(0x1000000))}"
    Build.new(
      id: id, command_line: command_line, argv: [BUILD_COMMAND, command_line],
      pkgbase: pkgbase, target_builder: target_builder, environment: environment.dup,
      log_path: File.expand_path(File.join(LOG_DIR, "#{id}-#{safe_filename(pkgbase)}.log"))
    )
  end

  def check_duplicate_locked(pkgbase, ignore_active_id: nil)
    if @codex_sessions.values.any? { |session| session.pkgbase == pkgbase && session.active? }
      raise ArgumentError, "#{pkgbase} already has an active Codex session"
    end
    if @deferred_retries.any? { |entry| entry['build']['pkgbase'] == pkgbase }
      raise ArgumentError, "#{pkgbase} already has a deferred retry"
    end
    if @builds.values.any? { |build| build.id != ignore_active_id && build.active? && build.pkgbase == pkgbase }
      raise ArgumentError, "#{pkgbase} is already queued or building"
    end
  end

  def save_upload_decision(build, decision)
    path = File.join(worker_directory(build), 'upload.json')
    if File.exist?(path)
      raise ArgumentError, 'an upload decision has already been submitted' if JSON.parse(File.read(path))['decision'] != decision

      return
    end
    write_json(path, 'decision' => decision)
  end

  def load_state
    return unless File.exist?(STATE_FILE)

    changed = false
    data = JSON.parse(File.read(STATE_FILE))
    data.fetch('builds', []).each do |entry|
      build = Build.from_h(entry)
      if !build.unit_name && %w[running waiting_upload].include?(build.status)
        build.status = 'interrupted'
        build.finished_at ||= Time.now.utc
        build.note = 'daemon restarted while this build was active'
        changed = true
      end
      @builds[build.id] = build
    end
    @refresh_pending = data.fetch('refresh_pending', []).select { |pkgbase| pkgbase.to_s.match?(COMMAND_PATTERN) }
    @deferred_retries = data.fetch('deferred_retries', [])
    @codex_sessions = data.fetch('codex_sessions', []).to_h do |entry|
      session = CodexSession.from_h(entry)
      [session.id, session]
    end
    persist_locked if changed
  rescue JSON::ParserError => e
    warn "#{APP_NAME}: ignoring unreadable state file: #{e.message}"
  end

  def persist_locked
    FileUtils.mkdir_p(STATE_DIR)
    write_json(STATE_FILE,
      'builds' => @builds.values.sort_by(&:created_at).map(&:to_h),
      'refresh_pending' => @refresh_pending,
      'deferred_retries' => @deferred_retries,
      'codex_sessions' => @codex_sessions.values.map(&:to_h)
    )
  end

  def worker_directory(build)
    File.join(WORKER_DIR, build.id)
  end

  def worker_status_path(build)
    File.join(worker_directory(build), 'status.json')
  end

  def clear_builder_cache(pkgbase)
    File.unlink(File.join(BUILDER_CACHE_DIR, "#{pkgbase}-riscv64"))
  rescue Errno::ENOENT
    nil
  end

  def overlay_git(*args)
    output, status = Open3.capture2e('git', *args, chdir: OVERLAY_REPO)
    raise ArgumentError, "git #{args.join(' ')} failed: #{output.strip}" unless status.success?

    output
  end

  def prepare_worker(build, new_builder: false)
    build.unit_name = "#{APP_NAME}-build-#{build.id}.service"
    build.log_path = File.expand_path(build.log_path)
    directory = worker_directory(build)
    FileUtils.mkdir_p(directory, mode: 0o700)
    # Preserve the build environment without forwarding the web service's systemd identity.
    environment = ENV.to_h.reject do |key, _|
      %w[NOTIFY_SOCKET WATCHDOG_PID WATCHDOG_USEC INVOCATION_ID JOURNAL_STREAM SYSTEMD_EXEC_PID].include?(key)
    end
    # These options are selected per build through the client or UI.
    environment.delete('KEEPCHROOT')
    environment.delete('SWITCHBRANCH')
    environment.merge!(build.environment)
    # SERVER overrides the selector even when the package's cache was cleared.
    environment.delete('SERVER') if new_builder
    write_json(File.join(directory, 'request.json'),
      'build' => build.to_h,
      'environment' => environment,
      'workdir' => BUILD_WORKDIR.to_s.empty? ? Dir.pwd : File.expand_path(BUILD_WORKDIR)
    )
  end

  def launch_worker(build)
    @service.start(build, worker_directory(build))
  rescue StandardError => e
    build.status = 'failed'
    build.finished_at = Time.now.utc
    build.note = e.message
    persist_locked
    warn "#{APP_NAME}: build #{build.id}: #{e.message}"
  end

  def worker_status(build)
    path = worker_status_path(build)
    current = File.exist?(path) ? Build.from_h(JSON.parse(File.read(path))) : build

    # This flag belongs to the dashboard; worker snapshots do not set it.
    current.stop_requested ||= build.stop_requested

    # Older workers only record entering waiting_upload through the snapshot's mtime.
    current.upload_prompt_at ||= build.upload_prompt_at
    if current.status == 'waiting_upload' && !current.upload_prompt_at && File.exist?(path)
      current.upload_prompt_at = File.mtime(path).utc
    end

    # Older workers may have missed the host announcement before an ANSI-parser fix.
    current.build_host ||= build.build_host
    current.package_version ||= build.package_version
    unless current.build_host && current.package_version
      log, = read_log(current.log_path, 0, 65_536)
      current.build_host ||= log.gsub(ANSI_PATTERN, '').match(HOST_PATTERN)&.[](1)
      current.read_package_version(log)
    end
    current
  end

  def refresh_workers_locked(check_units: false)
    changed = false
    removed = []
    succeeded = []
    @builds.values.select { |build| build.unit_name && (build.active? || build.discard_after_finish) }.each do |build|
      before = build.to_h
      current = worker_status(build)
      if check_units && current.active? && !@service.active?(current)
        # The worker can finish between reading its status and querying systemd.
        current = worker_status(current)
        if current.active?
          current.status = 'interrupted'
          current.finished_at ||= Time.now.utc
          current.note = 'build worker exited without recording a result'
        end
      end
      succeeded << current.pkgbase if current.status == 'succeeded' && build.status != 'succeeded'
      if current.terminal? && current.discard_after_finish
        @builds.delete(build.id)
        changed = true
        removed << current
      elsif current.to_h != before
        @builds[build.id] = current
        changed = true
      end
    end
    launches = []
    @deferred_retries.dup.each do |entry|
      if !entry['ready'] && succeeded.include?(entry['wait_for'])
        entry['ready'] = true
        changed = true
      end
      source = @builds[entry['source_id']]
      save_upload_decision(source, 'skip') if source&.status == 'waiting_upload'
      next unless entry['ready']
      next if @builds.values.any? { |build| build.active? && build.pkgbase == entry['build']['pkgbase'] }

      build = Build.from_h(entry['build'])
      prepare_worker(build)
      @builds[build.id] = build
      @deferred_retries.delete(entry)
      launches << build
      changed = true
    end
    # Persist successful prerequisites and queued retries together before launching.
    persist_locked if changed
    removed.each { |build| remove_build_files(build) }
    launches.each { |build| launch_worker(build) }
  end

  def remove_build_files(build)
    FileUtils.rm_f(build.log_path)
    FileUtils.rm_rf(worker_directory(build)) if build.unit_name
  end

  def codex_activity(session)
    # Codex's native title spinner reflects activity, including quiet tool calls.
    # Read a bounded tail so old workers also work without restarts or TUI replay.
    data = File.open(File.join(codex_directory(session), 'output'), 'rb') do |file|
      file.seek([file.size - 65_536, 0].max)
      file.read(65_536)
    end
    title = data.to_s.scan(/\e\](?:0|2);([^\a\e]*)(?:\a|\e\\)/n).last&.first
    return unless title

    title.force_encoding(Encoding::UTF_8).scrub.match?(/\A[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏](?:\s|\z)/) ? 'working' : 'waiting_for_input'
  rescue Errno::ENOENT
    nil
  end

  def codex_state(session)
    {status: session.status, ready: File.exist?(codex_status_path(session)), rebuild: session.rebuild,
     rebuild_id: session.rebuild_id, note: session.note, exit_status: session.exit_status, activity: session.activity}
  end

  def codex_directory(session)
    File.expand_path(File.join(STATE_DIR, 'codex', session.id))
  end

  def codex_status_path(session)
    File.join(codex_directory(session), 'status.json')
  end

  def launch_codex(session)
    @codex_service.start(session, codex_directory(session))
  rescue StandardError => e
    session.status = 'failed'
    session.note = e.message
    session.finished_at = Time.now.utc.iso8601
    persist_locked
  end

  def refresh_codex_locked(check_units: false)
    changed = false
    launches = []
    @codex_sessions.each_value do |session|
      before = session.to_h
      if session.active?
        path = codex_status_path(session)
        result = File.exist?(path) ? JSON.parse(File.read(path)) : {}
        if check_units && !@codex_service.active?(session)
          # Re-read after querying systemd; the worker may have just finished.
          result = JSON.parse(File.read(path)) if File.exist?(path)
          if result.empty? || %w[queued running].include?(result['status'])
            result = {'status' => 'interrupted', 'finished_at' => Time.now.utc.iso8601,
                      'note' => 'Codex worker exited without recording a result; rebuild was not scheduled'}
          end
        end
        %w[status finished_at exit_status note].each { |key| session[key] = result[key] if result.key?(key) }
      end
      if session.status == 'exited' && session.rebuild && !session.rebuild_id
        source = session.build
        # Save the new build and its session link in one state update before
        # launching it, just as deferred retries do. Recovery cannot enqueue twice.
        begin
          check_duplicate_locked(session.pkgbase)
          build = new_build(source.fetch('command_line'), target_builder: source['target_builder'],
            environment: source.fetch('environment', {}).merge('SWITCHBRANCH' => '1'))
          prepare_worker(build)
          @builds[build.id] = build
          session.rebuild_id = build.id
          session.note = nil
          launches << build
        rescue ArgumentError => e
          session.note = "Rebuild pending: #{e.message}"
        end
      end
      changed ||= session.to_h != before
    end
    persist_locked if changed
    launches.each { |build| launch_worker(build) }
  end
end

class BuilderTags
  def initialize(path: ENV['ARCHRISCV_BUILDD_SELECTOR_PATH'])
    @path = path || ENV.fetch('PATH', '').split(File::PATH_SEPARATOR).map do |directory|
      File.join(directory, 'felixbuild-server-select')
    end.find { |candidate| File.file?(candidate) && File.executable?(candidate) }
    @mutex = Mutex.new
    @tags = {}
  end

  def for(host)
    return [] if host.to_s.empty? || !@path

    @mutex.synchronize do
      stat = File.stat(@path)
      version = [stat.ino, stat.mtime, stat.size]
      if @version != version
        @tags = parse(File.read(@path))
        @version = version
      end
      name = hostname(host)
      @tags[name] || @tags[name.split('.').first] || []
    end
  rescue SystemCallError
    []
  end

  private

  def hostname(host)
    host.to_s.split('@').last.to_s.downcase.sub(/\.\z/, '')
  end

  def parse(source)
    # Read both selector formats as data; never run its package selection logic.
    table = source[/^server_specs_text\s*=\s*<<~SPECS\s*\n(.*?)^SPECS\s*$/m, 1]
    (table || source).each_line.each_with_object({}) do |line, result|
      next if line.lstrip.start_with?('#')

      if table
        host, jobs, tags = line.strip.split(/\s*\|\s*/, 5)
        next unless jobs&.match?(/\A\d+\z/) && tags

        tags = tags.split
      else
        match = line.match(/^\s*["']([^"']+)["']\s*=>\s*\{[^\n]*?:tags\s*=>\s*\[([^\]]*)\]/)
        next unless match

        host = match[1]
        tags = match[2].scan(/["']([^"']+)["']/).flatten
      end
      result[hostname(host)] = tags
    end
  end
end

class GitHubAuth
  class Error < StandardError; end

  COOKIE = 'archriscv_buildd_session'
  SESSION_SECONDS = 7 * 86_400
  CLI_SESSION_SECONDS = 30 * 86_400

  def initialize(client_id: ENV.fetch('ARCHRISCV_BUILDD_GITHUB_CLIENT_ID', ''),
    client_secret: ENV.fetch('ARCHRISCV_BUILDD_GITHUB_CLIENT_SECRET', ''),
    public_url: ENV.fetch('ARCHRISCV_BUILDD_PUBLIC_URL', ''),
    editors: ENV.fetch('ARCHRISCV_BUILDD_GITHUB_EDITORS', ''))
    @client_id = client_id
    @client_secret = client_secret
    @public_url = public_url.delete_suffix('/')
    @editors = editors.split(/[\s,]+/).map(&:downcase).freeze
    @sessions = {}
    @cli_codes = {}
    @mutex = Mutex.new
    @base_path = ''
    @origin = ''
    return if [client_id, client_secret, public_url].all?(&:empty?)

    if (!client_id.empty? || !client_secret.empty?) && !configured?
      raise ArgumentError, 'GitHub login requires client ID, client secret, and public URL'
    end

    uri = URI(@public_url)
    unless (uri.is_a?(URI::HTTPS) || (uri.is_a?(URI::HTTP) && %w[localhost 127.0.0.1 ::1].include?(uri.hostname))) &&
      uri.host && uri.path.match?(%r{\A(?:/[A-Za-z0-9_-]+)*\z}) && !uri.userinfo && !uri.query && !uri.fragment
      raise ArgumentError, 'Public URL must use HTTPS with an optional path prefix (HTTP is allowed only on localhost)'
    end
    @base_path = uri.path
    uri.path = ''
    @origin = uri.to_s
  end

  def path(path = '')
    "#{@base_path}/#{path.delete_prefix('/')}"
  end

  def configured?
    [@client_id, @client_secret, @public_url].none?(&:empty?)
  end

  def session(req)
    @mutex.synchronize do
      entry = @sessions[cookie(req)]
      entry if entry && entry[:login] && entry[:expires_at] > Time.now.to_i
    end
  end

  def editor?(session)
    session && @editors.include?(session[:login].downcase)
  end

  def valid_csrf?(req, session)
    return false unless session
    return false if req['origin'] && req['origin'] != @origin

    equal?(session[:csrf], req['x-csrf-token'] || req.query['_csrf'])
  end

  def login(req, res)
    raise Error, 'GitHub login is not configured.' unless configured?

    state = SecureRandom.urlsafe_base64(32)
    verifier = SecureRandom.urlsafe_base64(32)
    replace_session(req, res, {state: state, verifier: verifier}, 600)
    'https://github.com/login/oauth/authorize?' + URI.encode_www_form(
      client_id: @client_id, redirect_uri: "#{@public_url}/auth/github/callback", scope: '', state: state,
      code_challenge: [OpenSSL::Digest::SHA256.digest(verifier)].pack('m0').tr('+/', '-_').delete('='),
      code_challenge_method: 'S256')
  end

  def callback(req, res)
    pending = @mutex.synchronize do
      entry = @sessions[cookie(req)]
      if entry && entry[:state] && entry[:expires_at] > Time.now.to_i && equal?(entry[:state], req.query['state'])
        @sessions.delete(cookie(req))
      end
    end
    raise Error, 'Login expired or could not be verified. Please sign in again.' unless pending
    raise Error, 'GitHub login was cancelled. Please sign in again.' if req.query['error'] || req.query['code'].to_s.empty?

    user = github_user(req.query['code'], pending[:verifier])
    unless user['id'].is_a?(Integer) && user['id'].positive? && user['login'].is_a?(String) &&
      user['login'].match?(/\A[a-zA-Z0-9][a-zA-Z0-9-]{0,38}\z/)
      raise Error, 'GitHub did not return a valid account.'
    end
    replace_session(req, res, {login: user['login'], csrf: SecureRandom.urlsafe_base64(32)}, SESSION_SECONDS)
  end

  def logout(req, res)
    @mutex.synchronize { @sessions.delete(cookie(req)) }
    set_cookie(res, '', 0)
  end

  def cli_code(req)
    @mutex.synchronize do
      owner = cookie(req)
      session = @sessions[owner]
      raise Error, 'Sign in with an approved GitHub account first.' unless editor?(session) && session[:expires_at] > Time.now.to_i

      # Keep only one outstanding code per browser session. Codes are never cookies.
      @cli_codes.delete_if { |_, entry| entry[:expires_at] <= Time.now.to_i || entry[:owner] == owner }
      code = SecureRandom.urlsafe_base64(32)
      @cli_codes[code] = {owner: owner, expires_at: Time.now.to_i + 600}
      code
    end
  end

  def exchange_cli_code(req)
    code = req.query['code']
    @mutex.synchronize do
      pending = @cli_codes.delete(code)
      session = @sessions[pending[:owner]] if pending && pending[:expires_at] > Time.now.to_i
      unless editor?(session) && session[:expires_at] > Time.now.to_i
        raise Error, 'Terminal login code expired or could not be verified. Generate a new code.'
      end

      # Give the terminal its own session so it can sign out without ending the browser session.
      token = SecureRandom.urlsafe_base64(32)
      entry = {login: session[:login], csrf: SecureRandom.urlsafe_base64(32), expires_at: Time.now.to_i + CLI_SESSION_SECONDS}.freeze
      @sessions[token] = entry
      entry.merge(cookie: "#{COOKIE}=#{token}")
    end
  end

  private

  def cookie(req)
    req.cookies.find { |item| item.name == COOKIE }&.value
  end

  def equal?(expected, actual)
    actual.is_a?(String) && expected.bytesize == actual.bytesize && OpenSSL.fixed_length_secure_compare(expected, actual)
  end

  def replace_session(req, res, values, lifetime)
    token = SecureRandom.urlsafe_base64(32)
    @mutex.synchronize do
      @sessions.delete_if { |_, entry| entry[:expires_at] <= Time.now.to_i }
      @sessions.delete(cookie(req))
      @sessions[token] = values.merge(expires_at: Time.now.to_i + lifetime).freeze
    end
    set_cookie(res, token, lifetime)
  end

  def set_cookie(res, token, lifetime)
    res['Set-Cookie'] = "#{COOKIE}=#{token}; Path=#{path}; HttpOnly; SameSite=Lax; Max-Age=#{lifetime}" +
      (@public_url.start_with?('https://') ? '; Secure' : '')
  end

  def github_user(code, verifier)
    uri = URI('https://github.com/login/oauth/access_token')
    request = Net::HTTP::Post.new(uri)
    request.set_form_data(client_id: @client_id, client_secret: @client_secret, code: code,
      redirect_uri: "#{@public_url}/auth/github/callback", code_verifier: verifier)
    token = github_json(uri, request)['access_token']
    raise Error, 'GitHub login failed. Please sign in again.' unless token.is_a?(String) && !token.empty?

    uri = URI('https://api.github.com/user')
    request = Net::HTTP::Get.new(uri)
    request['Authorization'] = "Bearer #{token}"
    github_json(uri, request)
  end

  def github_json(uri, request)
    request['Accept'] = 'application/json'
    request['User-Agent'] = APP_NAME
    response = Net::HTTP.start(uri.host, uri.port, use_ssl: true, open_timeout: 5, read_timeout: 10, write_timeout: 10) do |http|
      http.request(request)
    end
    raise Error, 'GitHub login is unavailable. Please try again.' unless response.is_a?(Net::HTTPSuccess)

    data = JSON.parse(response.body)
    raise Error, 'GitHub login returned an invalid response.' unless data.is_a?(Hash)

    data
  rescue JSON::ParserError, IOError, SystemCallError, SocketError, Timeout::Error, OpenSSL::SSL::SSLError
    raise Error, 'GitHub login is unavailable. Please try again.'
  end
end

class WebApp
  def initialize(manager, auth: GitHubAuth.new, builder_tags: BuilderTags.new)
    @manager = manager
    @auth = auth
    @read_only = true
    @session = nil
    @builder_tags = builder_tags
  end

  def call(req, res)
    # WEBrick serves requests concurrently; permissions belong to one request.
    dup.send(:serve, req, res)
  end

  private

  def serve(req, res)
    @session = @auth.session(req)
    @read_only = !@auth.editor?(@session)
    res['Cache-Control'] = 'no-store'
    res['Vary'] = 'Cookie'
    res['Referrer-Policy'] = 'same-origin'
    res['X-Frame-Options'] = 'DENY'
    case [req.request_method, req.path]
    when ['GET', '/auth/github']
      return redirect(res, @auth.login(req, res))
    when ['GET', '/auth/github/callback']
      @auth.callback(req, res)
      return redirect(res, '/')
    when ['POST', '/auth/logout']
      return forbidden(res) unless @auth.valid_csrf?(req, @session)

      @auth.logout(req, res)
      return redirect(res, '/')
    when ['POST', '/auth/cli/exchange']
      res['Content-Type'] = 'application/json; charset=utf-8'
      res.body = JSON.generate(@auth.exchange_cli_code(req))
      return
    end

    if @read_only && (!%w[GET HEAD].include?(req.request_method) || !view_path?(req.path))
      return forbidden(res)
    end
    unless %w[GET HEAD].include?(req.request_method)
      return forbidden(res) unless req.request_method == 'POST' && @auth.valid_csrf?(req, @session)
    end

    method = req.request_method == 'HEAD' ? 'GET' : req.request_method
    return if route_codex(req, res, method)

    case [method, req.path]
    when ['GET', '/']
      html(res, render_index(req))
    when ['GET', '/auth/cli']
      html(res, cli_login_page)
    when ['POST', '/auth/cli']
      html(res, cli_login_page(@auth.cli_code(req)))
    when ['GET', '/log-viewer.js']
      res['Content-Type'] = 'text/javascript; charset=utf-8'
      res['Cache-Control'] = 'no-cache'
      res.body = LOG_JS
    when ['POST', '/builds']
      create_build(req, res)
    when ['POST', '/refresh']
      refresh_remote(req, res)
    when ['POST', '/refresh/add']
      add_refresh(req, res)
    when ['POST', '/refresh/clear']
      clear_refresh(req, res)
    else
      route_build(req, res)
    end
  rescue GitHubAuth::Error => e
    html(res, layout('login failed', %(<p class="notification is-warning">#{h(e.message)} <a href="#{h(dashboard_path('auth/github'))}">Sign in with GitHub</a></p>)), status: 400)
  rescue ArgumentError => e
    html(res, render_index(req, error: e.message), status: 400)
  rescue StandardError => e
    warn "#{APP_NAME}: web: #{e.class}: #{e.message}"
    warn e.backtrace.first(5).join("\n") if ENV['ARCHRISCV_BUILDD_DEBUG']
    html(res, layout('error', %(<section class="notification is-danger"><h2 class="title is-5">Internal error</h2><p>#{h(e.message)}</p></section>)), status: 500)
  end

  def forbidden(res)
    html(res, layout('access denied', '<p class="notification is-warning">An approved GitHub account and a valid form are required. Sign in and reload the page to try again.</p>'), status: 403)
  end

  def view_path?(path)
    ['/', '/log-viewer.js', '/auth/cli'].include?(path) || path.match?(%r{\A/builds/[^/]+/(?:log|log-chunk|raw|events)\z})
  end

  def dashboard_path(path = '')
    @auth.path(path)
  end

  def builder_title(host)
    tags = @builder_tags.for(host)
    tags.empty? ? '' : %( title="#{h(tags.join(', '))}")
  end

  def route_build(req, res)
    case req.path
    when %r{\A/builds/([^/]+)/log\z}
      show_log(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/log-chunk\z}
      log_chunk(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/raw\z}
      raw_log(res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/events\z}
      stream_events(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/upload\z}
      answer_upload(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/retry\z}
      retry_build(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/defer\z}
      defer_build(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/memory-killer\z}
      mark_memory_killer(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/push-branch\z}
      push_branch(req, res, Regexp.last_match(1))
    when %r{\A/deferred/([^/]+)/cancel\z}
      cancel_deferred(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/stop\z}
      stop_build(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/kill\z}
      kill_build(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/delete\z}
      delete_build(req, res, Regexp.last_match(1))
    else
      not_found(res)
    end
  end

  def build_environment(req)
    environment = req.query.select { |key, _| %w[NOUPLOAD SERVER KEEPCHROOT SWITCHBRANCH].include?(key) }
    # An unchecked HTML checkbox is absent; API requests can omit the option
    # altogether to preserve the previous attempt's value on retry.
    if req.query['keep_chroot_present'] == '1'
      environment['KEEPCHROOT'] = req.query['KEEPCHROOT'] == '1' ? '1' : '0'
    end
    if req.query['switch_branch_present'] == '1'
      environment['SWITCHBRANCH'] = req.query['SWITCHBRANCH'] == '1' ? '1' : '0'
    end
    environment
  end

  def create_build(req, res)
    environment = build_environment(req)
    build = @manager.enqueue(req.query['command'], target_builder: req.query['target_builder'], environment: environment)
    if req['accept'] == 'application/json'
      res.status = 201
      res['Content-Type'] = 'application/json'
      res.body = JSON.generate(id: build.id)
    else
      redirect(res, '/')
    end
  end

  def refresh_remote(req, res)
    added = @manager.refresh_from_remote(extra_safe_deps: req.query['extra_safe_deps'])
    message = added.empty? ? "#{REFRESH_COMMAND} found no new packages" : "#{REFRESH_COMMAND} added #{added.size} pending package(s)"
    redirect(res, "/?notice=#{CGI.escape(message)}")
  end

  def add_refresh(req, res)
    selected = Array(req.query['pkgbase'])
    raise ArgumentError, 'select at least one pending package' if selected.empty?

    queued, errors = @manager.enqueue_refresh(selected)
    message = "queued #{queued.size} build(s)"
    message += "; #{errors.join('; ')}" if errors.any?
    redirect(res, "/?notice=#{CGI.escape(message)}")
  end

  def clear_refresh(req, res)
    selected = Array(req.query['pkgbase'])
    raise ArgumentError, 'select at least one pending package' if selected.empty?

    count = @manager.clear_refresh(selected)
    redirect(res, "/?notice=#{CGI.escape("cleared #{count} pending package(s)")}")
  end

  def answer_upload(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    @manager.answer_upload(id, upload: req.query['decision'] == 'yes')
    redirect(res, '/')
  end

  def mark_memory_killer(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    pkgbase = @manager.mark_memory_killer(id)
    message = "#{pkgbase} added to the memory killer list (requires at least 32 GiB RAM for automatic selection)"
    redirect(res, "/?notice=#{CGI.escape(message)}")
  end

  def retry_build(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    build = @manager.find(id)
    return not_found(res) unless build
    unless %w[failed interrupted waiting_upload].include?(build.status)
      raise ArgumentError, 'only failed, interrupted, or upload-waiting builds can be retried'
    end

    @manager.answer_upload(id, upload: false) if build.status == 'waiting_upload'
    @manager.enqueue(build.command_line, target_builder: build.target_builder, ignore_active_id: id,
      new_builder: req.query['new_builder'] == '1', environment: build.environment.merge(build_environment(req)))
    redirect(res, '/')
  end

  def push_branch(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    pkgbase = @manager.push_branch(id)
    redirect(res, "https://github.com/felixonmars/archriscv-packages/compare/master...#{CGI.escape(pkgbase)}?quick_pull=1")
  end

  def stop_build(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    @manager.stop_build(id)
    redirect(res, '/')
  end

  def kill_build(req, res, id)
