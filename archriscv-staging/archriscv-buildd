#!/usr/bin/env ruby
# frozen_string_literal: true

require 'cgi'
require 'fileutils'
require 'json'
require 'open3'
require 'pty'
require 'rbconfig'
require 'shellwords'
require 'time'
require 'webrick'

APP_NAME = 'archriscv-buildd'
APP_TITLE = 'Arch Linux RISC-V Build Scheduler'
STATE_DIR = ENV.fetch('ARCHRISCV_BUILDD_STATE_DIR', File.join(Dir.home, '.local/state/archriscv-buildd'))
LOG_DIR = ENV.fetch('ARCHRISCV_BUILDD_LOG_DIR', File.join(STATE_DIR, 'logs'))
STATE_FILE = File.join(STATE_DIR, 'state.json')
WORKER_DIR = File.expand_path(File.join(STATE_DIR, 'workers'))
BUILD_COMMAND = ENV.fetch('ARCHRISCV_BUILDD_BUILD_COMMAND', 'riscvu')
BUILDER_USER = ENV.fetch('ARCHRISCV_BUILDD_BUILDER_USER', '').strip
REFRESH_COMMAND = ENV.fetch('ARCHRISCV_BUILDD_REFRESH_COMMAND', 'archrv-refresh')
BUILD_WORKDIR = ENV['ARCHRISCV_BUILDD_WORKDIR']
BIND = ENV.fetch('ARCHRISCV_BUILDD_BIND', '127.0.0.1')
PORT = ENV.fetch('ARCHRISCV_BUILDD_PORT', '9181').to_i
RECENT_PAGE_SIZE = 30
PROMPT_PATTERN = /(?:\A|[\r\n])Upload log\? \[y\/N\] \z/.freeze
HOST_PATTERN = /(?:\A|[\r\n])==> Building on ([A-Za-z0-9._-]+)/.freeze
ANSI_PATTERN = /\e(?:\][^\a]*?(?:\a|\e\\)|\[[0-?]*[ -\/]*[@-~]|[ -\/]*[0-~])/.freeze
COMMAND_PATTERN = /\A[A-Za-z0-9][A-Za-z0-9@._+-]*(?::nocheck)?\z/.freeze
TARGET_BUILDER_PATTERN = /\A(?:[A-Za-z0-9_][A-Za-z0-9._-]*@)?[A-Za-z0-9][A-Za-z0-9._-]*\z/.freeze
ACTIVE_STATUSES = %w[queued running waiting_upload].freeze
TERMINAL_STATUSES = %w[succeeded failed interrupted].freeze

def h(value)
  CGI.escapeHTML(value.to_s)
end

def safe_filename(value)
  value.to_s.gsub(/[^A-Za-z0-9._+-]+/, '_').sub(/\A_+/, '').sub(/_+\z/, '')
end

def parse_time(value)
  return unless value

  Time.parse(value)
rescue ArgumentError, TypeError
  nil
end

def fmt_time(value)
  return 'not yet' unless value

  value.utc.strftime('%Y-%m-%d %H:%M:%S UTC')
end

def duration(build)
  return '-' unless build.started_at

  finished = build.finished_at || Time.now.utc
  seconds = [(finished - build.started_at).to_i, 0].max
  minutes, secs = seconds.divmod(60)
  hours, minutes = minutes.divmod(60)
  hours.positive? ? format('%dh%02dm%02ds', hours, minutes, secs) : format('%dm%02ds', minutes, secs)
end

def read_log(path, offset = 0, max_bytes = nil)
  return ['', 0] unless File.exist?(path)

  size = File.size(path)
  offset = [[offset, 0].max, size].min
  max_bytes ||= size - offset
  data = +''
  File.open(path, 'rb') do |file|
    file.seek(offset)
    data = file.read(max_bytes).to_s
    offset = file.pos
  end
  [data, offset]
end

def utf8(value)
  value.to_s.encode('UTF-8', invalid: :replace, undef: :replace)
end

def status_class(status)
  case status
  when 'running' then 'is-info'
  when 'waiting_upload' then 'is-warning'
  when 'failed', 'interrupted' then 'is-danger'
  when 'succeeded' then 'is-success'
  else 'is-light'
  end
end

def status_tag(status, id: nil)
  id_attr = id ? %( id="#{h(id)}") : ''
  %(<span#{id_attr} class="tag #{status_class(status)}">#{h(status.tr('_', ' '))}</span>)
end

class Build
  attr_accessor :id, :command_line, :argv, :pkgbase, :log_path, :status,
                :created_at, :started_at, :finished_at, :exit_status,
                :upload_prompt_seen, :upload_decision, :prompt_answered_at,
                :build_host, :target_builder, :note, :unit_name, :discard_after_finish

  def initialize(id:, command_line:, argv:, pkgbase:, log_path:, status: 'queued',
                 created_at: Time.now.utc, started_at: nil, finished_at: nil,
                 exit_status: nil, upload_prompt_seen: false, upload_decision: nil,
                 prompt_answered_at: nil, build_host: nil, target_builder: nil, note: nil,
                 unit_name: nil, discard_after_finish: false)
    @id = id
    @command_line = command_line
    @argv = argv
    @pkgbase = pkgbase
    @log_path = log_path
    @status = status
    @created_at = created_at
    @started_at = started_at
    @finished_at = finished_at
    @exit_status = exit_status
    @upload_prompt_seen = upload_prompt_seen
    @upload_decision = upload_decision
    @prompt_answered_at = prompt_answered_at
    @build_host = build_host
    @target_builder = target_builder
    @note = note
    @unit_name = unit_name
    @discard_after_finish = discard_after_finish
  end

  def self.from_h(hash)
    new(
      id: hash.fetch('id'),
      command_line: hash.fetch('command_line'),
      argv: hash.fetch('argv'),
      pkgbase: hash['pkgbase'],
      log_path: hash.fetch('log_path'),
      status: hash.fetch('status', 'queued'),
      created_at: parse_time(hash['created_at']) || Time.now.utc,
      started_at: parse_time(hash['started_at']),
      finished_at: parse_time(hash['finished_at']),
      exit_status: hash['exit_status'],
      upload_prompt_seen: hash['upload_prompt_seen'] || false,
      upload_decision: hash['upload_decision'],
      prompt_answered_at: parse_time(hash['prompt_answered_at']),
      build_host: hash['build_host'],
      target_builder: hash['target_builder'],
      note: hash['note'],
      unit_name: hash['unit_name'],
      discard_after_finish: hash['discard_after_finish'] || false
    )
  end

  def to_h
    {
      'id' => id,
      'command_line' => command_line,
      'argv' => argv,
      'pkgbase' => pkgbase,
      'log_path' => log_path,
      'status' => status,
      'created_at' => created_at&.utc&.iso8601,
      'started_at' => started_at&.utc&.iso8601,
      'finished_at' => finished_at&.utc&.iso8601,
      'exit_status' => exit_status,
      'upload_prompt_seen' => upload_prompt_seen,
      'upload_decision' => upload_decision,
      'prompt_answered_at' => prompt_answered_at&.utc&.iso8601,
      'build_host' => build_host,
      'target_builder' => target_builder,
      'note' => note,
      'unit_name' => unit_name,
      'discard_after_finish' => discard_after_finish
    }
  end

  def active?
    ACTIVE_STATUSES.include?(status)
  end

  def terminal?
    TERMINAL_STATUSES.include?(status)
  end
end

def write_json(path, data)
  tmp = "#{path}.tmp"
  File.write(tmp, JSON.pretty_generate(data), mode: 'w', perm: 0o600)
  File.rename(tmp, path)
end

class SystemdBuildService
  def start(build, directory)
    output, status = Open3.capture2e(
      'systemd-run', '--quiet', '--collect', '--service-type=exec',
      "--unit=#{build.unit_name}", "--description=Build #{build.command_line}",
      "--property=User=#{Process.uid}", "--property=Group=#{Process.gid}",
      '--property=KillMode=control-group', '--property=TimeoutStopSec=10s',
      '--property=UMask=0077',
      '--', RbConfig.ruby, File.realpath(__FILE__), '--worker', directory
    )
    raise "could not start build worker: #{output.strip}" unless status.success? || active?(build)
  end

  def active?(build)
    output, status = Open3.capture2e('systemctl', 'show', '--property=LoadState,ActiveState', build.unit_name)
    properties = output.lines.filter_map do |line|
      key, value = line.strip.split('=', 2)
      [key, value] if value
    end.to_h
    return false if properties['LoadState'] == 'not-found'

    raise "could not query build worker: #{output.strip}" unless status.success?

    %w[active activating reloading deactivating].include?(properties['ActiveState'])
  end

  def stop(build)
    output, status = Open3.capture2e('systemctl', 'stop', build.unit_name)
    raise "could not stop build worker: #{output.strip}" unless status.success? || !active?(build)
  end
end

class BuildWorker
  def initialize(directory)
    @directory = directory
    @request = JSON.parse(File.read(File.join(directory, 'request.json')))
    @build = Build.from_h(@request.fetch('build'))
    @prompt_tail = +''
    @stopping = false
  end

  def run
    File.open(File.join(@directory, 'lock'), 'w', 0o600) do |lock|
      raise 'build worker is already running' unless lock.flock(File::LOCK_EX | File::LOCK_NB)
      # A worker may be reattached to, but must never rerun a started build.
      return 0 if File.exist?(status_path)

      run_build
    end
    @build.status == 'succeeded' ? 0 : 1
  end

  private

  def status_path
    File.join(@directory, 'status.json')
  end

  def persist
    write_json(status_path, @build.to_h)
  end

  def append_log(chunk)
    File.open(@build.log_path, 'ab') { |file| file.write(chunk) }
  end

  def run_build
    handlers = %w[INT TERM].to_h { |signal| [signal, trap(signal) { @stopping = true }] }
    @build.status = 'running'
    @build.started_at = Time.now.utc
    persist
    append_log("$ #{@build.argv.shelljoin}\n")
    append_log("target builder: #{@build.target_builder}\n") if @build.target_builder
    append_log("started: #{@build.started_at.iso8601}\n\n")

    env = @request.fetch('environment').merge('TERM' => 'xterm')
    env['SERVER'] = @build.target_builder if @build.target_builder
    options = {chdir: @request.fetch('workdir'), unsetenv_others: true}
    @reader, @writer, @pid = PTY.spawn(env, *@build.argv, options)
    @writer.sync = true
    eof = false
    until @wait_status || @stopping
      if IO.select(eof ? [] : [@reader], nil, nil, 0.25)
        eof = !read_output
      end
      answer_upload unless @stopping
      _, @wait_status = Process.wait2(@pid, Process::WNOHANG)
    end
    while !eof && IO.select([@reader], nil, nil, 0)
      eof = !read_output
    end
  rescue StandardError => e
    @build.note = e.message
    append_log("\n#{APP_NAME}: #{e.class}: #{e.message}\n")
  ensure
    reap_child
    @reader&.close unless @reader&.closed?
    @writer&.close unless @writer&.closed?
    @build.exit_status = @wait_status&.exitstatus || (@wait_status&.termsig && 128 + @wait_status.termsig)
    @build.finished_at = Time.now.utc
    @build.status = if @stopping
                      @build.note ||= 'build worker stopped'
                      'interrupted'
                    elsif @wait_status&.success? && !@build.note
                      'succeeded'
                    else
                      'failed'
                    end
    append_log("\nfinished: #{@build.finished_at.iso8601} exit=#{@build.exit_status || 'unknown'}\n")
    persist
    handlers&.each { |signal, handler| trap(signal, handler) }
  end

  def read_output
    chunk = @reader.read_nonblock(16_384, exception: false)
    return false unless chunk
    return true if chunk == :wait_readable

    append_log(chunk)
    observe_prompt(chunk)
    true
  rescue EOFError, Errno::EIO
    false
  end

  def observe_prompt(chunk)
    tail = @prompt_tail + chunk
    @prompt_tail = tail.bytesize > 512 ? tail.byteslice(-512, 512) : tail
    clean_tail = @prompt_tail.gsub(ANSI_PATTERN, '')
    changed = false
    if !@build.build_host && (match = clean_tail.match(HOST_PATTERN))
      @build.build_host = match[1]
      changed = true
    end
    if !@build.upload_prompt_seen && clean_tail.match?(PROMPT_PATTERN)
      @build.upload_prompt_seen = true
      @build.status = 'waiting_upload'
      changed = true
    end
    persist if changed
  end

  def answer_upload
    return unless @build.status == 'waiting_upload'

    path = File.join(@directory, 'upload.json')
    return unless File.exist?(path)

    decision = JSON.parse(File.read(path)).fetch('decision')
    raise 'invalid upload decision' unless %w[upload skip].include?(decision)

    @writer.write(decision == 'upload' ? "y\n" : "n\n")
    @writer.flush
    @build.upload_decision = decision
    @build.prompt_answered_at = Time.now.utc
    @build.discard_after_finish = decision == 'skip'
    @build.status = 'running'
    persist
  end

  def reap_child
    return unless @pid && !@wait_status

    Process.kill('TERM', -@pid)
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 3
    loop do
      _, @wait_status = Process.wait2(@pid, Process::WNOHANG)
      return if @wait_status
      break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

      sleep 0.05
    end
    Process.kill('KILL', -@pid)
    _, @wait_status = Process.wait2(@pid)
  rescue Errno::ESRCH, Errno::ECHILD
    nil
  end
end

class BuildManager
  def initialize(service: SystemdBuildService.new)
    @service = service
    @mutex = Mutex.new
    @builds = {}
    @refresh_pending = []
    @shutting_down = false

    FileUtils.mkdir_p([STATE_DIR, LOG_DIR, WORKER_DIR])
    load_state
  end

  def start
    @mutex.synchronize do
      @builds.values.select { |build| build.status == 'queued' }.each do |build|
        unless build.unit_name
          prepare_worker(build)
          persist_locked
        end
        launch_worker(build) unless File.exist?(worker_status_path(build)) || @service.active?(build)
      end
      refresh_workers_locked(check_units: true)
    end
    @monitor = Thread.new do
      tick = 0
      loop do
        sleep 1
        break if @shutting_down

        @mutex.synchronize { refresh_workers_locked(check_units: (tick % 10).zero?) }
        tick += 1
      rescue StandardError => e
        warn "#{APP_NAME}: worker monitor: #{e.message}"
      end
    end
  end

  def all_builds
    @mutex.synchronize do
      refresh_workers_locked
      @builds.values.sort_by(&:created_at).reverse
    end
  end

  def find(id)
    @mutex.synchronize do
      refresh_workers_locked
      @builds[id]
    end
  end

  def refresh_pending
    @mutex.synchronize { @refresh_pending.dup }
  end

  def enqueue(command_line, target_builder: nil, ignore_active_id: nil)
    command_line = command_line.to_s.strip
    raise ArgumentError, 'enter a package name, optionally ending with :nocheck' unless command_line.match?(COMMAND_PATTERN)

    target_builder = target_builder.to_s.strip
    if !target_builder.empty? && !target_builder.include?('@') && !BUILDER_USER.empty?
      target_builder = "#{BUILDER_USER}@#{target_builder}"
    end
    unless target_builder.empty? || target_builder.match?(TARGET_BUILDER_PATTERN)
      raise ArgumentError, 'enter a target builder as host or user@host, or leave it blank for automatic selection'
    end
    target_builder = nil if target_builder.empty?

    pkgbase = command_line.sub(/:nocheck\z/, '')
    id = "#{Time.now.utc.strftime('%Y%m%d%H%M%S')}-#{format('%06x', Random.rand(0x1000000))}"
    log_path = File.expand_path(File.join(LOG_DIR, "#{id}-#{safe_filename(pkgbase)}.log"))
    build = Build.new(
      id: id,
      command_line: command_line,
      argv: [BUILD_COMMAND, command_line],
      pkgbase: pkgbase,
      target_builder: target_builder,
      log_path: log_path
    )

    @mutex.synchronize do
      refresh_workers_locked
      if @builds.values.any? { |existing| existing.id != ignore_active_id && existing.active? && existing.pkgbase == pkgbase }
        raise ArgumentError, "#{pkgbase} is already queued or building"
      end

      @builds[id] = build
      prepare_worker(build)
      persist_locked
      launch_worker(build)
    end
    build
  rescue ArgumentError
    raise
  rescue StandardError => e
    raise ArgumentError, e.message
  end

  def refresh_from_remote
    output = `#{REFRESH_COMMAND} 2>&1`
    raise ArgumentError, "#{REFRESH_COMMAND} failed: #{output.lines.last.to_s.strip}" unless $?.success?

    candidates = output.lines.map(&:strip).select { |line| line.match?(COMMAND_PATTERN) }.uniq
    added = []
    @mutex.synchronize do
      added = candidates.reject { |pkgbase| @refresh_pending.include?(pkgbase) }
      @refresh_pending.concat(added)
      persist_locked if added.any?
    end
    added
  end

  def enqueue_refresh(pkgbases)
    queued = []
    errors = []
    selected = Array(pkgbases).map(&:to_s).map(&:strip).uniq.select do |pkgbase|
      pkgbase.match?(COMMAND_PATTERN) && @mutex.synchronize { @refresh_pending.include?(pkgbase) }
    end

    unless selected.empty?
      output = `pacman -Sy 2>&1`
      raise ArgumentError, "pacman -Sy failed: #{output.lines.last.to_s.strip}" unless $?.success?
    end

    selected.each do |pkgbase|
      begin
        build = enqueue(pkgbase)
        queued << build
        @mutex.synchronize do
          @refresh_pending.delete(pkgbase)
          persist_locked
        end
      rescue ArgumentError => e
        errors << "#{pkgbase}: #{e.message}"
      end
    end

    [queued, errors]
  end

  def clear_refresh(pkgbases)
    selected = Array(pkgbases).map(&:to_s).map(&:strip)
    @mutex.synchronize do
      selected = @refresh_pending if selected.empty?
      before = @refresh_pending.size
      @refresh_pending -= selected
      persist_locked if @refresh_pending.size != before
      before - @refresh_pending.size
    end
  end

  def answer_upload(id, upload:)
    decision = upload ? 'upload' : 'skip'
    @mutex.synchronize do
      refresh_workers_locked
      build = @builds[id] || raise(ArgumentError, 'unknown build')
      raise ArgumentError, 'build is not waiting for an upload decision' unless build.status == 'waiting_upload'

      path = File.join(worker_directory(build), 'upload.json')
      if File.exist?(path) && JSON.parse(File.read(path))['decision'] != decision
        raise ArgumentError, 'an upload decision has already been submitted'
      end
      write_json(path, 'decision' => decision)
    end

    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 5
    loop do
      build = find(id)
      return if !build || build.upload_decision == decision
      raise ArgumentError, 'build finished before accepting the upload decision' if build.terminal?
      break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

      sleep 0.05
    end
    raise ArgumentError, 'upload decision saved; the build worker has not acknowledged it yet'
  end

  def stop_build(id)
    build = find(id) || raise(ArgumentError, 'unknown build')
    raise ArgumentError, 'build is not active' unless build.active?

    @service.stop(build)
    @mutex.synchronize do
      refresh_workers_locked
      build = @builds[id]
      return unless build

      build.status = 'interrupted'
      build.finished_at ||= Time.now.utc
      build.note = 'stopped by user'
      persist_locked
    end
  end

  def delete_build(id)
    @mutex.synchronize do
      refresh_workers_locked
      build = @builds[id] || raise(ArgumentError, 'unknown build')
      raise ArgumentError, 'cannot delete an active build' if build.active?

      @builds.delete(id)
      persist_locked
      remove_build_files(build)
    end
  end

  def shutdown
    @shutting_down = true
    @monitor&.join
  end

  def shutting_down?
    @shutting_down
  end

  private

  def load_state
    return unless File.exist?(STATE_FILE)

    changed = false
    data = JSON.parse(File.read(STATE_FILE))
    data.fetch('builds', []).each do |entry|
      build = Build.from_h(entry)
      if !build.unit_name && %w[running waiting_upload].include?(build.status)
        build.status = 'interrupted'
        build.finished_at ||= Time.now.utc
        build.note = 'daemon restarted while this build was active'
        changed = true
      end
      @builds[build.id] = build
    end
    @refresh_pending = data.fetch('refresh_pending', []).select { |pkgbase| pkgbase.to_s.match?(COMMAND_PATTERN) }
    persist_locked if changed
  rescue JSON::ParserError => e
    warn "#{APP_NAME}: ignoring unreadable state file: #{e.message}"
  end

  def persist_locked
    FileUtils.mkdir_p(STATE_DIR)
    write_json(STATE_FILE,
      'builds' => @builds.values.sort_by(&:created_at).map(&:to_h),
      'refresh_pending' => @refresh_pending
    )
  end

  def worker_directory(build)
    File.join(WORKER_DIR, build.id)
  end

  def worker_status_path(build)
    File.join(worker_directory(build), 'status.json')
  end

  def prepare_worker(build)
    build.unit_name = "#{APP_NAME}-build-#{build.id}.service"
    build.log_path = File.expand_path(build.log_path)
    directory = worker_directory(build)
    FileUtils.mkdir_p(directory, mode: 0o700)
    # Preserve the build environment without forwarding the web service's systemd identity.
    environment = ENV.to_h.reject do |key, _|
      %w[NOTIFY_SOCKET WATCHDOG_PID WATCHDOG_USEC INVOCATION_ID JOURNAL_STREAM SYSTEMD_EXEC_PID].include?(key)
    end
    write_json(File.join(directory, 'request.json'),
      'build' => build.to_h,
      'environment' => environment,
      'workdir' => BUILD_WORKDIR.to_s.empty? ? Dir.pwd : File.expand_path(BUILD_WORKDIR)
    )
  end

  def launch_worker(build)
    @service.start(build, worker_directory(build))
  rescue StandardError => e
    build.status = 'failed'
    build.finished_at = Time.now.utc
    build.note = e.message
    persist_locked
    warn "#{APP_NAME}: build #{build.id}: #{e.message}"
  end

  def worker_status(build)
    path = worker_status_path(build)
    current = File.exist?(path) ? Build.from_h(JSON.parse(File.read(path))) : build

    # Older workers may have missed the host announcement before an ANSI-parser fix.
    current.build_host ||= build.build_host
    unless current.build_host
      log, = read_log(current.log_path, 0, 65_536)
      current.build_host = log.gsub(ANSI_PATTERN, '').match(HOST_PATTERN)&.[](1)
    end
    current
  end

  def refresh_workers_locked(check_units: false)
    changed = false
    removed = []
    @builds.values.select { |build| build.unit_name && (build.active? || build.discard_after_finish) }.each do |build|
      before = build.to_h
      current = worker_status(build)
      if check_units && current.active? && !@service.active?(current)
        # The worker can finish between reading its status and querying systemd.
        current = worker_status(current)
        if current.active?
          current.status = 'interrupted'
          current.finished_at ||= Time.now.utc
          current.note = 'build worker exited without recording a result'
        end
      end
      if current.terminal? && current.discard_after_finish
        @builds.delete(build.id)
        changed = true
        removed << current
      elsif current.to_h != before
        @builds[build.id] = current
        changed = true
      end
    end
    persist_locked if changed
    removed.each { |build| remove_build_files(build) }
  end

  def remove_build_files(build)
    FileUtils.rm_f(build.log_path)
    FileUtils.rm_rf(worker_directory(build)) if build.unit_name
  end
end

class WebApp
  def initialize(manager)
    @manager = manager
  end

  def call(req, res)
    case [req.request_method, req.path]
    when ['GET', '/']
      html(res, render_index(req))
    when ['POST', '/builds']
      create_build(req, res)
    when ['POST', '/refresh']
      refresh_remote(req, res)
    when ['POST', '/refresh/add']
      add_refresh(req, res)
    when ['POST', '/refresh/clear']
      clear_refresh(req, res)
    else
      route_build(req, res)
    end
  rescue ArgumentError => e
    html(res, render_index(req, error: e.message), status: 400)
  rescue StandardError => e
    warn "#{APP_NAME}: web: #{e.class}: #{e.message}"
    warn e.backtrace.first(5).join("\n") if ENV['ARCHRISCV_BUILDD_DEBUG']
    html(res, layout('error', %(<section class="notification is-danger"><h2 class="title is-5">Internal error</h2><p>#{h(e.message)}</p></section>)), status: 500)
  end

  private

  def route_build(req, res)
    case req.path
    when %r{\A/builds/([^/]+)/log\z}
      show_log(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/raw\z}
      raw_log(res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/events\z}
      stream_events(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/upload\z}
      answer_upload(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/retry\z}
      retry_build(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/stop\z}
      stop_build(req, res, Regexp.last_match(1))
    when %r{\A/builds/([^/]+)/delete\z}
      delete_build(req, res, Regexp.last_match(1))
    else
      not_found(res)
    end
  end

  def create_build(req, res)
    @manager.enqueue(req.query['command'], target_builder: req.query['target_builder'])
    redirect(res, '/')
  end

  def refresh_remote(_req, res)
    added = @manager.refresh_from_remote
    message = added.empty? ? "#{REFRESH_COMMAND} found no new packages" : "#{REFRESH_COMMAND} added #{added.size} pending package(s)"
    redirect(res, "/?notice=#{CGI.escape(message)}")
  end

  def add_refresh(req, res)
    selected = Array(req.query['pkgbase'])
    raise ArgumentError, 'select at least one pending package' if selected.empty?

    queued, errors = @manager.enqueue_refresh(selected)
    message = "queued #{queued.size} build(s)"
    message += "; #{errors.join('; ')}" if errors.any?
    redirect(res, "/?notice=#{CGI.escape(message)}")
  end

  def clear_refresh(req, res)
    selected = Array(req.query['pkgbase'])
    raise ArgumentError, 'select at least one pending package' if selected.empty?

    count = @manager.clear_refresh(selected)
    redirect(res, "/?notice=#{CGI.escape("cleared #{count} pending package(s)")}")
  end

  def answer_upload(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    @manager.answer_upload(id, upload: req.query['decision'] == 'yes')
    redirect(res, '/')
  end

  def retry_build(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    build = @manager.find(id)
    return not_found(res) unless build
    unless %w[failed interrupted waiting_upload].include?(build.status)
      raise ArgumentError, 'only failed, interrupted, or upload-waiting builds can be retried'
    end

    @manager.answer_upload(id, upload: false) if build.status == 'waiting_upload'
    @manager.enqueue(build.command_line, target_builder: build.target_builder, ignore_active_id: id)
    redirect(res, '/')
  end

  def stop_build(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    @manager.stop_build(id)
    redirect(res, '/')
  end

  def delete_build(req, res, id)
    not_found(res) && return unless req.request_method == 'POST'

    @manager.delete_build(id)
    redirect(res, '/')
  end

