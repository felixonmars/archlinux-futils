    unless host
      log, = read_log(build.log_path, 0, 65_536)
      match = log.gsub(ANSI_PATTERN, '').match(HOST_PATTERN)
      host = match[1] if match
    end

    <<~HTML
      <article class="box build-card #{h(build.status)} p-3 mb-2">
        #{delete_button(build)}
        <div class="build-head">
          <div class="build-title">
            #{status_tag(build.status)}
            <h3 class="title is-6 mb-0">#{h(build.pkgbase || build.command_line)}</h3>
            #{%(<span class="tag is-light">#{h(host)}</span>) if host}
          </div>
          <span class="is-size-7 has-text-grey">#{h(duration(build))}#{%( - exit #{h(build.exit_status)}) if build.exit_status}</span>
        </div>
        <p class="command is-family-monospace" title="#{h(build.argv.shelljoin)}">#{h(build.argv.shelljoin)}</p>
        #{decision_panel(build)}
        #{%(<p class="help is-danger mb-1">#{h(build.note)}</p>) if build.note}
        <div class="buttons are-small mb-0">
          <a class="button is-small" href="/builds/#{h(build.id)}/log">Log</a>
          <a class="button is-small is-light" href="/builds/#{h(build.id)}/raw">Raw</a>
          #{stop_button(build)}
          #{retry_button(build) unless build.status == 'waiting_upload'}
        </div>
      </article>
    HTML
  end

  def delete_button(build)
