def h(value)
  CGI.escapeHTML(value.to_s)
end

def safe_filename(value)
  value.to_s.gsub(/[^A-Za-z0-9._+-]+/, '_').sub(/\A_+/, '').sub(/_+\z/, '')
end

def parse_time(value)
  return unless value

  Time.parse(value)
rescue ArgumentError, TypeError
  nil
end

def fmt_time(value)
  return 'not yet' unless value

  value.utc.strftime('%Y-%m-%d %H:%M:%S UTC')
end

def duration(build)
  return '-' unless build.started_at

  finished = build.upload_prompt_at || build.finished_at || Time.now.utc
  seconds = [(finished - build.started_at).to_i, 0].max
  minutes, secs = seconds.divmod(60)
  hours, minutes = minutes.divmod(60)
  hours.positive? ? format('%dh%02dm%02ds', hours, minutes, secs) : format('%dm%02ds', minutes, secs)
end

def read_log(path, offset = 0, max_bytes = nil)
  return ['', 0] unless File.exist?(path)

  size = File.size(path)
  offset = [[offset, 0].max, size].min
  max_bytes ||= size - offset
  data = +''
  File.open(path, 'rb') do |file|
    file.seek(offset)
    data = file.read(max_bytes).to_s
    offset = file.pos
  end
  [data, offset]
end

def utf8(value)
  # Binary log reads contain UTF-8 bytes; decode them before replacing invalid sequences.
  value.to_s.dup.force_encoding('UTF-8').scrub
end

def read_log_page(path, before = nil)
  return { text: '', before: 0, offset: 0 } unless File.exist?(path)

  File.open(path, 'rb') do |file|
    finish = before ? [[before, 0].max, file.size].min : file.size
    start = [finish - 131_072, 0].max
    file.seek(start)
    text = file.read(finish - start).to_s
    if start.positive?
      # Prefer whole lines, but keep reads bounded even for a very long line.
      newline = text.index("\n")
      skip = newline && newline < 65_536 ? newline + 1 : 0
      skip += 1 while skip < 3 && text.getbyte(skip)&.between?(0x80, 0xbf)
      text = text.byteslice(skip..)
      start += skip
    end
    { text: utf8(text), before: start, offset: finish }
  end
end

def status_class(status)
  case status
  when 'running', 'working' then 'is-info'
  when 'waiting_upload', 'waiting_for_input', 'rebuild_pending' then 'is-warning'
  when 'failed', 'interrupted' then 'is-danger'
  when 'succeeded' then 'is-success'
  else 'is-light'
  end
end

def status_tag(status, id: nil)
  id_attr = id ? %( id="#{h(id)}") : ''
  %(<span#{id_attr} class="tag #{status_class(status)}">#{h(status.tr('_', ' '))}</span>)
end

def build_history_for(builds)
  active = builds.select(&:active?)
  recent = builds.reject(&:active?).sort_by do |build|
    [build.finished_at || build.prompt_answered_at || build.started_at || build.created_at, build.created_at, build.id]
  end.reverse
  latest = (active + recent).uniq do |build|
    build.pkgbase || build.command_line.sub(/:nocheck\z/, '')
  end.reject(&:active?).to_h { |build| [build.id, true] }
  [active, recent, latest]
end

class Build
  attr_accessor :id, :command_line, :argv, :pkgbase, :log_path, :status,
                :created_at, :started_at, :finished_at, :exit_status,
                :upload_prompt_seen, :upload_prompt_at, :upload_decision, :prompt_answered_at,
                :build_host, :target_builder, :note, :unit_name, :discard_after_finish, :stop_requested,
                :environment, :package_version

  def initialize(id:, command_line:, argv:, pkgbase:, log_path:, status: 'queued',
                 created_at: Time.now.utc, started_at: nil, finished_at: nil,
                 exit_status: nil, upload_prompt_seen: false, upload_prompt_at: nil, upload_decision: nil,
                 prompt_answered_at: nil, build_host: nil, target_builder: nil, note: nil,
                 unit_name: nil, discard_after_finish: false, stop_requested: false, environment: {}, package_version: nil)
    @id = id
    @command_line = command_line
    @argv = argv
    @pkgbase = pkgbase
    @package_version = package_version
    @log_path = log_path
    @status = status
    @created_at = created_at
    @started_at = started_at
    @finished_at = finished_at
    @exit_status = exit_status
    @upload_prompt_seen = upload_prompt_seen
    @upload_prompt_at = upload_prompt_at
    @upload_decision = upload_decision
    @prompt_answered_at = prompt_answered_at
    @build_host = build_host
    @target_builder = target_builder
    @note = note
    @unit_name = unit_name
    @discard_after_finish = discard_after_finish
    @stop_requested = stop_requested
    @environment = environment
  end

  def self.from_h(hash)
    new(
      id: hash.fetch('id'),
      command_line: hash.fetch('command_line'),
      argv: hash.fetch('argv'),
      pkgbase: hash['pkgbase'],
      package_version: hash['package_version'],
      log_path: hash.fetch('log_path'),
      status: hash.fetch('status', 'queued'),
      created_at: parse_time(hash['created_at']) || Time.now.utc,
      started_at: parse_time(hash['started_at']),
      finished_at: parse_time(hash['finished_at']),
      exit_status: hash['exit_status'],
      upload_prompt_seen: hash['upload_prompt_seen'] || false,
      upload_prompt_at: parse_time(hash['upload_prompt_at']),
      upload_decision: hash['upload_decision'],
      prompt_answered_at: parse_time(hash['prompt_answered_at']),
      build_host: hash['build_host'],
      target_builder: hash['target_builder'],
      note: hash['note'],
      unit_name: hash['unit_name'],
      discard_after_finish: hash['discard_after_finish'] || false,
      stop_requested: hash['stop_requested'] || false,
      environment: hash.fetch('environment', {})
    )
  end

  def to_h
    {
      'id' => id,
      'command_line' => command_line,
      'argv' => argv,
      'pkgbase' => pkgbase,
      'package_version' => package_version,
      'log_path' => log_path,
      'status' => status,
      'created_at' => created_at&.utc&.iso8601(6),
      'started_at' => started_at&.utc&.iso8601,
      'finished_at' => finished_at&.utc&.iso8601(6),
      'exit_status' => exit_status,
      'upload_prompt_seen' => upload_prompt_seen,
      'upload_prompt_at' => upload_prompt_at&.utc&.iso8601,
      'upload_decision' => upload_decision,
      'prompt_answered_at' => prompt_answered_at&.utc&.iso8601,
      'build_host' => build_host,
      'target_builder' => target_builder,
      'note' => note,
      'unit_name' => unit_name,
      'discard_after_finish' => discard_after_finish,
      'stop_requested' => stop_requested,
      'environment' => environment
    }
  end

  def active?
    ACTIVE_STATUSES.include?(status)
  end

  def read_package_version(log)
    name = pkgbase || command_line.sub(/:nocheck\z/, '')
    self.package_version ||= log.gsub(ANSI_PATTERN, '').match(/(?:\A|[\r\n])==> Making package: #{Regexp.escape(name)} ([^\s]+)\s/)&.[](1)
  end

  def terminal?
    TERMINAL_STATUSES.include?(status)
  end

  def can_push_branch?
    status == 'succeeded' && environment['SWITCHBRANCH'] == '1'
  end
end

def write_json(path, data)
  tmp = "#{path}.tmp"
  File.write(tmp, JSON.pretty_generate(data), mode: 'w', perm: 0o600)
  File.rename(tmp, path)
end

module ProcessDescriptors
  extend Fiddle::Importer
  dlload Fiddle::Handle::DEFAULT
  extern 'int pidfd_open(int, unsigned int)'
  extern 'int pidfd_getfd(int, int, unsigned int)'
end

class BuildTerminal
  def self.interrupt(pid)
    raise ArgumentError, 'build worker is not running' unless pid.positive?

    fd = ProcessDescriptors.pidfd_open(pid, 0)
    raise SystemCallError.new('open build worker', Fiddle.last_error) if fd.negative?

    process = IO.for_fd(fd)
    # Duplicate the existing PTY master; reopening /proc/PID/fd/N would create
    # a different PTY. A pidfd also prevents targeting a reused process ID.
    terminal = Dir.children("/proc/#{pid}/fdinfo").find do |name|
      File.read("/proc/#{pid}/fdinfo/#{name}").match?(/^tty-index:\s*\d+/)
    rescue Errno::ENOENT
      false
    end
    raise ArgumentError, 'build terminal is not ready' unless terminal

    fd = ProcessDescriptors.pidfd_getfd(process.fileno, terminal.to_i, 0)
    raise SystemCallError.new('access build terminal', Fiddle.last_error) if fd.negative?

    IO.open(fd, 'w') do |writer|
      raise ArgumentError, 'build terminal is no longer available' unless writer.tty?

      writer.write("\x03")
      writer.flush
    end
  ensure
    process&.close
  end
end

class SystemdBuildService
  def start(build, directory)
    output, status = Open3.capture2e(
      'systemd-run', '--quiet', '--collect', '--service-type=exec',
      "--unit=#{build.unit_name}", "--description=Build #{build.command_line}",
      "--property=User=#{Process.uid}", "--property=Group=#{Process.gid}",
      # Detached SSH control masters may also carry sessions for other builds.
      '--property=KillMode=process', '--property=TimeoutStopSec=10s',
      '--property=UMask=0077',
      '--', RbConfig.ruby, File.realpath(__FILE__), '--worker', directory
    )
    raise "could not start build worker: #{output.strip}" unless status.success? || active?(build)
  end

  def active?(build)
    output, status = Open3.capture2e('systemctl', 'show', '--property=LoadState,ActiveState', build.unit_name)
    properties = output.lines.filter_map do |line|
      key, value = line.strip.split('=', 2)
      [key, value] if value
    end.to_h
    return false if properties['LoadState'] == 'not-found'

    raise "could not query build worker: #{output.strip}" unless status.success?

    %w[active activating reloading deactivating].include?(properties['ActiveState'])
  end

  def stop(build)
    output, status = Open3.capture2e('systemctl', 'stop', build.unit_name)
    raise "could not stop build worker: #{output.strip}" unless status.success? || !active?(build)
  end

  def interrupt(build)
    output, status = Open3.capture2e('systemctl', 'show', '--property=MainPID', '--value', build.unit_name)
    raise "could not query build worker: #{output.strip}" unless status.success?

    BuildTerminal.interrupt(output.strip.to_i)
  end
end

class BuildWorker
  def initialize(directory)
    @directory = directory
    @request = JSON.parse(File.read(File.join(directory, 'request.json')))
    @build = Build.from_h(@request.fetch('build'))
    @prompt_tail = +''
    @stopping = false
  end

  def run
    File.open(File.join(@directory, 'lock'), 'w', 0o600) do |lock|
      raise 'build worker is already running' unless lock.flock(File::LOCK_EX | File::LOCK_NB)
      # A worker may be reattached to, but must never rerun a started build.
      return 0 if File.exist?(status_path)

      run_build
    end
    @build.status == 'succeeded' ? 0 : 1
  end

  private

  def status_path
    File.join(@directory, 'status.json')
  end

  def persist
    write_json(status_path, @build.to_h)
  end

  def append_log(chunk)
    File.open(@build.log_path, 'ab') { |file| file.write(chunk) }
  end

  def run_build
    handlers = %w[INT TERM].to_h { |signal| [signal, trap(signal) { @stopping = true }] }
    @build.status = 'running'
    @build.started_at = Time.now.utc
    persist
    append_log("$ #{@build.argv.shelljoin}\n")
    append_log("target builder: #{@build.target_builder}\n") if @build.target_builder
    append_log("started: #{@build.started_at.iso8601}\n\n")

    env = @request.fetch('environment').merge('TERM' => 'xterm')
    env['SERVER'] = @build.target_builder if @build.target_builder
    options = {chdir: @request.fetch('workdir'), unsetenv_others: true}
    @reader, @writer, @pid = PTY.spawn(env, *@build.argv, options)
    @writer.sync = true
    eof = false
    until @wait_status || @stopping
      if IO.select(eof ? [] : [@reader], nil, nil, 0.25)
        eof = !read_output
      end
      answer_upload unless @stopping
      _, @wait_status = Process.wait2(@pid, Process::WNOHANG)
    end
    while !eof && IO.select([@reader], nil, nil, 0)
      eof = !read_output
    end
  rescue StandardError => e
    @build.note = e.message
    append_log("\n#{APP_NAME}: #{e.class}: #{e.message}\n")
  ensure
    reap_child
    @reader&.close unless @reader&.closed?
    @writer&.close unless @writer&.closed?
    @build.exit_status = @wait_status&.exitstatus || (@wait_status&.termsig && 128 + @wait_status.termsig)
    @build.finished_at = Time.now.utc
    @build.status = if @stopping
                      @build.note ||= 'build worker stopped'
                      'interrupted'
                    elsif @wait_status&.success? && !@build.note
                      'succeeded'
                    else
                      'failed'
                    end
    append_log("\nfinished: #{@build.finished_at.iso8601} exit=#{@build.exit_status || 'unknown'}\n")
    persist
    handlers&.each { |signal, handler| trap(signal, handler) }
  end

  def read_output
    chunk = @reader.read_nonblock(16_384, exception: false)
    return false unless chunk
    return true if chunk == :wait_readable

    append_log(chunk)
    observe_prompt(chunk)
    true
  rescue EOFError, Errno::EIO
    false
  end

  def observe_prompt(chunk)
    tail = @prompt_tail + chunk
    @prompt_tail = tail.bytesize > 512 ? tail.byteslice(-512, 512) : tail
    clean_tail = @prompt_tail.gsub(ANSI_PATTERN, '')
    changed = false
    unless @build.package_version
      changed = true if @build.read_package_version(clean_tail)
    end
    if !@build.build_host && (match = clean_tail.match(HOST_PATTERN))
      @build.build_host = match[1]
      changed = true
    end
    if !@build.upload_prompt_seen && clean_tail.match?(PROMPT_PATTERN)
      @build.upload_prompt_seen = true
      @build.upload_prompt_at = Time.now.utc
      @build.status = 'waiting_upload'
      changed = true
    end
    persist if changed
  end

  def answer_upload
    return unless @build.status == 'waiting_upload'

    path = File.join(@directory, 'upload.json')
    return unless File.exist?(path)

    decision = JSON.parse(File.read(path)).fetch('decision')
    raise 'invalid upload decision' unless %w[upload skip].include?(decision)

    @writer.write(decision == 'upload' ? "y\n" : "n\n")
    @writer.flush
    @build.upload_decision = decision
    @build.prompt_answered_at = Time.now.utc
    @build.discard_after_finish = decision == 'skip'
    @build.status = 'running'
    persist
  end

  def reap_child
    return unless @pid

    # Reap the build's process group even after its leader exits. SSH control
    # masters detach into separate sessions and must survive for other clients.
    signal_child_group('TERM')
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 3
    loop do
      _, @wait_status = Process.wait2(@pid, Process::WNOHANG) unless @wait_status
      break unless signal_child_group(0)
      break if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline

      sleep 0.05
    end
    signal_child_group('KILL')
    _, @wait_status = Process.wait2(@pid) unless @wait_status
  rescue Errno::ECHILD
    nil
  end

  def signal_child_group(signal)
    Process.kill(signal, -@pid)
  rescue Errno::ESRCH
    nil
  end
end

class CodexSession < Struct.new(:id, :build_id, :pkgbase, :unit_name, :status, :rebuild,
                               :build, :rebuild_id, :created_at, :finished_at, :exit_status,
                               :note, keyword_init: true)
  attr_accessor :activity

