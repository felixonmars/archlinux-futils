      <button id="end-link" class="button is-medium is-info end-link" type="button" title="Back to end">&darr; End</button>

      <script src="../../log-viewer.js?v=3"></script>
      <script>
        const statusEl = document.querySelector('#status');
        const hostEl = document.querySelector('#build-host');
        const decisionEl = document.querySelector('#decision');
        const stopControls = document.querySelector('[data-stop-controls]');
        const killButton = document.querySelector('[data-kill-button]');
        const durationEl = document.querySelector('#duration');
        const logEl = document.querySelector('#log');
        const endLink = document.querySelector('#end-link');
        let offset = #{page[:offset]};

        function statusClass(status) {
          if (status === 'running') return 'is-info';
          if (status === 'waiting_upload') return 'is-warning';
          if (status === 'failed' || status === 'interrupted') return 'is-danger';
          if (status === 'succeeded') return 'is-success';
          return 'is-light';
        }

        function appendLog(text) {
          if (!text) return;
          const wasNearBottom = nearBottom();
          terminal.write(text);
          if (wasNearBottom) window.scrollTo(0, document.body.scrollHeight);
          updateEndLink();
        }

        function nearBottom() {
          return window.innerHeight + window.scrollY >= document.body.offsetHeight - 120;
        }

        function updateEndLink() {
          endLink.style.display = nearBottom() ? 'none' : '';
        }

        const initialLog = #{JSON.generate(page[:text]).gsub('<') { '\\u003c' }};
        const terminal = new PagedLog(logEl, document.querySelector('#log-history'), initialLog, #{page[:before]});
        let lastScrollY = window.scrollY;
        let ready = false;
        requestAnimationFrame(() => {
          window.scrollTo(0, document.body.scrollHeight);
          lastScrollY = window.scrollY;
          ready = true;
          updateEndLink();
          terminal.loadOlder(window.innerHeight).then(updateEndLink);
        });
        window.addEventListener('scroll', () => {
          if (ready && window.scrollY < lastScrollY && logEl.getBoundingClientRect().top > -300) {
            terminal.loadOlder();
          }
          lastScrollY = window.scrollY;
          updateEndLink();
        }, { passive: true });
        endLink.addEventListener('click', () => {
          window.scrollTo(0, document.body.scrollHeight);
          updateEndLink();
        });

        const events = new EventSource(`events?offset=${offset}`);
        events.addEventListener('log', (event) => appendLog(JSON.parse(event.data)));
        events.addEventListener('status', (event) => {
          const data = JSON.parse(event.data);
          if (data.package_version) document.querySelector('#package-version').textContent = data.package_version;
          statusEl.textContent = data.status.replace(/_/g, ' ');
          statusEl.className = `tag ${statusClass(data.status)}`;
          if (hostEl && data.build_host) {
            hostEl.textContent = data.build_host;
            hostEl.title = (data.build_tags || []).join(', ');
            hostEl.style.display = '';
          }
          durationEl.textContent = data.duration;
          if (data.started_at) {
            document.querySelectorAll('[data-builder-expires-at]').forEach((label) => {
              label.dataset.builderExpiresAt = Date.parse(data.started_at) + 300000;
            });
          }
          if (decisionEl) decisionEl.style.display = data.status === 'waiting_upload' ? '' : 'none';
          if (stopControls) stopControls.style.display = data.done ? 'none' : '';
          if (killButton) killButton.style.display = data.stop_requested ? '' : 'none';
          if (data.done) events.close();
        });
      </script>
    HTML
  end

  def log_chunk(req, res, id)
    return not_found(res) unless %w[GET HEAD].include?(req.request_method)

    build = @manager.find(id)
    return not_found(res) unless build

    before = Integer(req.query.fetch('before', ''), 10)
    res['Content-Type'] = 'application/json; charset=utf-8'
    res['Cache-Control'] = 'no-store'
    res.body = JSON.generate(read_log_page(build.log_path, before))
  end

  def raw_log(res, id)
    build = @manager.find(id)
    return not_found(res) unless build

    res.status = 200
    res['Content-Type'] = 'text/plain; charset=utf-8'
    res.body = File.exist?(build.log_path) ? File.open(build.log_path, 'rb') : ''
  end

  def stream_events(req, res, id)
    build = @manager.find(id)
    return not_found(res) unless build

    res.status = 200
    res['Content-Type'] = 'text/event-stream; charset=utf-8'
    res['Cache-Control'] = 'no-cache'
    res['X-Accel-Buffering'] = 'no'
    res.chunked = true
    res.body = proc do |out|
      offset = (req['last-event-id'] || req.query['offset']).to_i
      last_status = nil
      loop do
        break if @manager.shutting_down?

        current = @manager.find(id)
        break unless current

        # Read after the status snapshot so a terminal status includes the final output.
        log, offset = read_log(build.log_path, offset)
        sse(out, 'log', JSON.generate(utf8(log)), id: offset) unless log.empty?

        payload = {
          status: current.status,
          exit_status: current.exit_status,
          build_host: current.build_host,
          package_version: current.package_version,
          build_tags: @builder_tags.for(current.build_host),
          duration: duration(current),
          started_at: current.started_at&.iso8601,
          stop_requested: current.stop_requested,
          done: current.terminal?
        }
        encoded = JSON.generate(payload)
        if encoded != last_status
          sse(out, 'status', encoded)
          last_status = encoded
        end
        break if current.terminal? && log.empty?

        sleep 1
      end
    rescue IOError, Errno::EPIPE, Errno::ECONNRESET
      nil
    end
  end

