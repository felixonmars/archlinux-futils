  end

  def start_build_form
    builder_hint = BUILDER_USER.empty? ? 'host or user@host' : "host (defaults to #{BUILDER_USER}@host) or user@host"
    <<~HTML
      <section class="box start-panel">
        <form action="/builds" method="post">
          <label class="label panel-label" for="command">Start a build</label>
          <div class="field has-addons build-inputs">
            <div class="control is-expanded">
              <input class="input" id="command" name="command" type="text" autofocus placeholder="pkgbase[:nocheck]" autocomplete="off" pattern="[A-Za-z0-9][A-Za-z0-9@._+\-]*(:nocheck)?">
            </div>
            <div class="control target-builder">
              <input class="input" id="target-builder" name="target_builder" type="text" aria-label="Target builder (optional)" placeholder="Builder (optional)" title="#{h(builder_hint)}" autocomplete="off" spellcheck="false">
            </div>
            <div class="control">
              <button class="button is-primary" type="submit">Start build</button>
            </div>
          </div>
          <p class="help">Use <span class="is-family-monospace">:nocheck</span> to skip checks. Leave builder blank for automatic selection.</p>
        </form>
      </section>
    HTML
  end

  def build_card(build)
    host = build.build_host
    unless host
      log, = read_log(build.log_path, 0, 65_536)
      match = log.gsub(ANSI_PATTERN, '').match(HOST_PATTERN)
      host = match[1] if match
    end

    <<~HTML
      <article class="build-card #{h(build.status)}">
        #{delete_button(build)}
        <div class="build-title">
          <h3><a href="#{h(dashboard_path("builds/#{build.id}/log"))}">#{h(build.pkgbase || build.command_line.sub(/:nocheck\z/, ''))}</a></h3>
          #{nocheck_tag(build.command_line)}
        </div>
        <div class="build-details">
          <div class="build-meta">
            #{status_tag(build.status)}
            #{%(<span class="tag is-light"#{builder_title(host)}>#{h(host)}</span>) if host}
            <span class="build-duration">#{h(duration(build))}#{%( <span class="exit-status">exit #{h(build.exit_status)}</span>) if build.exit_status && build.exit_status != 0}</span>
          </div>
          <div class="build-actions">
            <a class="log-link" href="#{h(dashboard_path("builds/#{build.id}/log"))}">Log</a>
            <a class="raw-link" href="#{h(dashboard_path("builds/#{build.id}/raw"))}">Raw</a>
            #{stop_button(build)}
            #{retry_button(build) unless build.status == 'waiting_upload'}
          </div>
        </div>
        #{%(<p class="help is-danger mb-1">#{h(build.note)}</p>) if build.note}
        #{decision_panel(build)}
      </article>
    HTML
  end

  def delete_button(build)
    return '' if @read_only || build.active?

    <<~HTML
      <form class="delete-build" action="/builds/#{h(build.id)}/delete" method="post">
        <button class="delete is-small" type="submit" title="Delete build and log" aria-label="delete" onclick="return confirm('Delete this build and its log?')"></button>
      </form>
    HTML
  end

  def nocheck_tag(command_line)
    return '' unless command_line.to_s.end_with?(':nocheck')

    '<span class="tag is-light">nocheck</span>'
  end

  def refresh_panel(pending)
    pending_tags = pending.map do |pkgbase|
      <<~HTML
        <label class="tag is-light pending-tag">
          #{%(<input type="checkbox" name="pkgbase" value="#{h(pkgbase)}" checked>) unless @read_only}
          <span>#{h(pkgbase)}</span>
        </label>
      HTML
    end.join

    pending_form = if pending.empty?
                     %(<p class="has-text-grey is-size-7 mb-0">No pending packages.</p>)
                   elsif @read_only
                     %(<div class="tags mb-2">#{pending_tags}</div>)
                   else
                     <<~HTML
                       <form action="/refresh/add" method="post">
                         <div class="tags mb-2">#{pending_tags}</div>
                         <div class="buttons are-small mb-0">
                           <button class="button is-small is-primary" type="submit">Add selected</button>
                           <button class="button is-small is-light" type="submit" formaction="/refresh/clear" onclick="return confirm('Dismiss selected pending packages?')">Dismiss selected</button>
                         </div>
                       </form>
                     HTML
                   end

    refresh_form = <<~HTML unless @read_only
      <form class="field has-addons mb-0" action="/refresh" method="post">
        <div class="control extra-safe-deps">
          <input class="input is-small" id="extra-safe-deps" name="extra_safe_deps" type="text" aria-label="Add persisted safe dependencies (optional)" placeholder="Add safe deps (optional)" title="Comma-separated dependencies to keep safe until they leave the status page after updating" autocomplete="off" spellcheck="false">
        </div>
        <div class="control">
          <button class="button is-small is-light" type="submit">Refresh</button>
        </div>
      </form>
    HTML

    <<~HTML
      <section class="box refresh-panel">
        <div class="section-heading refresh-head">
          <div>
            <h2>Pending refresh <span class="section-count">#{pending.size}</span></h2>
          </div>
          #{refresh_form}
        </div>
        #{pending_form}
      </section>
    HTML
  end

  def retry_button(build, waiting_upload: build.status == 'waiting_upload')
    return '' if @read_only
    return '' unless waiting_upload || %w[failed interrupted].include?(build.status)

    label = waiting_upload ? 'Skip upload + retry' : 'Retry'
    button_class = waiting_upload ? 'button is-small is-warning' : 'button is-small is-primary'

    <<~HTML
      <form class="inline" action="/builds/#{h(build.id)}/retry" method="post">
        <button class="#{button_class}" type="submit">#{label}</button>
        #{new_builder_checkbox(build)}
      </form>
    HTML
  end

  def deferred_panel(entries)
    return '' if entries.empty?

    cards = entries.map do |entry|
      build = entry['build']
      cancel_form = <<~HTML unless @read_only
        <form class="inline" action="/deferred/#{h(build['id'])}/cancel" method="post">
          <button class="button is-small is-light" type="submit">Cancel</button>
        </form>
      HTML
      <<~HTML
        <div class="build-head deferred-row">
          <p class="is-size-7 mb-0">
            <strong class="is-family-monospace">#{h(build['pkgbase'] || build['command_line'].sub(/:nocheck\z/, ''))}</strong>
            #{nocheck_tag(build['command_line'])}
            #{entry['ready'] ? 'Ready to retry after the current attempt exits.' : "Waiting for <strong>#{h(entry['wait_for'])}</strong> to build successfully."}
          </p>
          #{cancel_form}
        </div>
      HTML
    end.join

    <<~HTML
      <section class="build-section deferred-section">
        <div class="section-heading"><h2>Deferred builds <span class="section-count">#{entries.size}</span></h2></div>
        <div class="build-list">#{cards}</div>
      </section>
    HTML
  end

  def new_builder_checkbox(build)
    return '' if @read_only
    return '' if build.started_at && Time.now - build.started_at >= 300

    expires_at = ((build.started_at.to_f + 300) * 1000).to_i if build.started_at
    <<~HTML
      <label class="checkbox is-size-7" data-builder-expires-at="#{expires_at}" title="Clear this package's cached builder and use automatic selection for the retry">
        <input type="checkbox" name="new_builder" value="1"> New builder
      </label>
    HTML
  end

  def stop_button(build)
    return '' if @read_only || !build.active?

    <<~HTML
      <form class="inline" action="/builds/#{h(build.id)}/stop" method="post" data-stop-controls>
        <button class="button is-small is-danger" type="submit" title="Send Ctrl-C to the build terminal">Stop</button>
        <button class="button is-small is-danger" type="submit" formaction="/builds/#{h(build.id)}/kill" data-kill-button#{' style="display:none"' unless build.stop_requested} title="Force the build worker to shut down and terminate its build processes">Kill</button>
      </form>
    HTML
  end

  def decision_panel(build, live: false)
    return '' unless live || build.status == 'waiting_upload'

    id_attr = live ? ' id="decision"' : ''
    style = build.status == 'waiting_upload' ? '' : ' style="display:none"'

    if @read_only
      return %(<div#{id_attr} class="decision-notice"#{style}>Waiting for an upload decision.</div>)
    end

    <<~HTML
      <div#{id_attr} class="decision-panel"#{style}>
        <p class="decision-label">Upload log?</p>
        <div class="decision-actions">
          <form class="inline" action="/builds/#{h(build.id)}/upload" method="post">
            <button class="button is-small is-warning" name="decision" value="yes" type="submit">Upload</button>
            <button class="button is-small is-light" name="decision" value="no" type="submit">Skip</button>
          </form>
          #{retry_button(build, waiting_upload: true)}
          <form class="inline" action="/builds/#{h(build.id)}/memory-killer" method="post">
            <button class="button is-small is-light" type="submit" title="Add this package to the memory killer list for future automatic builder selection">Require 32G+ RAM</button>
          </form>
          <form class="inline defer-form" action="/builds/#{h(build.id)}/defer" method="post">
            <input class="input is-small defer-package" name="wait_for" type="text" required aria-label="Package to wait for" placeholder="Wait for package" title="Retry after this package base next builds successfully" autocomplete="off" spellcheck="false">
            <button class="button is-small is-warning" type="submit" title="Skip this log upload and retry after the named package builds successfully">Defer</button>
          </form>
        </div>
      </div>
    HTML
  end

  def empty_state(message)
    %(<p class="empty-state">#{h(message)}</p>)
  end

  def flash(type, message)
    bulma_type = type == 'error' ? 'is-danger' : 'is-success'
    %(<div class="notification #{bulma_type} py-2 px-3 mb-3">#{h(message)}</div>)
  end

  def sse(out, event, data, id: nil)
    out.write("id: #{id}\n") if id
    out.write("event: #{event}\n")
    text = data.to_s
    if text.empty?
      out.write("data:\n")
    else
      text.each_line(chomp: true) { |line| out.write("data: #{line}\n") }
    end
    out.write("\n")
  end

  def html(res, body, status: 200)
    res.status = status
    res['Content-Type'] = 'text/html; charset=utf-8'
    res.body = body
  end

  def redirect(res, location)
    res.status = 303
    res['Location'] = location
    res.body = ''
  end

  def not_found(res)
    html(res, layout('not found', '<section class="notification is-warning">Not found</section>'), status: 404)
  end

