          .build-title, .build-toolbar, .build-meta, .build-actions, form.inline { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; min-width: 0; }
          .build-card .build-title { margin-bottom: .55rem; padding-right: 1rem; gap: .4rem; }
